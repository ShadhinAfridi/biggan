  faqs: ToolFaqItem[];
}

const {
  title,
  metaDescription,
  toolName,
  toolCategory,
  curriculumTags,
  topicId,
  exemplars,
  faqs,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const pathname = Astro.url.pathname;
const currentToolId = pathname.replace(/\/$/, '').split('/').pop() || '';
