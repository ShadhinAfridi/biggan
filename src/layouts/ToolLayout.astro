const relatedList = RELATED_MAP[currentToolId] || RELATED_MAP['physics'];

// Supported Casio Guide topics
const CASIO_TOPICS = [
  'quadratic',
  'sigfigs',
  'kinematics',
  'molar-mass',
  'redox',
  'physics-general',
  'chemistry-general',
  'statistics',
  'biology-general',
  'higher-math',
];

// Build structured JSON-LD schemas
const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: toolName,
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'All',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  description: metaDescription,
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t('nav.home'),
      item: `https://biggan.me/${lang}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t('nav.tools'),
      item: `https://biggan.me/${lang}/tools/`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: toolName,
      item: canonicalPageUrl,
    },
  ],
};
---

<BaseLayout
  title={title}
  description={metaDescription}
  lang={lang}
  jsonLd={[webAppSchema, faqSchema, breadcrumbSchema]}
>
  <div class="space-y-10">
    <!-- Semantic Breadcrumb -->
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-slate-400">
        <li class="flex items-center gap-2">
          <a href={`/${lang}`} class="hover:text-cyan-400 transition">{t('nav.home')}</a>
          <span>/</span>
        </li>
        <li class="flex items-center gap-2">
          <a href={`/${lang}/tools`} class="hover:text-cyan-400 transition">{t('nav.tools')}</a>
          <span>/</span>
        </li>
        <li class="text-slate-200 font-medium truncate max-w-xs sm:max-w-md">
          {toolName}
        </li>
      </ol>
    </nav>

    <!-- Header & Curriculum Badges -->
    <div class="space-y-3">
      <div class="flex flex-wrap items-center gap-2">
        <span class="px-2.5 py-1 rounded-md text-xs font-semibold bg-cyan-500/10 text-cyan-400 border border-cyan-500/30">
          {toolCategory}
        </span>
        {curriculumTags.map((tag) => (
          <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-slate-800 text-slate-300 border border-slate-700">
            {tag}
          </span>
        ))}
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight">
        {toolName}
      </h1>
      <p class="text-sm sm:text-base text-slate-300 max-w-3xl leading-relaxed">
        {metaDescription}
      </p>
    </div>

    <!-- Quick Section Anchor Pills -->
    <div class="overflow-x-auto py-1 scrollbar-none">
      <div class="inline-flex items-center gap-2 min-w-full text-xs font-medium text-slate-300">
        <span class="text-[11px] font-mono text-slate-500 uppercase tracking-wider pl-1 hidden sm:inline">
          {lang === 'bn' ? 'দ্রুত যান:' : 'Jump to:'}
        </span>
        <a href="#interactive-calculator" class="px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 hover:text-cyan-400 border border-slate-800 whitespace-nowrap transition">
          {lang === 'bn' ? 'ক্যালকুলেটর' : 'Calculator'}
        </a>
        <a href="#mathematical-foundations" class="px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 hover:text-cyan-400 border border-slate-800 whitespace-nowrap transition">
          {lang === 'bn' ? 'সূত্র ও নিয়ম' : 'Formulas'}
        </a>
        <a href="#solved-exemplars" class="px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 hover:text-cyan-400 border border-slate-800 whitespace-nowrap transition">
          {lang === 'bn' ? 'বোর্ড উদাহরণ' : 'Exemplars'}
        </a>
        <a href="#hardware-or-shortcuts" class="px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 hover:text-cyan-400 border border-slate-800 whitespace-nowrap transition">
          {lang === 'bn' ? 'কাসিও fx-991 গাইড' : 'Casio fx-991'}
        </a>
        <a href="#industrial-applications" class="px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 hover:text-cyan-400 border border-slate-800 whitespace-nowrap transition">
          {lang === 'bn' ? 'ব্যবহারিক প্রয়োগ' : 'Applications'}
        </a>
        <a href="#faq" class="px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 hover:text-cyan-400 border border-slate-800 whitespace-nowrap transition">
          {lang === 'bn' ? 'প্রশ্নোত্তর' : 'FAQ'}
        </a>
      </div>
    </div>

    <!-- PART 1: Interactive Workspace Island Slot (Above-the-Fold) -->
    <section id="interactive-calculator" class="scroll-mt-20">
      <slot name="calculator" />
    </section>

    <!-- Zero-CLS AdSlot Banner 1 -->
    <AdSlot slotType="banner" slotId="top-tool-banner" />

    <!-- PART 2: Contextual Derivation & Mathematical Foundations -->
    <section id="mathematical-foundations" class="bg-slate-900/70 border border-slate-800 rounded-3xl p-6 sm:p-8 space-y-6 scroll-mt-20 shadow-lg">
      <div class="border-b border-slate-800 pb-4">
        <h2 class="text-lg sm:text-xl font-bold text-white flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-cyan-400"></span>
          {t('section.derivation')}
        </h2>
        <p class="text-xs text-slate-400 mt-1">
          {lang === 'bn'
            ? 'তাত্ত্বিক ভিত্তি, একক বিশ্লেষণ ও সমীকরণের ভৌত সীমাবদ্ধতা'
            : 'Theoretical foundation, dimensional analysis, and governing boundary conditions.'}
        </p>
      </div>

      <div class="prose prose-invert max-w-none text-sm text-slate-300 space-y-4 leading-relaxed">
        <slot name="derivation" />
      </div>
    </section>

    <!-- PART 3: Solved Pedagogical Exemplars (Secondary, Advanced, Board Exam) -->
    <section id="solved-exemplars" class="space-y-6 scroll-mt-20">
      <div>
        <h2 class="text-lg sm:text-xl font-bold text-white flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
          {t('section.examples')}
        </h2>
        <p class="text-xs text-slate-400 mt-1">
          {lang === 'bn'
            ? 'পাঠ্যবই, অলিম্পিয়াড ও বিগত বোর্ড পরীক্ষার হুবহু সমাধানকৃত ৩টি মানসম্পন্ন অংক'
            : 'Three fully worked pedagogical exemplars: standard textbook, advanced edge-case, and authentic past board examination.'}
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6">
        {exemplars.map((ex, idx) => (
          <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 space-y-4 hover:border-slate-700 transition shadow-md">
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-800 pb-3">
              <span class="text-xs font-bold uppercase tracking-wider text-emerald-400">
                {ex.level}
              </span>
              <span class="text-[11px] font-mono bg-slate-800 text-slate-300 px-2.5 py-0.5 rounded-full border border-slate-700">
                {ex.levelBadge}
              </span>
            </div>

            <div class="text-sm font-semibold text-white">
              {ex.problemText}
            </div>

            {ex.givenData.length > 0 && (
              <div class="bg-slate-950/70 p-3.5 rounded-xl border border-slate-800/80 text-xs text-slate-300 space-y-1">
                <span class="text-slate-400 block font-medium">
                  {lang === 'bn' ? 'দেওয়া আছে (Given Data):' : 'Given Parameters:'}
                </span>
                <ul class="list-disc list-inside space-y-0.5 text-slate-300 font-mono">
                  {ex.givenData.map((d) => (
                    <li>{d}</li>
                  ))}
                </ul>
              </div>
            )}

            <div class="space-y-2 text-xs text-slate-300">
              <span class="text-slate-400 block font-medium">
                {lang === 'bn' ? 'সমাধানের ধাপসমূহ:' : 'Procedural Solution:'}
              </span>
              <div class="space-y-1.5 font-mono text-slate-200">
                {ex.solutionSteps.map((step) => (
                  <div class="p-2.5 bg-slate-950/60 rounded-lg border border-slate-800/60 text-xs">
                    {step}
                  </div>
                ))}
              </div>
            </div>

            <div class="p-3.5 bg-emerald-500/10 border border-emerald-500/20 rounded-xl text-xs text-emerald-300 font-semibold flex items-center justify-between">
              <span>{lang === 'bn' ? 'উত্তর:' : 'Final Answer:'}</span>
              <span class="font-mono text-emerald-200">{ex.finalAnswer}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- PART 4: Casio Hardware Operational Bridge or Board Exam Checklist -->
    <section id="hardware-or-shortcuts" class="scroll-mt-20">
      {topicId && CASIO_TOPICS.includes(topicId) ? (
        <div id="casio-hardware-guide">
          <CasioGuide topic={topicId as any} lang={lang} />
        </div>
      ) : (
        <div class="bg-slate-900/70 border border-slate-800 rounded-3xl p-6 sm:p-8 space-y-5">
          <div class="flex items-center gap-2 border-b border-slate-800 pb-3">
            <span class="w-2.5 h-2.5 rounded-full bg-cyan-400"></span>
            <h2 class="text-lg sm:text-xl font-bold text-white">
              {lang === 'bn' ? 'বোর্ড পরীক্ষা ও ল্যাব চেকলিস্ট' : 'Board Exam & Laboratory Checklist'}
            </h2>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 font-mono text-xs text-slate-300">
            <div class="p-3.5 bg-slate-950 rounded-xl border border-slate-800 space-y-1">
              <span class="text-cyan-400 font-bold block">✓ একক রূপান্তর (SI Units)</span>
              <span class="text-slate-400">{lang === 'bn' ? 'গণনার পূর্বে সকল মানকে SI এককে নিয়ে নিন।' : 'Convert all inputs to SI units prior to calculation.'}</span>
            </div>
            <div class="p-3.5 bg-slate-950 rounded-xl border border-slate-800 space-y-1">
              <span class="text-cyan-400 font-bold block">✓ সূত্র ও পক্ষান্তর উল্লেখ</span>
              <span class="text-slate-400">{lang === 'bn' ? 'খাতায় মূল সূত্র লিখে লক্ষ্য চলককে আলাদা করুন।' : 'Explicitly isolate target variable before substitution.'}</span>
            </div>
            <div class="p-3.5 bg-slate-950 rounded-xl border border-slate-800 space-y-1">
              <span class="text-cyan-400 font-bold block">✓ তাৎপর্যপূর্ণ অঙ্ক ও রাউন্ডিং</span>
              <span class="text-slate-400">{lang === 'bn' ? 'চূড়ান্ত ফলাফলে ২ বা ৩ দশমিক স্থান পর্যন্ত রাউন্ড করুন।' : 'Preserve required precision without premature truncation.'}</span>
            </div>
          </div>
        </div>
      )}
    </section>

    <!-- Zero-CLS In-Content Ad -->
    <AdSlot slotType="in-content" slotId="mid-tool-incontent" />

    <!-- PART 5: Real-World Applications & Industrial Context -->
    <section id="industrial-applications" class="bg-slate-900/70 border border-slate-800 rounded-3xl p-6 sm:p-8 space-y-4 scroll-mt-20 shadow-lg">
      <div>
        <h2 class="text-lg sm:text-xl font-bold text-white flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
          {t('section.applications')}
        </h2>
        <p class="text-xs text-slate-400 mt-1">
          {lang === 'bn'
            ? 'শিল্প-কারখানা, ওষুধ প্রস্তুতি, প্রকৌশল ও আধুনিক গবেষণায় প্রয়োগ'
            : 'How this scientific principle drives chemical engineering, aerospace, medicine, and research.'}
        </p>
      </div>
      <div class="prose prose-invert max-w-none text-sm text-slate-300 leading-relaxed space-y-3">
        <slot name="applications" />
      </div>
    </section>

    <!-- PART 6: Technical FAQ & Schema Markup -->
    <section id="faq" class="space-y-4 scroll-mt-20">
      <div>
        <h2 class="text-lg sm:text-xl font-bold text-white flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-violet-400"></span>
          {t('section.faq')}
        </h2>
        <p class="text-xs text-slate-400 mt-1">
          {lang === 'bn'
            ? 'শিক্ষার্থীদের সচরাচর ভুল ও গুরুত্বপূর্ণ প্রশ্নের একাডেমিক উত্তর'
            : 'Answers to common conceptual misconceptions and board examination guidelines.'}
        </p>
      </div>

      <div class="space-y-3">
        {faqs.map((faq, idx) => (
          <details class="group bg-slate-900/80 border border-slate-800 rounded-2xl p-4 transition open:border-cyan-500/40">
            <summary class="flex items-center justify-between cursor-pointer font-semibold text-sm text-slate-200 hover:text-white select-none">
              <span>{faq.question}</span>
              <span class="text-slate-400 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <div class="mt-3 pt-3 border-t border-slate-800/80 text-xs sm:text-sm text-slate-400 leading-relaxed">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- PART 7: Related Calculators & Curriculum Topics (Topic Cluster) -->
    <section id="related-tools" class="space-y-4 scroll-mt-20 border-t border-slate-800/80 pt-8">
      <div>
        <h2 class="text-lg sm:text-xl font-bold text-white flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-cyan-400"></span>
          {lang === 'bn' ? 'সম্পর্কিত অন্যান্য ক্যালকুলেটর ও সিমুলেটর' : 'Related Scientific Tools & Simulators'}
        </h2>
        <p class="text-xs text-slate-400 mt-1">
          {lang === 'bn'
            ? 'বোর্ড পরীক্ষা ও ভর্তি পরীক্ষার প্রস্তুতিতে প্রাসঙ্গিক সহায়ক টুলস'
            : 'Complementary computational solvers for interconnected syllabus chapters.'}
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {relatedList.map((rel) => (
          <a
            href={getLocalizedPath(`/tools/${rel.id}`, lang)}
            class="group p-4 rounded-2xl bg-slate-900/80 border border-slate-800 hover:border-cyan-500/40 hover:bg-slate-900 transition flex flex-col justify-between space-y-3"
          >
            <div class="flex items-center gap-2.5">
              <span class="text-2xl p-2 rounded-xl bg-slate-950 border border-slate-800 group-hover:scale-110 transition">
                {rel.icon}
              </span>
              <div class="min-w-0">
                <h3 class="text-xs font-bold text-white group-hover:text-cyan-400 transition truncate">
                  {lang === 'bn' ? rel.nameBn : rel.nameEn}
                </h3>
                <p class="text-[11px] text-slate-400 truncate">
                  {lang === 'bn' ? rel.descBn : rel.descEn}
                </p>
              </div>
            </div>
            <span class="text-[11px] font-semibold text-cyan-400 inline-flex items-center gap-1">
              {lang === 'bn' ? 'ব্যবহার করুন →' : 'Open Tool →'}
            </span>
          </a>
        ))}
      </div>

      <!-- Syllabus & Formula Cross-Links -->
      <div class="p-4 rounded-2xl bg-slate-900/40 border border-slate-800/80 flex flex-wrap items-center justify-between gap-3 text-xs">
        <span class="text-slate-400">
          {lang === 'bn' ? 'সংশ্লিষ্ট পাঠ্যক্রম ও সূত্রাবলী:' : 'Relevant Syllabus & Formula Resources:'}
        </span>
        <div class="flex items-center gap-3 font-mono text-cyan-400">
          <a href={getLocalizedPath('/curriculum', lang)} class="hover:underline">
            {lang === 'bn' ? '🎓 বোর্ড কারিকুলাম' : '🎓 Board Curriculum'}
          </a>
          <span>•</span>
          <a href={getLocalizedPath('/formulas', lang)} class="hover:underline">
            {lang === 'bn' ? '📑 সূত্রমালা তালিকা' : '📑 Formula Sheets'}
          </a>
          <span>•</span>
          <a href={getLocalizedPath('/articles', lang)} class="hover:underline">
            {lang === 'bn' ? '📚 শিক্ষামূলক গাইড' : '📚 Study Guides'}
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

