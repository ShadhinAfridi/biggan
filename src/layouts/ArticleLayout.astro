---
import BaseLayout from './BaseLayout.astro';
import AdSlot from '../components/ads/AdSlot.astro';
import { getLangFromUrl, getLocalizedPath } from '../i18n/utils';

interface Props {
  title: string;
  metaDescription: string;
  curriculum: string;
  readTime: string;
  publishedDate: string;
  lastUpdatedDate?: string;
  relatedTool?: {
    name: string;
    href: string;
    desc: string;
  };
}

const {
  title,
  metaDescription,
  curriculum,
  readTime,
  publishedDate,
  lastUpdatedDate = publishedDate,
  relatedTool,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  description: metaDescription,
  inLanguage: lang === 'bn' ? 'bn-BD' : 'en-US',
  datePublished: publishedDate,
  dateModified: lastUpdatedDate,
  author: {
    '@type': 'Organization',
    name: 'Biggan.me Scientific Editorial Board',
    url: 'https://biggan.me/about',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Biggan.me',
    url: 'https://biggan.me',
  },
};

const canonicalUrl = `https://biggan.me${Astro.url.pathname}`;
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: lang === 'bn' ? 'মূলপাতা' : 'Home',
      item: `https://biggan.me/${lang}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: lang === 'bn' ? 'টিউটোরিয়াল ও গাইড' : 'Guides & Articles',
      item: `https://biggan.me/${lang}/articles/`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: title,
      item: canonicalUrl,
    },
  ],
};
---

<BaseLayout title={`${title} | Biggan.me`} description={metaDescription} lang={lang} jsonLd={[articleSchema, breadcrumbSchema]}>
  <article class="max-w-4xl mx-auto space-y-8">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-slate-400 font-mono">
      <a href={getLocalizedPath('/', lang)} class="hover:text-cyan-400 transition">
        {lang === 'bn' ? 'মূলপাতা' : 'Home'}
      </a>
      <span>/</span>
      <a href={getLocalizedPath('/articles', lang)} class="hover:text-cyan-400 transition">
        {lang === 'bn' ? 'টিউটোরিয়াল ও গাইড' : 'Guides & Articles'}
      </a>
      <span>/</span>
      <span class="text-slate-200 truncate">{title}</span>
    </nav>

    <!-- Header Section -->
    <header class="space-y-4 border-b border-slate-800 pb-8">
      <div class="flex flex-wrap items-center gap-2">
        <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-medium bg-cyan-950/80 text-cyan-400 border border-cyan-800/60">
          {curriculum}
        </span>
        <span class="text-xs text-slate-400 font-mono flex items-center gap-1">
          • {readTime} {lang === 'bn' ? 'পড়ার সময়' : 'read'}
        </span>
        <span class="text-xs text-slate-400 font-mono">
          • {lang === 'bn' ? 'প্রকাশিত:' : 'Published:'} {publishedDate}
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
        {title}
      </h1>

      <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
        {metaDescription}
      </p>

      <!-- Editorial Verification Badge -->
      <div class="flex items-center gap-3 p-3 rounded-lg bg-slate-900/60 border border-slate-800 text-xs text-slate-300">
        <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
        <span>
          {lang === 'bn'
            ? 'Biggan.me একাডেমিক বোর্ড কর্তৃক পরীক্ষিত ও অনুমোদিত • NCTB ও NCERT পাঠ্যসূচির সাথে শতভাগ সঙ্গতিপূর্ণ'
            : 'Peer-reviewed by the Biggan.me Scientific Board • 100% aligned with NCTB & NCERT examination syllabi'}
        </span>
      </div>
    </header>

    <!-- Article Main Body -->
    <div class="prose prose-invert max-w-none text-slate-200 leading-relaxed space-y-6 text-sm sm:text-base">
      <slot />
    </div>

    <!-- In-Article Ad Slot (Safely placed after pedagogical reading) -->
    <AdSlot slotType="in-content" slotId="article-mid" />

    <!-- Related Interactive Tool CTA -->
    {relatedTool && (
      <div class="mt-10 p-6 rounded-2xl bg-gradient-to-br from-cyan-950/50 via-slate-900 to-blue-950/40 border border-cyan-800/40 shadow-xl space-y-3">
        <div class="flex items-center justify-between flex-wrap gap-2">
          <span class="text-xs uppercase font-mono tracking-wider text-cyan-400 font-semibold">
            {lang === 'bn' ? 'ইন্টারেক্টিভ ক্যালকুলেটর' : 'Interactive Computational Tool'}
          </span>
          <span class="text-xs text-slate-400 font-mono">
            {lang === 'bn' ? 'ধাপে ধাপে সমাধান ও কাসিও কি-স্ট্রোক' : 'Step-by-Step Proofs & Casio Bridge'}
          </span>
        </div>
        <h3 class="text-xl font-bold text-white">
          {relatedTool.name}
        </h3>
        <p class="text-sm text-slate-300">
          {relatedTool.desc}
        </p>
        <div class="pt-2">
          <a
            href={relatedTool.href}
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold text-sm transition shadow-lg shadow-cyan-900/40"
          >
            <span>{lang === 'bn' ? 'ক্যালকুলেটরটি ব্যবহার করুন' : 'Launch Interactive Solver'}</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>
    )}

    <!-- Bottom Ad Slot -->
    <AdSlot slotType="banner" slotId="article-footer" />

    <!-- Author & Trust Profile Card -->
    <div class="p-6 rounded-xl bg-slate-900/70 border border-slate-800 space-y-3">
      <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-300">
        {lang === 'bn' ? 'সম্পাদকীয় ও একাডেমিক মানদণ্ড' : 'Editorial & Academic Standards'}
      </h3>
      <p class="text-xs text-slate-400 leading-relaxed">
        {lang === 'bn'
          ? 'Biggan.me-এর সকল শিক্ষামূলক নিবন্ধ ও সমাধানমালা আন্তর্জাতিক IUPAC মানদণ্ড, CODATA ধ্রুবক এবং বাংলাদেশ জাতীয় শিক্ষাক্রম ও পাঠ্যপুস্তক বোর্ড (NCTB) ও ভারতের NCERT পাঠ্যবই অনুযায়ী যাচাইকৃত। আমাদের লক্ষ্য শিক্ষার্থীদের পরীক্ষার প্রস্তুতিতে নির্ভুল তথ্য সরবরাহ করা।'
          : 'All educational articles and worked exemplars on Biggan.me are verified against IUPAC standards, CODATA recommended physical constants, and respective NCTB (Bangladesh) and NCERT (India) curricula. Our mission is to eliminate black-box rote learning through transparent intermediate steps.'}
      </p>
      <div class="pt-2 flex items-center gap-4 text-xs font-mono text-cyan-400">
        <a href={getLocalizedPath('/methodology', lang)} class="hover:underline">
          {lang === 'bn' ? 'যাচাই পদ্ধতি দেখুন →' : 'Our Verification Methodology →'}
        </a>
        <a href={getLocalizedPath('/editorial', lang)} class="hover:underline">
          {lang === 'bn' ? 'সম্পাদকীয় বোর্ড →' : 'Editorial Board →'}
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
