---
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: getLocalizedPath('/curriculum', lang), label: t('nav.curriculum'), key: 'curriculum' },
  { href: getLocalizedPath('/formulas', lang), label: t('nav.formulas'), key: 'formulas' },
  { href: getLocalizedPath('/periodic-table', lang), label: t('nav.periodicTable'), key: 'periodic-table' },
  { href: getLocalizedPath('/glossary', lang), label: t('nav.glossary'), key: 'glossary' },
];

const sscTools = [
  { href: getLocalizedPath('/tools/physics', lang), name: lang === 'bn' ? 'পদার্থবিজ্ঞান' : 'Physics', icon: '⚡', desc: lang === 'bn' ? '১৩টি অধ্যায়' : '13 Chapters' },
  { href: getLocalizedPath('/tools/chemistry', lang), name: lang === 'bn' ? 'রসায়ন' : 'Chemistry', icon: '⚗️', desc: lang === 'bn' ? 'মোল, pH, ব্যাপন' : 'Mole, pH, Gas' },
  { href: getLocalizedPath('/tools/biology', lang), name: lang === 'bn' ? 'জীববিজ্ঞান' : 'Biology', icon: '🧬', desc: lang === 'bn' ? 'BMI, ATP, জেনেটিক্স' : 'BMI, ATP, Genetics' },
  { href: getLocalizedPath('/tools/general-math', lang), name: lang === 'bn' ? 'সাধারণ গণিত' : 'General Math', icon: '➕', desc: lang === 'bn' ? 'পরিসংখ্যান, ত্রিকোণ' : 'Stats, Trig' },
  { href: getLocalizedPath('/tools/higher-math', lang), name: lang === 'bn' ? 'উচ্চতর গণিত' : 'Higher Math', icon: '📐', desc: lang === 'bn' ? '১৪টি অধ্যায়' : '14 Chapters' },
];

const ictTools = [
  { href: getLocalizedPath('/tools/html-runner', lang), name: lang === 'bn' ? 'HTML5 এডিটর' : 'HTML5 Runner', icon: '🌐' },
  { href: getLocalizedPath('/tools/circuit-simulator', lang), name: lang === 'bn' ? 'লজিক গেট সার্কিট' : 'Logic Circuits', icon: '🔌' },
  { href: getLocalizedPath('/tools/c-runner', lang), name: lang === 'bn' ? 'সি প্রোগ্রামিং' : 'C Memory Tracer', icon: '💻' },
  { href: getLocalizedPath('/tools/database-simulator', lang), name: lang === 'bn' ? 'SQL ও ডেটাবেজ' : 'SQL Database', icon: '🗄️' },
];

const hscScienceTools = [
  { href: getLocalizedPath('/tools/vector-calculator', lang), name: lang === 'bn' ? 'ভেক্টর গুণন' : '3D Vectors', icon: '↗️', desc: lang === 'bn' ? 'ডট ও ক্রস গুণন' : 'Dot & Cross' },
  { href: getLocalizedPath('/tools/gas-law-calculator', lang), name: lang === 'bn' ? 'আদর্শ গ্যাস' : 'Gas Laws', icon: '💨', desc: lang === 'bn' ? 'PV = nRT' : 'PV = nRT' },
  { href: getLocalizedPath('/tools/solution-dilution', lang), name: lang === 'bn' ? 'দ্রবণ লঘুকরণ' : 'Dilution', icon: '🧪', desc: lang === 'bn' ? 'W=SMV/1000' : 'Molarity/PPM' },
  { href: getLocalizedPath('/tools/molar-mass', lang), name: lang === 'bn' ? 'মোলার ভর' : 'Molar Mass', icon: '⚖️', desc: lang === 'bn' ? 'আণবিক ভর' : 'Formula Mass' },
  { href: getLocalizedPath('/tools/redox-balancer', lang), name: lang === 'bn' ? 'রেডক্স সমতা' : 'Redox', icon: '⚡', desc: lang === 'bn' ? 'আয়ন-ইলেকট্রন' : 'Ion-Electron' },
  { href: getLocalizedPath('/tools/projectile-motion', lang), name: lang === 'bn' ? 'প্রাস গতিবিদ্যা' : 'Projectile', icon: '🎯', desc: lang === 'bn' ? 'দ্বিমাত্রিক গতি' : '2D Trajectory' },
];
---

<header class="sticky top-0 z-50 w-full border-b border-slate-800 bg-slate-950/95 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href={getLocalizedPath('/', lang)} class="flex items-center gap-2.5 group">
      <div class="w-8 h-8 rounded-lg bg-cyan-600 text-slate-950 flex items-center justify-center font-bold text-base transition">
        B
      </div>
      <div>
        <div class="flex items-baseline gap-1.5">
          <span class="text-lg font-bold tracking-tight text-white group-hover:text-cyan-400 transition">
            Biggan<span class="text-cyan-400">.me</span>
          </span>
        </div>
        <div class="text-[11px] text-slate-400 font-normal leading-none">
          {lang === 'bn' ? 'বিজ্ঞান ও গণিত ক্যালকুলেটর' : 'Science & Math Calculators'}
        </div>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-1 lg:gap-2">
      <!-- Tools Mega Dropdown -->
      <div class="relative group">
        <a
          href={getLocalizedPath('/tools', lang)}
          class={`px-3 py-1.5 rounded-lg text-sm font-medium transition flex items-center gap-1 ${
            currentPath.includes('/tools')
              ? 'text-cyan-400 bg-cyan-950/40 border border-cyan-800/50'
              : 'text-slate-300 hover:text-white hover:bg-slate-900'
          }`}
        >
          <span>{t('nav.tools')}</span>
          <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-cyan-400 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </a>

        <!-- Mega Menu Panel -->
        <div class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 w-[580px] z-50">
          <div class="bg-slate-900 border border-slate-800 rounded-xl shadow-xl p-4">
            <!-- Header -->
            <div class="flex items-center justify-between border-b border-slate-800 pb-2 mb-3">
              <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 font-mono">
                {lang === 'bn' ? 'সকল সায়েন্স ও আইসিটি টুলস' : 'All Science & ICT Tools'}
              </span>
              <a href={getLocalizedPath('/tools', lang)} class="text-[11px] text-cyan-400 hover:underline transition">
                {lang === 'bn' ? 'সবগুলো দেখুন (১৭টি টুল) →' : 'View All (17 Tools) →'}
              </a>
            </div>

            <div class="grid grid-cols-2 gap-4">
              <!-- Column 1: SSC Tools -->
              <div class="space-y-1">
                <div class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider px-2">
                  {lang === 'bn' ? 'এসএসসি বিজ্ঞান (৯ম-১০ম)' : 'SSC Science (Class 9-10)'}
                </div>
                <div class="space-y-0.5">
                  {sscTools.map((tool) => (
                    <a
                      href={tool.href}
                      class="p-1.5 rounded-lg hover:bg-slate-800 transition flex items-center gap-2 group/item"
                    >
                      <span class="text-base">{tool.icon}</span>
                      <div class="min-w-0">
                        <div class="text-xs font-semibold text-slate-200 group-hover/item:text-cyan-400 truncate">
                          {tool.name}
                        </div>
                        <div class="text-[10px] text-slate-400 truncate">
                          {tool.desc}
                        </div>
                      </div>
                    </a>
                  ))}
                </div>
              </div>

              <!-- Column 2: HSC Science & ICT -->
              <div class="space-y-3">
                <!-- HSC Science -->
                <div class="space-y-1">
                  <div class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider px-2">
                    {lang === 'bn' ? 'এইচএসসি বিজ্ঞান (১১শ-১২শ)' : 'HSC Science (Class 11-12)'}
                  </div>
                  <div class="grid grid-cols-2 gap-1">
                    {hscScienceTools.map((tool) => (
                      <a
                        href={tool.href}
                        class="p-1.5 rounded-lg hover:bg-slate-800 transition flex items-center gap-1.5 group/item"
                      >
                        <span class="text-sm">{tool.icon}</span>
                        <span class="text-[11px] font-medium text-slate-300 group-hover/item:text-cyan-400 truncate">
                          {tool.name}
                        </span>
                      </a>
                    ))}
                  </div>
                </div>

                <!-- HSC ICT -->
                <div class="border-t border-slate-800/80 pt-2 space-y-1">
                  <div class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider px-2">
                    {lang === 'bn' ? 'এইচএসসি আইসিটি (১১শ-১২শ)' : 'HSC ICT (Class 11-12)'}
                  </div>
                  <div class="grid grid-cols-2 gap-1">
                    {ictTools.map((tool) => (
                      <a
                        href={tool.href}
                        class="p-1.5 rounded-lg hover:bg-slate-800 transition flex items-center gap-1.5 group/item"
                      >
                        <span class="text-sm">{tool.icon}</span>
                        <span class="text-[11px] font-medium text-slate-300 group-hover/item:text-cyan-400 truncate">
                          {tool.name}
                        </span>
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Other Links -->
      {navLinks.map((link) => {
        const isActive = currentPath.includes(link.key);
        return (
          <a
            href={link.href}
            class={`px-3 py-1.5 rounded-lg text-sm font-medium transition ${
              isActive
                ? 'text-cyan-400 bg-cyan-950/40 border border-cyan-800/50'
                : 'text-slate-300 hover:text-white hover:bg-slate-900'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <!-- Right Action Items -->
    <div class="flex items-center gap-2 sm:gap-3">
      <a
        href={getLocalizedPath('/my-progress', lang)}
        class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-slate-900 hover:bg-slate-800 text-slate-300 hover:text-white border border-slate-800 transition"
        title={lang === 'bn' ? 'আমার অগ্রগতি দেখুন' : 'View My Progress'}
      >
        <span>📊</span>
        <span>{t('nav.progress')}</span>
      </a>

      <LanguageSwitcher />

      <ThemeToggle />

      <!-- Mobile Menu Button -->
      <button
        type="button"
        id="mobile-menu-btn"
        class="md:hidden p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 focus:outline-none"
        aria-label="Toggle Navigation Menu"
        aria-expanded="false"
      >
        <svg id="hamburger-icon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-800 bg-slate-950 px-4 pt-3 pb-6 space-y-3 transition-all duration-300">
    <div class="space-y-1">
      <a
        href={getLocalizedPath('/tools', lang)}
        class="block px-3 py-2 rounded-lg text-sm font-semibold text-cyan-400 bg-cyan-950/30 border border-cyan-800/40"
      >
        🚀 {t('nav.tools')} ({lang === 'bn' ? '১৭টি টুলস' : '17 Tools'})
      </a>

      <!-- SSC Tools on Mobile -->
      <div class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider px-3 pt-2">
        {lang === 'bn' ? 'এসএসসি বিজ্ঞান' : 'SSC Science'}
      </div>
      <div class="grid grid-cols-2 gap-1 px-2">
        {sscTools.map((tool) => (
          <a
            href={tool.href}
            class="px-2.5 py-1.5 rounded-lg text-xs font-medium text-slate-300 hover:bg-slate-900 flex items-center gap-1.5"
          >
            <span>{tool.icon}</span>
            <span class="truncate">{tool.name}</span>
          </a>
        ))}
      </div>

      <!-- HSC Science on Mobile -->
      <div class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider px-3 pt-2">
        {lang === 'bn' ? 'এইচএসসি বিজ্ঞান' : 'HSC Science'}
      </div>
      <div class="grid grid-cols-2 gap-1 px-2">
        {hscScienceTools.map((tool) => (
          <a
            href={tool.href}
            class="px-2.5 py-1.5 rounded-lg text-xs font-medium text-slate-300 hover:bg-slate-900 flex items-center gap-1.5"
          >
            <span>{tool.icon}</span>
            <span class="truncate">{tool.name}</span>
          </a>
        ))}
      </div>

      <!-- HSC ICT on Mobile -->
      <div class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider px-3 pt-2">
        {lang === 'bn' ? 'এইচএসসি আইসিটি' : 'HSC ICT'}
      </div>
      <div class="grid grid-cols-2 gap-1 px-2">
        {ictTools.map((tool) => (
          <a
            href={tool.href}
            class="px-2.5 py-1.5 rounded-lg text-xs font-medium text-slate-300 hover:bg-slate-900 flex items-center gap-1.5"
          >
            <span>{tool.icon}</span>
            <span class="truncate">{tool.name}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="border-t border-slate-900 pt-2 space-y-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="block px-3 py-2 rounded-lg text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-900"
        >
          {link.label}
        </a>
      ))}
      <a
        href={getLocalizedPath('/my-progress', lang)}
        class="block px-3 py-2 rounded-lg text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-900"
      >
        📊 {t('nav.progress')}
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      const isHidden = menu.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', (!isHidden).toString());
    });
  }
</script>
