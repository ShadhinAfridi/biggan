---
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-slate-800 bg-slate-950 text-slate-400 text-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Col 1: Brand & Mission -->
      <div class="space-y-3 md:col-span-1">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-lg bg-cyan-600 flex items-center justify-center text-slate-950 font-bold text-sm">
            B
          </div>
          <span class="text-base font-bold text-white tracking-tight">Biggan.me</span>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">
          {lang === 'bn'
            ? '৯ম-১০ম ও একাদশ-দ্বাদশ শ্রেণির বিজ্ঞান ও গণিত সমস্যার ধাপে ধাপে সমাধান, সূত্র এবং অনুমোদিত কাসিও fx-991 ক্যালকুলেটর কি-স্ট্রোক সহায়িকা।'
            : 'Step-by-step science and mathematics solvers aligned with NCTB and secondary board exam curriculum standards.'}
        </p>
        <div class="pt-1">
          <span class="text-[11px] font-mono text-slate-400 bg-slate-900 px-2 py-0.5 rounded border border-slate-800">
            NCTB • SSC • HSC
          </span>
        </div>
      </div>

      <!-- Col 2: SSC Tools -->
      <div class="space-y-2">
        <h4 class="text-xs font-semibold text-slate-200 uppercase tracking-wider">
          {lang === 'bn' ? 'এসএসসি ক্যালকুলেটর (৯ম-১০ম)' : 'SSC Solvers (Class 9-10)'}
        </h4>
        <ul class="space-y-1.5">
          <li>
            <a href={getLocalizedPath('/tools/physics', lang)} class="hover:text-cyan-400 transition flex items-center gap-1.5">
              <span>⚡</span> {t('tools.physics.name')}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/tools/chemistry', lang)} class="hover:text-cyan-400 transition flex items-center gap-1.5">
              <span>⚗️</span> {t('tools.chemistry.name')}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/tools/biology', lang)} class="hover:text-cyan-400 transition flex items-center gap-1.5">
              <span>🧬</span> {t('tools.biology.name')}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/tools/general-math', lang)} class="hover:text-cyan-400 transition flex items-center gap-1.5">
              <span>➕</span> {t('tools.generalMath.name')}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/tools/higher-math', lang)} class="hover:text-cyan-400 transition flex items-center gap-1.5">
              <span>📐</span> {t('tools.higherMath.name')}
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Specialized & ICT Tools -->
      <div class="space-y-2">
        <h4 class="text-xs font-semibold text-slate-200 uppercase tracking-wider">
          {lang === 'bn' ? 'আইসিটি ও বিশেষায়িত টুলস' : 'ICT & Specialized Tools'}
        </h4>
        <ul class="space-y-1.5">
          <li>
            <a href={getLocalizedPath('/tools/html-runner', lang)} class="hover:text-cyan-400 transition">
              {t('tools.htmlRunner.name')}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/tools/circuit-simulator', lang)} class="hover:text-cyan-400 transition">
              {t('tools.circuitSimulator.name')}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/tools/c-runner', lang)} class="hover:text-cyan-400 transition">
              {t('tools.cRunner.name')}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/tools/database-simulator', lang)} class="hover:text-cyan-400 transition">
              {t('tools.dbSimulator.name')}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/tools/molar-mass', lang)} class="hover:text-cyan-400 transition">
              {t('tools.molarMass.name')}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/tools/redox-balancer', lang)} class="hover:text-cyan-400 transition">
              {t('tools.redox.name')}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/tools/projectile-motion', lang)} class="hover:text-cyan-400 transition">
              {t('tools.projectile.name')}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/tools/vector-calculator', lang)} class="hover:text-cyan-400 transition">
              {lang === 'bn' ? 'ভেক্টর ৩ডি গুণন' : '3D Vector Solver'}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/tools/gas-law-calculator', lang)} class="hover:text-cyan-400 transition">
              {lang === 'bn' ? 'আদর্শ গ্যাস সূত্র' : 'Ideal Gas Law'}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/tools/solution-dilution', lang)} class="hover:text-cyan-400 transition">
              {lang === 'bn' ? 'দ্রবণ লঘুকরণ (Dilution)' : 'Solution Dilution'}
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Academic Resources & Trust -->
      <div class="space-y-2">
        <h4 class="text-xs font-semibold text-slate-200 uppercase tracking-wider">
          {lang === 'bn' ? 'শিক্ষা ও নীতি' : 'Resources & Trust'}
        </h4>
        <ul class="space-y-1.5">
          <li>
            <a href={getLocalizedPath('/about', lang)} class="hover:text-cyan-400 transition font-semibold text-slate-200">
              {lang === 'bn' ? 'ℹ️ আমাদের পরিচিতি (About Us)' : 'ℹ️ About Us'}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/contact', lang)} class="hover:text-cyan-400 transition text-cyan-400 font-medium">
              {lang === 'bn' ? '📬 যোগাযোগ ও সম্পাদকীয় সহায়তা' : '📬 Contact & Editorial Support'}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/curriculum', lang)} class="text-cyan-400 font-semibold hover:underline">
              {lang === 'bn' ? '🎓 কারিকুলাম ও সিলেবাস' : '🎓 Curriculum & Syllabus'}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/formulas', lang)} class="hover:text-cyan-400 transition">
              {t('nav.formulas')}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/periodic-table', lang)} class="hover:text-cyan-400 transition">
              {t('nav.periodicTable')}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/glossary', lang)} class="hover:text-cyan-400 transition">
              {t('nav.glossary')}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/methodology', lang)} class="hover:text-cyan-400 transition">
              {t('nav.methodology')}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/editorial', lang)} class="hover:text-cyan-400 transition">
              {t('footer.editorial')}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/privacy', lang)} class="hover:text-cyan-400 transition">
              {t('footer.privacy')}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/terms', lang)} class="hover:text-cyan-400 transition">
              {t('footer.terms')}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Legal Line -->
    <div class="mt-8 pt-6 border-t border-slate-900 flex flex-col sm:flex-row items-center justify-between gap-3 text-slate-500 text-[11px]">
      <div>
        © {currentYear} Biggan.me. {t('footer.rights')}
      </div>
      <div>
        {t('footer.disclaimer')}
      </div>
    </div>
  </div>
</footer>
