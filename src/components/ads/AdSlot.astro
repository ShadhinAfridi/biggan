---
interface Props {
  slotType?: 'banner' | 'sidebar' | 'in-content';
  slotId?: string;
  className?: string;
}

const { slotType = 'banner', slotId = '', className = '' } = Astro.props;
const clientId = import.meta.env.PUBLIC_ADSENSE_CLIENT_ID || '';
const isLive = Boolean(clientId && slotId);

const containerClasses = {
  banner: 'min-h-[90px] max-w-[728px] w-full',
  sidebar: 'min-h-[250px] w-full max-w-[300px]',
  'in-content': 'min-h-[120px] w-full max-w-[640px]',
}[slotType];
---

<div class={`ad-slot-container ${containerClasses} ${className} mx-auto my-6 flex flex-col items-center justify-center`} aria-hidden={!isLive ? "true" : "false"}>
  {isLive ? (
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={clientId}
      data-ad-slot={slotId}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
    <script>
      // @ts-ignore
      (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  ) : (
    <div class="text-center p-3">
      <span class="text-[10px] uppercase font-mono tracking-widest text-slate-500 block">
        Advertisement Placement
      </span>
      <span class="text-[9px] text-slate-600 font-mono">
        (CLS = 0 Reserved Dimension • {slotType})
      </span>
    </div>
  )}
</div>
