---
import { getLangFromUrl } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  jsonLd?: Record<string, any> | Record<string, any>[];
  noindex?: boolean;
}

const { title, description, jsonLd, noindex = false } = Astro.props;
const lang = Astro.props.lang || getLangFromUrl(Astro.url);

const siteUrl = 'https://biggan.me';
const pathname = Astro.url.pathname;
let normalizedPath = pathname;
if (normalizedPath !== '/' && !normalizedPath.endsWith('/') && !normalizedPath.includes('.')) {
  normalizedPath = `${normalizedPath}/`;
}
const cleanPath = normalizedPath.replace(/^\/(en|bn)/, '') || '/';
const canonicalUrl = `${siteUrl}${normalizedPath}`;
const enUrl = `${siteUrl}/en${cleanPath === '/' ? '/' : cleanPath}`;
const bnUrl = `${siteUrl}/bn${cleanPath === '/' ? '/' : cleanPath}`;

const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION || '';
const bingVerification = import.meta.env.PUBLIC_BING_VERIFICATION || '';
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || '';
const adsenseClientId = import.meta.env.PUBLIC_ADSENSE_CLIENT_ID || '';

// Build base schemas for WebSite and EducationalOrganization
const baseSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Biggan.me',
    url: siteUrl,
    inLanguage: lang === 'bn' ? 'bn-BD' : 'en-US',
    description: description,
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${siteUrl}/${lang}/formulas?q={search_term_string}`,
      },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'EducationalOrganization',
    name: 'Biggan.me',
    url: siteUrl,
    logo: `${siteUrl}/favicon.svg`,
  },
];

const pageSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const combinedSchemas = [...baseSchemas, ...pageSchemas];
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
{noindex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
)}
<meta name="theme-color" content="#020617" id="meta-theme-color" />
<meta name="color-scheme" content="dark light" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="manifest" href="/manifest.webmanifest" />
<meta name="generator" content={Astro.generator} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

<!-- Bidirectional Hreflang Tags for SEO -->
<link rel="alternate" hreflang="bn" href={bnUrl} />
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="x-default" href={bnUrl} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content="Biggan.me" />
<meta property="og:locale" content={lang === 'bn' ? 'bn_BD' : 'en_US'} />
<meta property="og:image" content={`${siteUrl}/og-image.png`} />
<meta property="og:image:secure_url" content={`${siteUrl}/og-image.png`} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Biggan.me — Step-by-Step STEM Solvers & Scientific Calculators" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={`${siteUrl}/og-image.png`} />
<meta name="twitter:image:alt" content="Biggan.me — Step-by-Step STEM Solvers & Scientific Calculators" />

<!-- Google Search Console Verification -->
{gscVerification && <meta name="google-site-verification" content={gscVerification} />}

<!-- Bing Webmaster Verification -->
{bingVerification && <meta name="msvalidate.01" content={bingVerification} />}

<!-- Deferred Third-Party Services (GA4 & AdSense) with Google Consent Mode v2 -->
{(adsenseClientId || gaId) && (
  <script is:inline define:vars={{ adsenseClientId, gaId }}>
    (() => {
      // 1. Establish dataLayer and Consent Mode v2 defaults immediately
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      window.gtag = gtag;

      let savedConsent = null;
      try {
        savedConsent = localStorage.getItem('biggan_consent');
      } catch (e) {}

      if (savedConsent === 'all') {
        gtag('consent', 'default', {
          'ad_storage': 'granted',
          'ad_user_data': 'granted',
          'ad_personalization': 'granted',
          'analytics_storage': 'granted'
        });
      } else {
        gtag('consent', 'default', {
          'ad_storage': 'denied',
          'ad_user_data': 'denied',
          'ad_personalization': 'denied',
          'analytics_storage': 'denied'
        });
      }

      // 2. Configure AdSense non-personalized ads if consent is essential-only
      if (savedConsent === 'essential') {
        (window.adsbygoogle = window.adsbygoogle || []).requestNonPersonalizedAds = 1;
      }

      // 3. Deferred execution to protect critical render path & tool interactivity
      let loaded = false;
      function loadThirdParty() {
        if (loaded) return;
        loaded = true;

        if (gaId) {
          const gaScript = document.createElement('script');
          gaScript.async = true;
          gaScript.src = `https://www.googletagmanager.com/gtag/js?id=${gaId}`;
          document.head.appendChild(gaScript);
          gtag('js', new Date());
          gtag('config', gaId);
        }

        if (adsenseClientId) {
          const adScript = document.createElement('script');
          adScript.async = true;
          adScript.crossOrigin = 'anonymous';
          adScript.src = `https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClientId}`;
          document.head.appendChild(adScript);
        }
      }

      if (document.readyState === 'complete') {
        if ('requestIdleCallback' in window) {
          window.requestIdleCallback(loadThirdParty, { timeout: 3000 });
        } else {
          setTimeout(loadThirdParty, 1500);
        }
      } else {
        window.addEventListener('load', () => {
          if ('requestIdleCallback' in window) {
            window.requestIdleCallback(loadThirdParty, { timeout: 3000 });
          } else {
            setTimeout(loadThirdParty, 1500);
          }
        }, { once: true });
      }

      ['pointerdown', 'keydown', 'scroll'].forEach((event) => {
        window.addEventListener(event, loadThirdParty, { once: true, passive: true });
      });
    })();
  </script>
)}

<!-- JSON-LD Structured Data -->
<script
  type="application/ld+json"
  set:html={JSON.stringify(combinedSchemas)}
/>
