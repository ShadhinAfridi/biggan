---
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { Latex } from '../../../components/math/Latex';
import { getLocalizedPath } from '../../../i18n/utils';
---

<ArticleLayout
  title="আয়ন-ইলেকট্রন পদ্ধতিতে রেডক্স সমতাকরণ: সম্পূর্ণ নিয়মাবলী ও বোর্ড পরীক্ষার সমাধান"
  metaDescription="উচ্চমাধ্যমিক (HSC) ও CBSE রসায়নে অম্লীয় ও ক্ষারীয় মাধ্যমে জারণ-বিজারণ বিক্রিয়া সমতাকরণের সহজ ধাপে ধাপে গাইড, শর্টকাট ও কাসিও ক্যালকুলেটর যাচাই।"
  curriculum="NCTB একাদশ-দ্বাদশ রসায়ন ১ম পত্র (অধ্যায় ৩) / NCERT Class 11 Redox Reactions"
  readTime="8 মিনিট"
  publishedDate="2026-09-08"
  relatedTool={{
    name: "আয়ন-ইলেকট্রন রেডক্স সমতাকরণ ক্যালকুলেটর",
    href: getLocalizedPath("/tools/redox-balancer", "bn"),
    desc: "অম্লীয় বা ক্ষারীয় মাধ্যমে যেকোনো জটিল জারণ-বিজারণ সমীকরণ নিমেষেই সমতা করুন ও পূর্ণাঙ্গ অর্ধ-বিক্রিয়া দেখুন।"
  }}
>
  <section class="space-y-4">
    <h2 class="text-2xl font-bold text-white border-l-4 border-cyan-500 pl-3">
      ১. আয়ন-ইলেকট্রন পদ্ধতি (অর্ধ-বিক্রিয়া পদ্ধতি) কী?
    </h2>
    <p>
      রসায়নে জারণ-বিজারণ (Redox) বিক্রিয়া সমতাকরণের সবচেয়ে বৈজ্ঞানিক ও নির্ভুল মাধ্যম হলো <strong>আয়ন-ইলেকট্রন পদ্ধতি (Ion-Electron Method)</strong>, যা অর্ধ-বিক্রিয়া পদ্ধতি নামেও পরিচিত। সনাতন অনুমানের ভিত্তিতে সমতাকরণ অনেক সময় জটিল যৌগের ক্ষেত্রে ব্যর্থ হয়, কিন্তু আয়ন-ইলেকট্রন পদ্ধতি দুটি পরম নিয়মের ওপর দাঁড়িয়ে থাকে:
    </p>
    <ul class="list-disc list-inside space-y-2 text-slate-300 ml-2">
      <li><strong>ভরের নিত্যতা সূত্র:</strong> সমীকরণের উভয় পাশে প্রতিটি মৌলের মোট পরমাণুর সংখ্যা সমান হতে হবে।</li>
      <li><strong>চার্জের নিত্যতা সূত্র:</strong> সমীকরণের বিক্রিয়ক ও উৎপাদ উভয় পক্ষের মোট নিট তড়িৎ আধান সমান হতে হবে।</li>
    </ul>
  </section>

  <section class="space-y-4">
    <h2 class="text-2xl font-bold text-white border-l-4 border-cyan-500 pl-3">
      ২. অম্লীয় মাধ্যমে সমতাকরণের ৫টি সোনালী ধাপ
    </h2>
    <div class="space-y-4 bg-slate-900/60 p-5 rounded-xl border border-slate-800">
      <div class="space-y-1">
        <h3 class="font-bold text-cyan-400">ধাপ ১: জারণ সংখ্যা নির্ণয় ও অর্ধ-বিক্রিয়ায় বিভক্তিকরণ</h3>
        <p class="text-sm text-slate-300">
          কেন্দ্রীয় পরমাণুর জারণ সংখ্যা চিহ্নিত করে বিক্রিয়াটিকে জারণ অর্ধ-বিক্রিয়া এবং বিজারণ অর্ধ-বিক্রিয়ায় ভাগ করুন।
        </p>
      </div>

      <div class="space-y-1">
        <h3 class="font-bold text-cyan-400">ধাপ ২: O এবং H ব্যতিরেকে অন্যান্য পরমাণু সমতা</h3>
        <p class="text-sm text-slate-300">
          অক্সিজেন এবং হাইড্রোজেন ছাড়া বাকি সকল মৌলের পরমাণুর সংখ্যা প্রথমে উপযুক্ত সহগ বসিয়ে সমান করুন।
        </p>
      </div>

      <div class="space-y-1">
        <h3 class="font-bold text-cyan-400">ধাপ ৩: অক্সিজেন ও হাইড্রোজেন সমতা</h3>
        <p class="text-sm text-slate-300">
          প্রতিটি অতিরিক্ত অক্সিজেন পরমাণুর জন্য বিপরীত পাশে এক অণু পানি যোগ করুন। এরপর প্রয়োজনীয় হাইড্রোজেন পরমাণুর সমতার জন্য অম্লীয় মাধ্যমে প্রোটন যোগ করুন।
        </p>
      </div>

      <div class="space-y-1">
        <h3 class="font-bold text-cyan-400">ধাপ ৪: আধান বা চার্জ সমতা</h3>
        <p class="text-sm text-slate-300">
          উভয় পাশের নিট আধান সমান করার জন্য যে পাশে ধনাত্মক আধান বেশি সে পাশে প্রয়োজনীয় সংখ্যক ইলেকট্রন যোগ করুন।
        </p>
      </div>

      <div class="space-y-1">
        <h3 class="font-bold text-cyan-400">ধাপ ৫: ইলেকট্রন সংখ্যা সমান করে যোগ ও দর্শক আয়ন সংযোজন</h3>
        <p class="text-sm text-slate-300">
          উভয় অর্ধ-বিক্রিয়াকে এমন পূর্ণসংখ্যা দিয়ে গুণ করুন যাতে ইলেকট্রনের সংখ্যা সমান হয়। এরপর সমীকরণ দুটি যোগ করে পূর্ণ আণবিক রূপ দিন।
        </p>
      </div>
    </div>
  </section>

  <section class="space-y-4">
    <h2 class="text-2xl font-bold text-white border-l-4 border-cyan-500 pl-3">
      ৩. বোর্ড পরীক্ষায় সর্বাধিক আসা উদাহরণ: পটাশিয়াম পারম্যাঙ্গানেট ও ফেরাস সালফেট
    </h2>
    <p>
      <strong>প্রশ্ন:</strong> অম্লীয় মাধ্যমে পটাশিয়াম পারম্যাঙ্গানেট ও ফেরাস সালফেটের বিক্রিয়াটি আয়ন-ইলেকট্রন পদ্ধতিতে সমতা করো।
    </p>

    <div class="bg-slate-900/80 p-5 rounded-xl border border-slate-700/60 space-y-4 font-mono text-sm">
      <div>
        <span class="text-cyan-400 font-bold block mb-1">কঙ্কাল আয়নীয় সমীকরণ:</span>
        <div class="py-2 text-center bg-slate-950 rounded border border-slate-800">
          <Latex formula={'\\text{MnO}_4^- + \\text{Fe}^{2+} \\rightarrow \\text{Mn}^{2+} + \\text{Fe}^{3+}'} displayMode={true} client:visible />
        </div>
      </div>

      <div>
        <span class="text-emerald-400 font-bold block mb-1">১. জারণ অর্ধ-বিক্রিয়া:</span>
        <p class="text-xs text-slate-300 font-sans mb-1">আয়রন(II) জারিত হয়ে আয়রন(III)-এ পরিণত হয় এবং ১টি ইলেকট্রন ত্যাগ করে:</p>
        <div class="py-2 text-center bg-slate-950 rounded border border-slate-800">
          <Latex formula={'\\text{Fe}^{2+} \\rightarrow \\text{Fe}^{3+} + e^-'} displayMode={true} client:visible />
        </div>
      </div>

      <div>
        <span class="text-purple-400 font-bold block mb-1">২. বিজারণ অর্ধ-বিক্রিয়া:</span>
        <p class="text-xs text-slate-300 font-sans mb-1">পারম্যাঙ্গানেট আয়নে Mn (+7) থেকে (+2)-এ বিজারিত হয়। ৪টি অক্সিজেনের জন্য ৪টি পানি এবং ৮টি প্রোটন যুক্ত হয়:</p>
        <div class="py-2 text-center bg-slate-950 rounded border border-slate-800">
          <Latex formula={'\\text{MnO}_4^- + 8\\text{H}^+ + 5e^- \\rightarrow \\text{Mn}^{2+} + 4\\text{H}_2\\text{O}'} displayMode={true} client:visible />
        </div>
      </div>

      <div>
        <span class="text-amber-400 font-bold block mb-1">৩. ইলেকট্রন সমতা ও যোগফল:</span>
        <div class="py-2 text-center bg-slate-950 rounded border border-slate-800">
          <Latex formula={'\\text{MnO}_4^- + 5\\text{Fe}^{2+} + 8\\text{H}^+ \\rightarrow \\text{Mn}^{2+} + 5\\text{Fe}^{3+} + 4\\text{H}_2\\text{O}'} displayMode={true} client:visible />
        </div>
      </div>

      <div>
        <span class="text-cyan-300 font-bold block mb-1">৪. পূর্ণ আণবিক সমীকরণ:</span>
        <div class="py-2 text-center bg-slate-950 rounded border border-slate-800 text-xs sm:text-sm overflow-x-auto">
          <Latex formula={'2\\text{KMnO}_4 + 10\\text{FeSO}_4 + 8\\text{H}_2\\text{SO}_4 \\rightarrow 2\\text{MnSO}_4 + 5\\text{Fe}_2(\\text{SO}_4)_3 + \\text{K}_2\\text{SO}_4 + 8\\text{H}_2\\text{O}'} displayMode={true} client:visible />
        </div>
      </div>
    </div>
  </section>

  <section class="space-y-4">
    <h2 class="text-2xl font-bold text-white border-l-4 border-cyan-500 pl-3">
      ৪. ক্ষারীয় মাধ্যমে সমতাকরণের সহজ কৌশল
    </h2>
    <ol class="list-decimal list-inside space-y-2 text-slate-300 ml-2">
      <li>প্রথমে বিক্রিয়াটিকে সাধারণ অম্লীয় মাধ্যমের নিয়ম অনুযায়ী সমতা করুন।</li>
      <li>সমীকরণের উভয় পাশে ঠিক যতটি প্রোটন উপস্থিত আছে, তত সংখ্যক হাইড্রোক্সিল আয়ন যোগ করুন।</li>
      <li>প্রোটন ও হাইড্রোক্সিল মিলে পানি গঠন করবে।</li>
      <li>উভয় পাশের অতিরিক্ত পানি বাতিল করে চূড়ান্ত ক্ষারীয় সমীকরণ বের করুন।</li>
    </ol>
  </section>
</ArticleLayout>
