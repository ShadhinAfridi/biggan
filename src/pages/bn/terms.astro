---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocalizedPath } from '../../i18n/utils';

const siteUrl = 'https://biggan.me';
const canonicalUrl = `${siteUrl}/bn/terms`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'হোম',
      item: `${siteUrl}/bn`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'ব্যবহারের শর্তাবলী (Terms of Service)',
      item: canonicalUrl,
    },
  ],
};
---

<BaseLayout
  title="ব্যবহারের শর্তাবলী (Terms of Service) — Biggan.me"
  description="Biggan.me ওয়েবসাইট ব্যবহারের শর্তাবলী, কপিরাইট, দায়মুক্তি এবং অ্যাকাডেমিক রেফারেন্স সংক্রান্ত নীতিমালা।"
  lang="bn"
  jsonLd={breadcrumbSchema}
>
  <div class="max-w-4xl mx-auto space-y-8">
    <!-- Breadcrumbs -->
    <nav aria-label="Breadcrumb">
      <ol class="flex items-center gap-2 text-xs font-mono text-slate-400">
        <li>
          <a href={getLocalizedPath('/', 'bn')} class="hover:text-cyan-400 transition">হোম</a>
        </li>
        <li>/</li>
        <li class="text-cyan-400 font-semibold">ব্যবহারের শর্তাবলী</li>
      </ol>
    </nav>

    <!-- Header Section -->
    <div class="space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 text-xs font-mono">
        আইনি নীতিমালা
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
        ব্যবহারের শর্তাবলী (Terms of Service)
      </h1>
      <p class="text-base text-slate-400 leading-relaxed">
        সর্বশেষ সংস্করণ: সেপ্টেম্বর ২০২৬। Biggan.me প্ল্যাটফর্ম ব্যবহার করার মাধ্যমে আপনি নিম্নলিখিত শর্তাবলী এবং আমাদের নীতিমালার প্রতি সম্মতি জ্ঞাপন করছেন।
      </p>
    </div>

    <!-- Main Content -->
    <div class="prose prose-invert max-w-none text-slate-300 text-sm sm:text-base space-y-6 leading-relaxed bg-slate-900/60 border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-xl">
      <h2 class="text-xl font-bold text-white">১. প্ল্যাটফর্মের ব্যবহার ও শিক্ষামূলক উদ্দেশ্য</h2>
      <p>
        Biggan.me একটি নিখরচায় উন্মুক্ত শিক্ষামূলক পোর্টাল। এর সকল সায়েন্টিফিক ক্যালকুলেটর, গাণিতিক সমাধান, পর্যায় সারণী এবং আইসিটি ল্যাব টুলস শিক্ষার্থীদের শিখন দক্ষতা বৃদ্ধি এবং শিক্ষকদের ক্লাসরুম ডেমোস্ট্রেশনের উদ্দেশ্যে উন্মুক্ত রাখা হয়েছে। কোনো বাণিজ্যিক উদ্দেশ্যে এই প্ল্যাটফর্ম স্ক্র্যাপ বা অননুমোদিতভাবে স্বয়ংক্রিয় উপায়ে ক্লোন করা নিষিদ্ধ।
      </p>

      <h2 class="text-xl font-bold text-white mt-6">২. বুদ্ধিবৃত্তিক সম্পদ ও কপিরাইট</h2>
      <p>
        ওয়েবসাইটের ইন্টারফেস কোড, বৈজ্ঞানিক ব্যাখ্যা, বাংলা পরিভাষার সংকলন এবং কাসিও কি-স্ট্রোক গাইড Biggan.me-এর বৌদ্ধিক সম্পদ। শিক্ষা এবং ব্যক্তিগত হোমওয়ার্ক অনুশীলনের জন্য সাইটের কন্টেন্ট মুদ্রণ (Print) বা পিডিএফ সংরক্ষণে কোনো বাধা নেই।
      </p>

      <h2 class="text-xl font-bold text-white mt-6">৩. দায়মুক্তি ও সতর্কবার্তা (Disclaimer)</h2>
      <p>
        আমরা সর্বোচ্চ সতর্কতা ও বৈজ্ঞানিক মান বজায় রেখে গাণিতিক সূত্র ও অ্যালগরিদম প্রস্তুত করেছি। তবে কোনো পরীক্ষা বা বিশেষ ক্ষেত্রে গণনার অনাকাঙ্ক্ষিত অসঙ্গতির জন্য Biggan.me কর্তৃপক্ষ কোনো আর্থিক বা আইনি দায় বহন করবে না। বিস্তারিত জানতে অনুগ্রহ করে আমাদের পৃথক <a href={getLocalizedPath('/disclaimer', 'bn')} class="text-cyan-400 underline font-semibold">দায়মুক্তি ও আইনি সতর্কতা (Disclaimer)</a> পেজটি পাঠ করুন।
      </p>

      <h2 class="text-xl font-bold text-white mt-6">৪. গোপনীয়তা ও তৃতীয় পক্ষের সেবা</h2>
      <p>
        আমাদের প্ল্যাটফর্মে কুকিজ, লোকাল স্টোরেজ এবং গুগল অ্যাডসেন্স ব্যবহারের বিস্তারিত নীতিমালা জানতে আমাদের <a href={getLocalizedPath('/privacy', 'bn')} class="text-cyan-400 underline font-semibold">গোপনীয়তা নীতি (Privacy Policy)</a> দেখুন।
      </p>

      <h2 class="text-xl font-bold text-white mt-6">৫. যোগাযোগ ও প্রশ্নাবলী</h2>
      <p>
        ব্যবহারের শর্তাবলী সম্পর্কিত যেকোনো জিজ্ঞাসার জন্য আমাদের <a href={getLocalizedPath('/contact', 'bn')} class="text-cyan-400 underline font-semibold">যোগাযোগ ও সম্পাদকীয় ডেস্কে</a> যোগাযোগ করতে পারেন।
      </p>
    </div>
  </div>
</BaseLayout>
