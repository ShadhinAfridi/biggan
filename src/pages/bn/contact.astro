---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocalizedPath } from '../../i18n/utils';

const siteUrl = 'https://biggan.me';
const canonicalUrl = `${siteUrl}/bn/contact`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'হোম',
      item: `${siteUrl}/bn`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'যোগাযোগ (Contact)',
      item: canonicalUrl,
    },
  ],
};

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'যোগাযোগ ও একাডেমিক সহায়তা — Biggan.me',
  description: 'Biggan.me এর সাথে যোগাযোগের মাধ্যম: শিক্ষামূলক তথ্য অনুসন্ধান, ক্যালকুলেটরে বাগ বা ভুল সংশোধন, শিক্ষক সহযোগিতা ও প্ল্যাটফর্ম ফিডব্যাক।',
  url: canonicalUrl,
  mainEntity: {
    '@type': 'EducationalOrganization',
    name: 'Biggan.me',
    url: siteUrl,
    email: 'support@biggan.me',
    sameAs: ['https://github.com/ShadhinAfridi/biggan'],
  },
};
---

<BaseLayout
  title="যোগাযোগ ও একাডেমিক সহায়তা (Contact Us) — Biggan.me"
  description="Biggan.me এর সাথে যোগাযোগের মাধ্যম: শিক্ষামূলক তথ্য অনুসন্ধান, ক্যালকুলেটরে বাগ বা ভুল সংশোধন, শিক্ষক সহযোগিতা ও প্ল্যাটফর্ম ফিডব্যাক।"
  lang="bn"
  jsonLd={[breadcrumbSchema, contactSchema]}
>
  <div class="max-w-4xl mx-auto space-y-10">
    <!-- Breadcrumbs -->
    <nav aria-label="Breadcrumb">
      <ol class="flex items-center gap-2 text-xs font-mono text-slate-400">
        <li>
          <a href={getLocalizedPath('/', 'bn')} class="hover:text-cyan-400 transition">হোম</a>
        </li>
        <li>/</li>
        <li class="text-cyan-400 font-semibold">যোগাযোগ</li>
      </ol>
    </nav>

    <!-- Header Section -->
    <div class="space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 text-xs font-mono font-semibold">
        <span>📬</span>
        <span>যোগাযোগ ও সহায়তা</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
        আমরা আপনার মতামতের অপেক্ষায় আছি
      </h1>
      <p class="text-sm sm:text-base text-slate-300 max-w-2xl leading-relaxed">
        গণনায় কোনো অসংগতি, নতুন ক্যালকুলেটরের প্রস্তাব বা প্রাতিষ্ঠানিক সহযোগিতার জন্য সরাসরি আমাদের বিজ্ঞান শিক্ষক ও প্রযুক্তি দলের সাথে যোগাযোগ করুন।
      </p>
    </div>

    <!-- Contact Channels Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800 space-y-3 shadow-lg">
        <div class="w-10 h-10 rounded-xl bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 flex items-center justify-center text-xl">
          ✉️
        </div>
        <h2 class="text-base font-bold text-white">সাধারণ ও একাডেমিক প্রশ্ন</h2>
        <p class="text-xs text-slate-400 leading-relaxed">
          সিলেবাস, সূত্র বা সাধারণ জিজ্ঞাসার জন্য আমাদের ইমেইল করুন।
        </p>
        <a href="mailto:support@biggan.me" class="inline-block text-xs font-mono text-cyan-400 font-semibold hover:underline">
          support@biggan.me
        </a>
      </div>

      <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800 space-y-3 shadow-lg">
        <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-400 flex items-center justify-center text-xl">
          🔍
        </div>
        <h2 class="text-base font-bold text-white">ভুল ও বাগ সংশোধন</h2>
        <p class="text-xs text-slate-400 leading-relaxed">
          কোনো সমীকরণ বা ক্যালকুলেশন পদক্ষেপে ত্রুটি পেলে আমাদের অবহিত করুন।
        </p>
        <a href="mailto:editorial@biggan.me" class="inline-block text-xs font-mono text-amber-400 font-semibold hover:underline">
          editorial@biggan.me
        </a>
      </div>

      <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800 space-y-3 shadow-lg">
        <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center text-xl">
          💻
        </div>
        <h2 class="text-base font-bold text-white">ওপেন সোর্স ও ডেভেলপার</h2>
        <p class="text-xs text-slate-400 leading-relaxed">
          কোড কন্ট্রিবিউশন বা গিটহাব ইস্যুতে নতুন ফিচার প্রস্তাব করতে পারেন।
        </p>
        <a href="https://github.com/ShadhinAfridi/biggan" target="_blank" rel="noopener noreferrer" class="inline-block text-xs font-mono text-emerald-400 font-semibold hover:underline">
          GitHub Repository →
        </a>
      </div>
    </div>

    <!-- Feedback & Message Form -->
    <div class="p-6 sm:p-8 rounded-3xl bg-slate-900/80 border border-slate-800 shadow-xl space-y-6">
      <div class="border-b border-slate-800 pb-4">
        <h2 class="text-lg sm:text-xl font-bold text-white flex items-center gap-2">
          <span>📝</span>
          <span>দ্রুত বার্তা পাঠান</span>
        </h2>
        <p class="text-xs text-slate-400 mt-1">
          আপনার বার্তাটি সরাসরি আমাদের সম্পাদকীয় ও টেকনিক্যাল বোর্ডে পৌঁছে যাবে।
        </p>
      </div>

      <form class="space-y-4" onsubmit="event.preventDefault(); alert('ধন্যবাদ! আপনার বার্তাটি সফলভাবে গৃহীত হয়েছে। আমাদের টিম দ্রুত আপনার সাথে যোগাযোগ করবে।'); this.reset();">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label for="contact-name" class="block text-xs font-semibold text-slate-300">
              আপনার নাম <span class="text-rose-400">*</span>
            </label>
            <input
              type="text"
              id="contact-name"
              required
              placeholder="যেমন: সাকিব আল হাসান"
              class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-slate-100 text-xs focus:outline-none focus:border-cyan-400 transition"
            />
          </div>
          <div class="space-y-1.5">
            <label for="contact-email" class="block text-xs font-semibold text-slate-300">
              ইমেইল অ্যাড্রেস <span class="text-rose-400">*</span>
            </label>
            <input
              type="email"
              id="contact-email"
              required
              placeholder="যেমন: student@example.com"
              class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-slate-100 text-xs focus:outline-none focus:border-cyan-400 transition"
            />
          </div>
        </div>

        <div class="space-y-1.5">
          <label for="contact-subject" class="block text-xs font-semibold text-slate-300">
            বিষয় <span class="text-rose-400">*</span>
          </label>
          <select
            id="contact-subject"
            class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-slate-300 text-xs focus:outline-none focus:border-cyan-400 transition"
          >
            <option value="math-error">গাণিতিক ত্রুটি বা টাইপো রিপোর্ট</option>
            <option value="feature-request">নতুন টুল বা সিমুলেটরের প্রস্তাব</option>
            <option value="academic-partnership">শিক্ষক বা প্রাতিষ্ঠানিক পার্টনারশিপ</option>
            <option value="general">সাধারণ জিজ্ঞাসা</option>
          </select>
        </div>

        <div class="space-y-1.5">
          <label for="contact-message" class="block text-xs font-semibold text-slate-300">
            বিস্তারিত বার্তা <span class="text-rose-400">*</span>
          </label>
          <textarea
            id="contact-message"
            rows="4"
            required
            placeholder="আপনার বক্তব্য বিস্তারিতভাবে লিখুন (প্রয়োজনে টুলটির নাম বা চ্যাপ্টার উল্লেখ করুন)..."
            class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-slate-100 text-xs focus:outline-none focus:border-cyan-400 transition"
          ></textarea>
        </div>

        <button
          type="submit"
          class="px-6 py-2.5 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold text-xs transition shadow-lg shadow-cyan-950/50"
        >
          বার্তা প্রেরণ করুন →
        </button>
      </form>
    </div>

    <!-- Trust & Verification Footer -->
    <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs text-slate-400">
      <div>
        <span class="font-semibold text-slate-200 block">সম্পাদকীয় দলের প্রতিশ্রুতি</span>
        <span>আমরা যেকোনো গাণিতিক অসংগতি ২৪ থেকে ৪৮ ঘণ্টার মধ্যে সংশোধন করে থাকি।</span>
      </div>
      <div class="flex items-center gap-3 font-mono text-cyan-400 shrink-0">
        <a href={getLocalizedPath('/editorial', 'bn')} class="hover:underline">সম্পাদকীয় নীতিমালা →</a>
        <a href={getLocalizedPath('/methodology', 'bn')} class="hover:underline">যাচাই পদ্ধতি →</a>
      </div>
    </div>
  </div>
</BaseLayout>
