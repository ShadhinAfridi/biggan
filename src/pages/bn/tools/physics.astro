---
import ToolLayout, { type SolvedExemplar, type ToolFaqItem } from '../../../layouts/ToolLayout.astro';
import { PhysicsCalculator } from '../../../tools/physics/PhysicsCalculator';

const exemplars: SolvedExemplar[] = [
  {
    level: 'বোর্ড পরীক্ষা স্পেশাল (CQ গ — গতিবিদ্যা ও প্রক্ষেপণ)',
    levelBadge: 'bg-amber-500/10 text-amber-400 border border-amber-500/20',
    problemText: 'একটি ক্রিকেট বলকে ১৯.৬ মি/সে (19.6 m/s) বেগে খাড়া উপরের দিকে নিক্ষেপ করা হলো। বলটি সর্বোচ্চ কত উচ্চতায় উঠবে এবং কত সময় পর পুনরায় ভূমিতে ফিরে আসবে? (g = 9.8 m/s²)',
    givenData: [
      'আদি বেগ u = 19.6 m/s',
      'অভিকর্ষজ ত্বরণ g = 9.8 m/s²',
      'সর্বোচ্চ বিন্দুতে শেষ বেগ v = 0 m/s',
    ],
    solutionSteps: [
      'সর্বোচ্চ উচ্চতার সমীকরণ: v² = u² - 2gH_max ⟹ 0 = u² - 2gH_max ⟹ H_max = u² / (2g)',
      'H_max = (19.6)² / (2 × 9.8) = 384.16 / 19.6 = 19.6 মিটার।',
      'সর্বোচ্চ উচ্চতায় পৌঁছানোর সময়: t_rise = u / g = 19.6 / 9.8 = 2 সেকেন্ড।',
      'মোট উড্ডয়নকাল বা বিচরণকাল: T = 2 × t_rise = 2 × 2 = 4 সেকেন্ড।',
    ],
    finalAnswer: 'বলটি সর্বোচ্চ ১৯.৬ মিটার উচ্চতায় উঠবে এবং ৪ সেকেন্ড পর ভূমিতে ফিরে আসবে।',
  },
  {
    level: 'বোর্ড পরীক্ষা স্পেশাল (CQ গ/ঘ — কাজ, ক্ষমতা ও কর্মদক্ষতা)',
    levelBadge: 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20',
    problemText: 'একটি বৈদ্যুতিক মোটরের ক্ষমতা ২ অশ্বক্ষমতা (2 HP)। এটি দ্বারা ১০ মিটার গভীর কূয়া থেকে প্রতি মিনিটে ৫০০ কেজি পানি তোলা হয়। মোটরটির কর্মদক্ষতা (Efficiency) কত?',
    givenData: [
      'মোটরের মোট ক্ষমতা P_total = 2 HP = 2 × 746 W = 1492 Watts',
      'পানির ভর m = 500 kg, উচ্চতা h = 10 m, সময় t = 1 min = 60 s',
      'অভিকর্ষজ ত্বরণ g = 9.8 m/s²',
    ],
    solutionSteps: [
      'পানি তোলার কার্যকর কাজ: W = mgh = 500 × 9.8 × 10 = 49,000 Joules।',
      'কার্যকর বা লভ্য কার্যকর ক্ষমতা: P_useful = W / t = 49,000 / 60 = 816.67 Watts।',
      'কর্মদক্ষতার সূত্র: η = (P_useful / P_total) × 100%',
      'η = (816.67 / 1492) × 100% = 54.74%',
    ],
    finalAnswer: 'মোটরটির কর্মদক্ষতা ৫৪.৭৪%।',
  },
  {
    level: 'বোর্ড পরীক্ষা স্পেশাল (CQ গ — শব্দ ও প্রতিধ্বনি)',
    levelBadge: 'bg-cyan-500/10 text-cyan-400 border border-cyan-500/20',
    problemText: '৩০°C তাপমাত্রার কোনো দিনে একজন শিক্ষার্থী একটি পাহাড় থেকে কিছু দূরে দাঁড়িয়ে হাততালি দিল। শব্দের প্রতিধ্বনি শুনতে পাহাড়টির ন্যূনতম দূরত্ব কত হতে হবে?',
    givenData: [
      'বায়ুর তাপমাত্রা θ = 30°C',
      '0°C তাপমাত্রায় শব্দের বেগ v0 = 332 m/s',
      'শব্দানুভূতির স্থায়িত্বকাল t = 0.1 সেকেন্ড',
    ],
    solutionSteps: [
      '৩০°C তাপমাত্রায় শব্দের বেগ: v_θ = v0 + 0.6 × θ = 332 + (0.6 × 30) = 332 + 18 = 350 m/s।',
      'প্রতিধ্বনি শোনার জন্য শব্দের অতিক্রান্ত দূরত্ব: 2d = v × t ⟹ d = (v × t) / 2।',
      'ন্যূনতম দূরত্বের জন্য t = 0.1 s বিবেচনা করে: d_min = (350 × 0.1) / 2 = 35 / 2 = 17.5 মিটার।',
    ],
    finalAnswer: '৩০°C তাপমাত্রায় স্পষ্ট প্রতিধ্বনি শোনার জন্য প্রতিফলক পাহাড়ের ন্যূনতম দূরত্ব ১৭.৫ মিটার হতে হবে।',
  },
  {
    level: 'বোর্ড পরীক্ষা স্পেশাল (CQ গ/ঘ — চলতড়িৎ ও বিদ্যুৎ বিল)',
    levelBadge: 'bg-purple-500/10 text-purple-400 border border-purple-500/20',
    problemText: 'একটি বাড়িতে ৬০ ওয়াটের ৫টি বাতি এবং ১০০ ওয়াটের ২টি ফ্যান দৈনিক ৬ ঘণ্টা করে চালানো হয়। প্রতি ইউনিট বিদ্যুতের মূল্য ৭.৫০ টাকা হলে মে মাসে (৩১ দিন) কত টাকা বিদ্যুৎ বিল আসবে?',
    givenData: [
      '৫টি বাতির ক্ষমতা = 5 × 60 W = 300 W',
      '২টি ফ্যানের ক্ষমতা = 2 × 100 W = 200 W, মোট ক্ষমতা P = 500 Watts',
      'দৈনিক সময় t = 6 ঘণ্টা, মে মাসের দিন সংখ্যা = 31 দিন, ইউনিট রেট = 7.50 টাকা',
    ],
    solutionSteps: [
      'মে মাসে মোট ব্যয়িত শক্তি (kWh): W = (P × t_daily × days) / 1000',
      'W = (500 × 6 × 31) / 1000 = 93,000 / 1000 = 93 kWh (বোর্ড অব ট্রেড ইউনিট)।',
      'মোট বিদ্যুৎ বিল = মোট ইউনিট × প্রতি ইউনিটের মূল্য = 93 × 7.50 = 697.50 টাকা।',
    ],
    finalAnswer: 'মে মাসে উক্ত বাড়ির মোট বিদ্যুৎ বিল হবে ৬৯৭.৫০ টাকা।',
  },
];

const faqs: ToolFaqItem[] = [
  {
    question: 'এনসিটিবি এসএসসি পরীক্ষায় অভিকর্ষজ ত্বরণ g এর মান কত ধরতে হয়?',
    answer: 'বাংলাদেশ জাতীয় শিক্ষাক্রম ও পাঠ্যপুস্তক বোর্ড (NCTB) অনুমোদিত মাধ্যমিক পদার্থবিজ্ঞান পাঠ্যবইয়ে অভিকর্ষজ ত্বরণ g এর মান আদর্শ হিসেবে ৯.৮ মি/সে² (9.8 m/s²) ধরা হয়। আমাদের ক্যালকুলেটরে ৯.৮ এবং আন্তর্জাতিক স্ট্যান্ডার্ড ৯.৮১ উভয় মানই নির্বাচনের সুবিধা রয়েছে।',
  },
  {
    question: 'প্রতিধ্বনি শোনার ক্ষেত্রে ০.১ সেকেন্ড ও ন্যূনতম দূরত্বের সম্পর্ক কী?',
    answer: 'মানুষের মস্তিষ্কে কোনো শব্দের অনুভূতির রেশ প্রায় ০.১ সেকেন্ড পর্যন্ত স্থায়ী থাকে, যাকে শব্দানুভূতির স্থায়িত্বকাল (Persistence of Hearing) বলে। কোনো প্রতিফলিত শব্দ মূল শব্দের ০.১ সেকেন্ড বা তার পরে কানে পৌঁছালেই কেবল তা পৃথক প্রতিধ্বনি হিসেবে অনুভূত হয়। ০°C তাপমাত্রায় (v = 332 m/s) এ দূরত্ব ১৬.৬ মিটার এবং তাপমাত্রা বাড়লে শব্দের বেগ বৃদ্ধি পাওয়ায় প্রয়োজনীয় ন্যূনতম দূরত্বও বৃদ্ধি পায়।',
  },
  {
    question: 'দর্পণ ও লেন্সের অংকে ফোকাস দূরত্বের সাইন কনভেনশন (চিহ্ন রীতি) কী?',
    answer: 'দর্পণের ক্ষেত্রে: অবতল দর্পণের ফোকাস দূরত্ব f সবসময় ধনাত্মক (+ve) এবং উত্তল দর্পণের ফোকাস দূরত্ব f ঋণাত্মক (-ve)। লেন্সের ক্ষেত্রে: উত্তল লেন্সের ফোকাস দূরত্ব ধনাত্মক (+ve) এবং অবতল লেন্সের ফোকাস দূরত্ব ঋণাত্মক (-ve)। বিম্ব বাস্তব হলে v ধনাত্মক এবং অবাস্তব/সোজা হলে v ঋণাত্মক হয়।',
  },
  {
    question: 'কাসিও সায়েন্টিফিক ক্যালকুলেটরে গতির সমীকরণ ও প্রাসের অংক দ্রুত সমাধানের শর্টকাট কী?',
    answer: 'কাসিও fx-991EX / fx-991CW ক্যালকুলেটরে ভ্যারিয়েবল মেমরি (A, B, C, D, x) ব্যবহার করে জটিল সমীকরণ যেমন u²/(2g) বা v = u + at একবারে টাইপ করে CALC চেপে আদি মান পরিবর্তন করলেই নিমেষে সঠিক ফলাফল পাওয়া যায়। নিচে বিস্তারিত কীস্ট্রোক দেওয়া হয়েছে।',
  },
];
---

<ToolLayout
  title="এসএসসি পদার্থবিজ্ঞান সম্পূর্ণ সমাধান ও সমীকরণ ইঞ্জিন — Biggan.me"
  metaDescription="NCTB এসএসসি পদার্থবিজ্ঞান ৯ম-১০ম শ্রেণির ১৩টি অধ্যায়ের সম্পূর্ণ সমীকরণ ক্যালকুলেটর। গতি, বল, কাজ-শক্তি-ক্ষমতা, চাপ, তাপ, শব্দ, দর্পণ, লেন্স, চলতড়িৎ ও তেজস্ক্রিয়তা।"
  toolName="এসএসসি পদার্থবিজ্ঞান সমাধান ও সমীকরণ ইঞ্জিন"
  toolCategory="পদার্থবিজ্ঞান (SSC Physics)"
  curriculumTags={['NCTB এসএসসি পদার্থবিজ্ঞান (৯ম-১০ম)', '১৩টি অধ্যায়ের সম্পূর্ণ সূত্র', 'গতিবিদ্যা ও বল', 'চলতড়িৎ ও আলো']}
  topicId="kinematics"
  exemplars={exemplars}
  faqs={faqs}
>
  <div slot="calculator">
    <PhysicsCalculator client:visible lang="bn" />
  </div>

  <div slot="derivation">
    <div class="space-y-4 text-slate-300">
      <h3 class="text-base font-bold text-white">এনসিটিবি এসএসসি পদার্থবিজ্ঞান পাঠ্যক্রমের ১৩টি অধ্যায়ের মূল সূত্রের চার্ট</h3>
      <p class="text-sm">
        এসএসসি বোর্ড পরীক্ষায় ১০০ নম্বরের মধ্যে সৃজনশীল অংশে ৫০ নম্বর, বহুনির্বাচনি (MCQ) অংশে ২৫ নম্বর এবং ব্যবহারিক অংশে ২৫ নম্বর থাকে। গাণিতিক দক্ষতা ছাড়া পদার্থবিজ্ঞানে পূর্ণ নম্বর পাওয়া অসম্ভব। নিচে ১৩টি অধ্যায়ের প্রতিটি সমীকরণ সংকলন করা হলো:
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 font-mono text-xs text-slate-300">
        <div class="p-4 bg-slate-950 rounded-xl border border-slate-800 space-y-1.5">
          <span class="text-amber-400 font-bold block text-sm">১ম অধ্যায়: ভৌত রাশি ও পরিমাপ</span>
          <p>• ভার্নিয়ার ধ্রুবক: VC = s / N</p>
          <p>• স্লাইড ক্যালিপার্স পাঠ: L = M + (V × VC) - E</p>
          <p>• স্ক্রু গজ লঘিষ্ঠ গণন: LC = p / N</p>
          <p>• গোলকের আয়তন: V = 4/3 π r³</p>
        </div>

        <div class="p-4 bg-slate-950 rounded-xl border border-slate-800 space-y-1.5">
          <span class="text-amber-400 font-bold block text-sm">২য় অধ্যায়: গতি (Motion)</span>
          <p>• v = u + at</p>
          <p>• s = ((u + v)/2) × t</p>
          <p>• s = ut + 1/2 at²</p>
          <p>• v² = u² + 2as</p>
          <p>• খাড়া নিক্ষেপে: H_max = u² / (2g), T = 2u / g</p>
        </div>

        <div class="p-4 bg-slate-950 rounded-xl border border-slate-800 space-y-1.5">
          <span class="text-amber-400 font-bold block text-sm">৩য় অধ্যায়: বল (Force)</span>
          <p>• বল: F = ma</p>
          <p>• ভরবেগ: p = mv</p>
          <p>• সংরক্ষণশীলতা: m1u1 + m2u2 = m1v1 + m2v2</p>
          <p>• মিলিত বেগ: v = (m1u1 + m2u2) / (m1 + m2)</p>
          <p>• মহাকর্ষ বল: F = G (m1·m2) / d²</p>
        </div>

        <div class="p-4 bg-slate-950 rounded-xl border border-slate-800 space-y-1.5">
          <span class="text-amber-400 font-bold block text-sm">৪র্থ অধ্যায়: কাজ, ক্ষমতা ও শক্তি</span>
          <p>• কৃতকাজ: W = F·s·cos(θ)</p>
          <p>• গতিশক্তি: Ek = 1/2 mv²</p>
          <p>• বিভব শক্তি: Ep = mgh</p>
          <p>• ক্ষমতা: P = W / t (1 HP = 746 W)</p>
          <p>• কর্মদক্ষতা: η = (P_useful / P_total) × 100%</p>
        </div>

        <div class="p-4 bg-slate-950 rounded-xl border border-slate-800 space-y-1.5">
          <span class="text-amber-400 font-bold block text-sm">৫ম অধ্যায়: পদার্থের অবস্থা ও চাপ</span>
          <p>• চাপ: P = F / A</p>
          <p>• তরলের অভ্যন্তরে চাপ: P = h·ρ·g</p>
          <p>• হাইড্রলিক প্রেস: F1 / r1² = F2 / r2²</p>
          <p>• ইয়ং-এর গুণাঙ্ক: Y = (F·L) / (A·ΔL)</p>
        </div>

        <div class="p-4 bg-slate-950 rounded-xl border border-slate-800 space-y-1.5">
          <span class="text-amber-400 font-bold block text-sm">৬ষ্ঠ অধ্যায়: বস্তুর উপর তাপের প্রভাব</span>
          <p>• স্কেল রূপান্তর: C/5 = (F-32)/9 = (K-273)/5</p>
          <p>• কঠিনের প্রসারণ: ΔL = α L1 Δθ, β = 2α, γ = 3α</p>
          <p>• তাপের পরিমাণ: Q = m·s·Δθ</p>
          <p>• সুপ্ততাপ: Q = m·Lf (বরফ: 336000), Q = m·Lv</p>
        </div>

        <div class="p-4 bg-slate-950 rounded-xl border border-slate-800 space-y-1.5">
          <span class="text-amber-400 font-bold block text-sm">৭ম অধ্যায়: তরঙ্গ ও শব্দ</span>
          <p>• তরঙ্গ বেগ: v = f·λ, f = 1 / T</p>
          <p>• তাপমাত্রা ও শব্দের বেগ: v_θ = 332 + 0.6·θ</p>
          <p>• প্রতিধ্বনি: 2d = v·t</p>
          <p>• ন্যূনতম দূরত্ব: d_min = (v × 0.1) / 2</p>
        </div>

        <div class="p-4 bg-slate-950 rounded-xl border border-slate-800 space-y-1.5">
          <span class="text-amber-400 font-bold block text-sm">৮ম ও ৯ম অধ্যায়: আলো (প্রতিফলন ও প্রতিসরণ)</span>
          <p>• দর্পণ সমীকরণ: 1/f = 1/u + 1/v</p>
          <p>• বিবর্ধন: m = -v/u, |m| = hi / ho</p>
          <p>• স্নেলের সূত্র: η1·sin(θ1) = η2·sin(θ2)</p>
          <p>• সংকট কোণ: sin(θc) = η_rare / η_dense</p>
          <p>• লেন্সের ক্ষমতা: P = 1 / f (in meters) Dioptres</p>
        </div>

        <div class="p-4 bg-slate-950 rounded-xl border border-slate-800 space-y-1.5">
          <span class="text-amber-400 font-bold block text-sm">১০ম ও ১১শ অধ্যায়: স্থির ও চল তড়িৎ</span>
          <p>• কুলম্বের বল: F = k (q1·q2) / r²</p>
          <p>• প্রাবল্য ও বিভব: E = kQ/r², V = kQ/r</p>
          <p>• ওহমের সূত্র: V = IR, R = ρ L / A</p>
          <p>• তুল্য রোধ: Rs = Σ R, 1/Rp = Σ (1/R)</p>
          <p>• বিদ্যুৎ শক্তি: kWh = (P·t) / 1000</p>
        </div>

        <div class="p-4 bg-slate-950 rounded-xl border border-slate-800 space-y-1.5">
          <span class="text-amber-400 font-bold block text-sm">১২শ ও ১৩শ অধ্যায়: চুম্বক ও আধুনিক পদার্থবিজ্ঞান</span>
          <p>• ট্রান্সফরমার: Vp / Vs = Np / Ns = Is / Ip</p>
          <p>• ভর-শক্তি রূপান্তর: E = m c²</p>
          <p>• তেজস্ক্রিয় ক্ষয়: N(t) = N0 · (1/2)^(t / T_half)</p>
          <p>• ক্ষয় ধ্রুবক: λ = 0.693 / T_half</p>
        </div>
      </div>
    </div>
  </div>

  <div slot="applications">
    <div class="space-y-3 text-slate-300">
      <h4 class="text-white font-bold text-sm">বোর্ড পরীক্ষার সতর্কবার্তা ও সাধারণ ভুলের সমাধান:</h4>
      <ul class="list-disc list-inside space-y-1.5 text-xs">
        <li><strong>এককের গরমিল:</strong> কিলোমিটার প্রতি ঘণ্টাকে (km/h) অবশ্যই ৩.৬ দিয়ে ভাগ করে মি/সে (m/s) এককে রূপান্তর করে নেবেন। যেমন: 72 km/h = 20 m/s।</li>
        <li><strong>দর্পণের ফোকাস দূরত্ব:</strong> প্রশ্নে যদি উত্তল দর্পণ বা অবতল লেন্স উল্লেখ থাকে, তবে সূত্রে মান বসানোর সময় অবশ্যই ফোকাস দূরত্বের আগে ঋণাত্মক চিহ্ন (-ve) বসাতে হবে।</li>
        <li><strong>বিদ্যুৎ বিল গণনা:</strong> বিদ্যুৎ বিলের অংকে ক্ষমতা অবশ্যই ওয়াট (Watt) এবং সময় ঘণ্টায় (Hours) গুণ করে ১০০০ দিয়ে ভাগ করতে হবে। মাসের দিন সংখ্যা খেয়াল করুন (ফেব্রুয়ারি ২৮/২৯, মে ৩১ দিন)।</li>
        <li><strong>অফলাইন অনুশীলন:</strong> ইন্টারনেট সংযোগ না থাকলে আমাদের পাইথন সিএলআই ক্যালকুলেটর (<code class="text-amber-400">scripts/ssc_physics_calculator.py</code>) আপনার কম্পিউটারে রান করে যেকোনো সমীকরণ সমাধান ও যাচাই করতে পারবেন।</li>
      </ul>
    </div>
  </div>
