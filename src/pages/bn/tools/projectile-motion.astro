---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import { ProjectileCalculator } from '../../../tools/projectile-motion/ProjectileCalculator';
import Latex from '../../../components/math/Latex.astro';

const exemplars = [
  {
    level: 'উচ্চ মাধ্যমিক পদার্থবিজ্ঞান ১ম পত্র (NCTB Class 11)',
    levelBadge: 'নমুনা ১ • আদর্শ প্রাস',
    problemText: 'একটি ক্রিকেট বলকে আনুভূমিকের সাথে ৩০° কোণে ২০ m/s বেগে আঘাত করা হলো। বলটির সর্বোচ্চ উচ্চতা ও অনুভূমিক পাল্লা নির্ণয় কর। [g = 9.8 m/s²]',
    givenData: [
      'আদি বেগ v₀ = 20 m/s',
      'নিক্ষেপণ কোণ θ = 30°',
      'অভিকর্ষজ ত্বরণ g = 9.8 m/s²',
    ],
    solutionSteps: [
      'আদি বেগের উলম্ব উপাংশ: v₀y = v₀ sin(30°) = 20 × 0.5 = 10 m/s',
      'আদি বেগের আনুভূমিক উপাংশ: v₀x = v₀ cos(30°) = 20 × 0.866 = 17.32 m/s',
      'সর্বোচ্চ উচ্চতা: H_max = (v₀y)² / (2g) = (10)² / (2 × 9.8) = 100 / 19.6 = 5.10 m',
      'উড্ডয়নকাল: T = (2 × v₀y) / g = (2 × 10) / 9.8 = 20 / 9.8 = 2.04 s',
      'অনুভূমিক পাল্লা: R = v₀x × T = 17.32 × 2.04 = 35.35 m',
    ],
    finalAnswer: 'সর্বোচ্চ উচ্চতা = ৫.১০ মিটার; অনুভূমিক পাল্লা = ৩৫.৩৫ মিটার',
  },
  {
    level: 'প্রকৌশল বিশ্ববিদ্যালয় ভর্তি পরীক্ষা (BUET / RUET)',
    levelBadge: 'নমুনা ২ • উচ্চতা থেকে প্রক্ষেপক',
    problemText: 'একটি ৪০ মিটার উঁচু পাহাড়ের চূড়া হতে একটি পাথরকে অনুভূমিকের সাথে ৩০° কোণে ২০ m/s বেগে নিক্ষেপ করা হলো। পাথরটির ভূমিতে পতিত হতে কত সময় লাগবে এবং পাহাড়ের পাদদেশ হতে কত দূরে আঘাত করবে? [g = 9.8 m/s²]',
    givenData: [
      'উচ্চতা y₀ = 40 m',
      'v₀ = 20 m/s, θ = 30°',
      'v₀y = 10 m/s, v₀x = 17.32 m/s',
    ],
    solutionSteps: [
      'উলম্ব গতির সমীকরণ: y(t) = y₀ + v₀y·t - 0.5·g·t² = 0',
      '40 + 10t - 4.9t² = 0 ⇒ 4.9t² - 10t - 40 = 0',
      'দ্বিঘাত সূত্রে সমাধান: t = [10 + √(100 + 4 × 4.9 × 40)] / (2 × 4.9)',
      't = [10 + √(100 + 784)] / 9.8 = [10 + √884] / 9.8 = [10 + 29.73] / 9.8 = 4.05 সেকেন্ড',
      'দূরত্ব R = v₀x × t = 17.32 × 4.05 = 70.15 মিটার',
    ],
    finalAnswer: 'পতনের সময় = ৪.০৫ সেকেন্ড; অনুভূমিক দূরত্ব = ৭০.১৫ মিটার',
  },
  {
    level: 'বিগত এইচএসসি বোর্ড প্রশ্ন (রাজশাহী বোর্ড)',
    levelBadge: 'নমুনা ৩ • কোণ পরিবর্তন ও সর্বোচ্চ পাল্লা',
    problemText: 'কোন নিক্ষেপণ কোণে একটি প্রক্ষেপকের অনুভূমিক পাল্লা তার সর্বোচ্চ উচ্চতার ৪ গুণের সমান হবে?',
    givenData: [
      'শর্ত: R = 4 × H_max',
    ],
    solutionSteps: [
      'আমরা জানি, R = (v₀² sin 2θ) / g = (2 v₀² sin θ cos θ) / g',
      'এবং H_max = (v₀² sin² θ) / (2g)',
      'শর্তানুসারে: (2 v₀² sin θ cos θ) / g = 4 × [(v₀² sin² θ) / (2g)]',
      'উভয়পাশ থেকে কাটাকাটি করে পাই: 2 sin θ cos θ = 2 sin² θ',
      'cos θ = sin θ ⇒ tan θ = 1 ⇒ θ = 45°',
    ],
    finalAnswer: 'নিক্ষেপণ কোণ ৪৫° (45°)',
  },
];

const faqs = [
  {
    question: 'প্রাসের গতিপথে আনুভূমিক বেগের কোনো পরিবর্তন হয় না কেন?',
    answer: 'বাতাসের বাধা অগ্রাহ্য করলে আনুভূমিক বরাবর কোনো বল বা ত্বরণ ক্রিয়া করে না (ax = 0)। কেবলমাত্র পৃথিবীর অভিকর্ষ বল উলম্বভাবে নিচের দিকে ক্রিয়াশীল থাকে (ay = -g)। ফলে আনুভূমিক উপাংশ vx = v₀ cos θ সর্বদা স্থির থাকে।',
  },
  {
    question: 'কোন কোণে নিক্ষেপ করলে অনুভূমিক পাল্লা সর্বাধিক হয়?',
    answer: 'আনুভূমিক পাল্লার সমীকরণ R = (v₀² sin 2θ) / g। যখন sin 2θ এর মান সর্বোচ্চ অর্থাৎ ১ হয়, তখন পাল্লা সর্বাধিক হয়। sin 2θ = 1 ⇒ 2θ = 90° ⇒ θ = 45°। সুতরাং ৪৫ ডিগ্রি কোণে নিক্ষেপ করলে সর্বাধিক দূরত্ব অতিক্রম করে।',
  },
  {
    question: 'NCTB ও NCERT পরীক্ষায় g এর মান কত ধরতে হবে?',
    answer: 'বাংলাদেশ NCTB বোর্ড পরীক্ষায় প্রথাগতভাবে g = 9.8 m/s² ব্যবহৃত হয়। তবে ভারতীয় NCERT বা আন্তর্জাতিক পরীক্ষায় অনেক সময় 9.81 m/s² নির্দিষ্ট করে দেওয়া থাকে। আমাদের ক্যালকুলেটরে আপনি একক ক্লিকেই দুটি মানের মধ্যে পরিবর্তন করতে পারবেন।',
  },
];
---

<ToolLayout
  title="প্রাস ও প্রক্ষেপক গতিবিদ্যা (Projectile Motion) ক্যালকুলেটর — Biggan.me"
  metaDescription="সর্বোচ্চ উচ্চতা, বিচরণকাল, অনুভূমিক পাল্লা ও দ্বিমাত্রিক প্যারামেট্রিক গতিপথের ভেক্টর সমাধান। NCTB পদার্থবিজ্ঞান ১ম পত্র ও NCERT সিলেবাসের সমীকরণ প্রতিপাদন ও কাসিও গাইড।"
  toolName="প্রাস ও প্রক্ষেপক গতিবিদ্যা সমাধানকারী"
  toolCategory="পদার্থবিজ্ঞান ও বলবিদ্যা"
  curriculumTags={['NCTB পদার্থবিজ্ঞান ১ম পত্র অধ্যায় ৩ (গতিবিদ্যা)', 'NCERT Class 11 Motion in a Plane', 'BUET & JEE Main']}
  topicId="kinematics"
  exemplars={exemplars}
  faqs={faqs}
>
  <div slot="calculator">
    <ProjectileCalculator client:load lang="bn" />
  </div>

  <div slot="derivation" class="space-y-4">
    <p>
      দ্বিমাত্রিক তলে কোনো বস্তুকে অনুভূমিকের সাথে তির্যকভাবে শূন্যে নিক্ষেপ করলে তাকে <strong>প্রাস বা প্রক্ষেপক (Projectile)</strong> বলা হয়। প্রাসের গতি হলো সমত্বরণে গতিশীল একটি বিশেষ দ্বিমাত্রিক বক্রাকার গতি যার গতিপথ বা ট্র্যাজেক্টরি সর্বদা একটি <strong>পরাবৃত্ত (Parabola)</strong>।
    </p>

    <h3 class="text-base font-bold text-white mt-4">মৌলিক সূত্রাবলী ও প্রতিপাদন</h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 font-mono text-xs text-sky-300">
      <div class="p-3 bg-slate-950 rounded-xl border border-slate-800">
        <span class="text-slate-400 block mb-1">সর্বোচ্চ উচ্চতা (H_max):</span>
        <Latex formula={'H_{\\max} = \\frac{v_0^2 \\sin^2\\theta}{2g}'} displayMode={true} />
      </div>
      <div class="p-3 bg-slate-950 rounded-xl border border-slate-800">
        <span class="text-slate-400 block mb-1">মোট বিচরণকাল (T):</span>
        <Latex formula={'T = \\frac{2v_0 \\sin\\theta}{g}'} displayMode={true} />
      </div>
      <div class="p-3 bg-slate-950 rounded-xl border border-slate-800 sm:col-span-2">
        <span class="text-slate-400 block mb-1">অনুভূমিক পাল্লা (Range R):</span>
        <Latex formula={'R = \\frac{v_0^2 \\sin(2\\theta)}{g}'} displayMode={true} />
      </div>
    </div>
  </div>

  <div slot="applications" class="space-y-3">
    <p>
      ১. <strong>খেলাধুলা ও বলবিদ্যা:</strong> ক্রিকেট খেলায় ছক্কার দূরত্ব, ফুটবলের ফ্রি-কিক এবং জ্যাভলিন বা বর্শা নিক্ষেপে ক্রীড়াবিদদের সর্বোত্তম কোণ (প্রায় ৪২°-৪৫°) অর্জনে বায়োমেকানিক্সে প্রাসের সূত্র প্রযোজ্য।
    </p>
    <p>
      ২. <strong>প্রতিরক্ষা ও ব্যালিস্টিক বিজ্ঞান:</strong> কামান ও আর্টিলারি গোলার লক্ষ্যবস্তুতে নির্ভুল আঘাত নিশ্চিত করতে পৃথিবীর ঘূর্ণন (কোরিওলিস বল) ও অভিকর্ষ বল সমন্বয় করে প্রাসের ট্র্যাজেক্টরি হিসাব করা হয়।
    </p>
  </div>
</ToolLayout>
