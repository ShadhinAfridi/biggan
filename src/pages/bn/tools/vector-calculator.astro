---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import { VectorCalculator } from '../../../tools/vector/VectorCalculator';
import Latex from '../../../components/math/Latex.astro';

const exemplars = [
  {
    level: 'উচ্চ মাধ্যমিক পদার্থবিজ্ঞান ১ম পত্র (NCTB Class 11)',
    levelBadge: 'নমুনা ১ • লম্ব ভেক্টর যাচাই',
    problemText: 'A = 2i + 3j - k এবং B = 3i - 2j + m k হলে m-এর মান কত হলে ভেক্টরদ্বয় পরস্পর লম্ব হবে?',
    givenData: [
      'ভেক্টর A = 2î + 3ĵ - k̂',
      'ভেক্টর B = 3î - 2ĵ + m k̂',
      'শর্ত: A ⊥ B ⇒ A · B = 0',
    ],
    solutionSteps: [
      'ডট গুণনের সূত্র: A · B = Ax·Bx + Ay·By + Az·Bz',
      'মান বসিয়ে পাই: (2)(3) + (3)(-2) + (-1)(m) = 0',
      '6 - 6 - m = 0',
      '-m = 0 ⇒ m = 0',
    ],
    finalAnswer: 'm-এর নির্ণেয় মান = ০ (m = 0)',
  },
  {
    level: 'প্রকৌশল ভর্তি পরীক্ষা (BUET / RUET / CKPoET)',
    levelBadge: 'নমুনা ২ • ক্রস গুণন ও সামান্তরিকের ক্ষেত্রফল',
    problemText: 'A = i + 2j + 3k এবং B = 3i - 2j + k দ্বারা গঠিত সামান্তরিকের ক্ষেত্রফল নির্ণয় কর।',
    givenData: [
      'সন্নিহিত বাহু A = î + 2ĵ + 3k̂',
      'সন্নিহিত বাহু B = 3î - 2ĵ + k̂',
    ],
    solutionSteps: [
      'ক্রস গুণন A × B = |î  ĵ  k̂; 1  2  3; 3 -2  1|',
      '= î(2×1 - 3×(-2)) - ĵ(1×1 - 3×3) + k̂(1×(-2) - 2×3)',
      '= î(2 + 6) - ĵ(1 - 9) + k̂(-2 - 6)',
      '= 8î + 8ĵ - 8k̂',
      'মান |A × B| = √(8² + 8² + (-8)²) = √(64 + 64 + 64) = √192 = 8√3 ≈ 13.856',
    ],
    finalAnswer: 'সামান্তরিকের ক্ষেত্রফল = ৮√৩ বর্গ একক (১৩.৮৫৬ বর্গ একক)',
  },
  {
    level: 'এইচএসসি বোর্ড পরীক্ষা (ঢাকা বোর্ড)',
    levelBadge: 'নমুনা ৩ • ভেক্টরদ্বয়ের মধ্যবর্তী কোণ',
    problemText: 'A = 2i + 2j - k এবং B = 6i - 3j + 2k ভেক্টরদ্বয়ের মধ্যবর্তী কোণ নির্ণয় কর।',
    givenData: [
      'A = 2î + 2ĵ - k̂',
      'B = 6î - 3ĵ + 2k̂',
    ],
    solutionSteps: [
      'ডট গুণন A · B = (2)(6) + (2)(-3) + (-1)(2) = 12 - 6 - 2 = 4',
      '|A| = √(2² + 2² + (-1)²) = √(4 + 4 + 1) = √9 = 3',
      '|B| = √(6² + (-3)² + 2²) = √(36 + 9 + 4) = √49 = 7',
      'cos θ = (A · B) / (|A| |B|) = 4 / (3 × 7) = 4 / 21 ≈ 0.1905',
      'θ = cos⁻¹(0.1905) ≈ 78.96°',
    ],
    finalAnswer: 'মধ্যবর্তী কোণ θ ≈ ৭৮.৯৬°',
  },
];

const faqs = [
  {
    question: 'দুটি ভেক্টর কখন পরস্পর লম্ব (Orthogonal) হয়?',
    answer: 'দুটি অশূন্য ভেক্টর A এবং B-এর মধ্যবর্তী কোণ ৯০° হলে তাদের স্কেলার বা ডট গুণন শূন্য হয় (A · B = |A||B| cos 90° = 0)। তাই A · B = AxBx + AyBy + AzBz = 0 হলে ভেক্টরদ্বয় পরস্পর লম্ব।',
  },
  {
    question: 'দুটি ভেক্টর সমান্তরাল হওয়ার শর্ত কী?',
    answer: 'দুটি ভেক্টর সমান্তরাল হলে তাদের মধ্যবর্তী কোণ ০° বা ১৮০° হয়, ফলে তাদের ভেক্টর বা ক্রস গুণন শূন্য ভেক্টর হয় (A × B = 0)। এছাড়া এদের অনুরূপ উপাংশসমূহের অনুপাত সমান হয়: Ax/Bx = Ay/By = Az/Bz।',
  },
  {
    question: 'সামান্তরিক ও ত্রিভুজের ক্ষেত্রফল নির্ণয়ে ক্রস গুণন কীভাবে ব্যবহৃত হয়?',
    answer: 'দুটি ভেক্টর A ও B কোনো সামান্তরিকের দুটি সন্নিহিত বাহু নির্দেশ করলে সামান্তরিকের ক্ষেত্রফল = |A × B|। যদি তারা কোনো ত্রিভুজের সন্নিহিত বাহু নির্দেশ করে, তবে ত্রিভুজটির ক্ষেত্রফল = ½ |A × B|।',
  },
];
---

<ToolLayout
  title="ভেক্টর ক্যালকুলেটর (Vector Math & 3D Solver) — Biggan.me"
  metaDescription="অনলাইনে ২ডি ও ৩ডি ভেক্টর ডট গুণন, ক্রস গুণন, মধ্যবর্তী কোণ, একক ভেক্টর, লম্ব/সমান্তরাল যাচাই ও সামান্তরিক ক্ষেত্রফল নির্ণয়। NCTB ও ভর্তি পরীক্ষার সমাধান।"
  toolName="ভেক্টর ক্যালকুলেটর ও ৩ডি বিশ্লেষক"
  toolCategory="পদার্থবিজ্ঞান ও উচ্চতর গণিত"
  curriculumTags={['NCTB পদার্থবিজ্ঞান ১ম পত্র অধ্যায় ২ (ভেক্টর)', 'উচ্চতর গণিত ১ম পত্র অধ্যায় ২', 'BUET & Engineering Admission']}
  topicId="vectors"
  exemplars={exemplars}
  faqs={faqs}
>
  <div slot="calculator">
    <VectorCalculator client:load lang="bn" />
  </div>

  <div slot="theory" class="space-y-4">
    <h3 class="text-lg font-bold text-white flex items-center gap-2">
      <span>📐</span> ভেক্টর বীজগণিতের মৌলিক সূত্রাবলী
    </h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
      <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2">
        <h4 class="font-semibold text-cyan-400">স্কেলার বা ডট গুণন (Dot Product):</h4>
        <p class="text-slate-300 text-xs">
          <Latex math="\vec{A} \cdot \vec{B} = |\vec{A}||\vec{B}|\cos\theta = A_x B_x + A_y B_y + A_z B_z" />
        </p>
        <p class="text-slate-400 text-xs">দুটি ভেক্টর পরস্পর লম্ব হওয়ার শর্ত: <Latex math="\vec{A} \cdot \vec{B} = 0" /></p>
      </div>

      <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2">
        <h4 class="font-semibold text-purple-400">ভেক্টর বা ক্রস গুণন (Cross Product):</h4>
        <p class="text-slate-300 text-xs">
          <Latex math="\vec{A} \times \vec{B} = \begin{vmatrix} \hat{i} & \hat{j} & \hat{k} \\ A_x & A_y & A_z \\ B_x & B_y & B_z \end{vmatrix}" />
        </p>
        <p class="text-slate-400 text-xs">দুটি ভেক্টর সমান্তরাল হওয়ার শর্ত: <Latex math="\vec{A} \times \vec{B} = \vec{0}" /></p>
      </div>
    </div>
  </div>
</ToolLayout>
