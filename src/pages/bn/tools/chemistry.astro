---
import ToolLayout, { type SolvedExemplar, type ToolFaqItem } from '../../../layouts/ToolLayout.astro';
import { ChemistryCalculator } from '../../../tools/chemistry/ChemistryCalculator';

const exemplars: SolvedExemplar[] = [
  {
    level: 'বোর্ড পরীক্ষা স্পেশাল (CQ গ — মোলের ধারণা ও মোলারিটি)',
    levelBadge: 'bg-teal-500/10 text-teal-400 border border-teal-500/20',
    problemText: '২৫০ মিলিলিটার (250 mL) জলীয় দ্রবণে ১০.৬ গ্রাম সোডিয়াম কার্বনেট (Na₂CO₃) দ্রবীভূত থাকলে দ্রবণের মোলারিটি কত? দ্রবণটিকে সেমিমোলার (0.5 M) দ্রবণে পরিণত করতে অতিরিক্ত কত গ্রাম Na₂CO₃ যোগ করতে হবে?',
    givenData: [
      'দ্রবণের আয়তন V = 250 mL',
      'দ্রবীভূত দ্রবের ভর W = 10.6 g',
      'Na₂CO₃ এর আণবিক ভর M = (2 × 23) + 12 + (3 × 16) = 106 g/mol',
      'কাঙ্ক্ষিত মাত্রা S₂ = 0.5 M (সেমিমোলার)',
    ],
    solutionSteps: [
      '১ম অংশ: মোলারিটির সূত্র প্রয়োগ: S = (1000 × W) / (V × M)',
      'S = (1000 × 10.6) / (250 × 106) = 10600 / 26500 = 0.4 mol/L (M) [এটি একটি ডেসিমোলার দ্রবণ]।',
      '২য় অংশ: 0.5 M দ্রবণের জন্য মোট প্রয়োজনীয় ভর: W₂ = (S₂ × V × M) / 1000',
      'W₂ = (0.5 × 250 × 106) / 1000 = 13250 / 1000 = 13.25 g',
      'অতিরিক্ত দ্রবের পরিমাণ = W₂ - W = 13.25 - 10.6 = 2.65 গ্রাম।',
    ],
    finalAnswer: 'দ্রবণের প্রাথমিক মোলারিটি ০.৪ M এবং সেমিমোলার করতে অতিরিক্ত ২.৬৫ গ্রাম Na₂CO₃ যোগ করতে হবে।',
  },
  {
    level: 'বোর্ড পরীক্ষা স্পেশাল (CQ গ/ঘ — সীমিত বিক্রিয়ক ও উৎপাদের ভর)',
    levelBadge: 'bg-amber-500/10 text-amber-400 border border-amber-500/20',
    problemText: 'একটি বদ্ধ পাত্রে ৫ গ্রাম হাইড্রোজেন গ্যাসের সাথে ৩৫ গ্রাম অক্সিজেন গ্যাস মিশ্রিত করে পানি প্রস্তুত করা হলো। বিক্রিয়াটিতে কোন বিক্রিয়কটি লিমিটিং বিক্রিয়ক এবং সর্বোচ্চ কত গ্রাম পানি (H₂O) উৎপন্ন হবে?',
    givenData: [
      'বিক্রিয়া সমীকরণ: 2H₂ + O₂ ⟶ 2H₂O',
      'সরবরাহকৃত H₂ এর ভর = 5 g, আণবিক ভর M(H₂) = 2.016 g/mol',
      'সরবরাহকৃত O₂ এর ভর = 35 g, আণবিক ভর M(O₂) = 32.00 g/mol',
    ],
    solutionSteps: [
      '১ম ধাপ: মোল সংখ্যা নির্ণয়:',
      'n(H₂) = 5 / 2.016 = 2.480 mol',
      'n(O₂) = 35 / 32.00 = 1.0938 mol',
      '২য় ধাপ: স্টয়কিওমেট্রিক অনুপাত তুলনা (2 mol H₂ : 1 mol O₂):',
      '1.0938 mol O₂ এর সাথে সম্পূর্ণ বিক্রিয়া করতে H₂ প্রয়োজন = 1.0938 × 2 = 2.1876 mol।',
      'যেহেতু পাত্রে 2.480 mol H₂ বিদ্যমান (প্রয়োজনের চেয়ে বেশি), তাই H₂ অতিরিক্ত থাকবে এবং O₂ সম্পূর্ণরূপে নিঃশেষিত হবে। অতএব O₂ হলো লিমিটিং বিক্রিয়ক।',
      '৩য় ধাপ: উৎপাদ পানির ভর গণনা:',
      'বিক্রিয়া অনুযায়ী 1 mol O₂ হতে উৎপন্ন হয় 2 mol H₂O।',
      'উৎপন্ন H₂O এর মোল = 1.0938 × 2 = 2.1876 mol',
      'উৎপন্ন H₂O এর ভর = 2.1876 mol × 18.015 g/mol = 39.41 গ্রাম।',
      'অবশিষ্ট হাইড্রোজেন = (2.480 - 2.1876) × 2.016 = 0.59 গ্রাম।',
    ],
    finalAnswer: 'অক্সিজেন (O₂) হলো সীমিত বিক্রিয়ক এবং সর্বোচ্চ ৩৯.৪১ গ্রাম পানি উৎপন্ন হবে (০.৫৯ গ্রাম H₂ অবশিষ্ট থাকবে)।',
  },
  {
    level: 'বোর্ড পরীক্ষা স্পেশাল (CQ গ — বন্ধন শক্তি হতে বিক্রিয়া তাপ ΔH)',
    levelBadge: 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20',
    problemText: 'মিথেন গ্যাসের ক্লোরিনেশন বিক্রিয়া: CH₄ + Cl₂ ⟶ CH₃Cl + HCl। এনসিটিবি পাঠ্যবইয়ের বন্ধন শক্তি মান ব্যবহার করে বিক্রিয়াটির এনথ্যালপি পরিবর্তন (ΔH) নির্ণয় কর। (C-H = 414, Cl-Cl = 244, C-Cl = 326, H-Cl = 431 kJ/mol)',
    givenData: [
      'ভাঙা বন্ধনসমূহ: ১টি C-H বন্ধন এবং ১টি Cl-Cl বন্ধন (অথবা ৪টি C-H ও ১টি Cl-Cl)',
      'গঠিত বন্ধনসমূহ: ১টি C-Cl বন্ধন এবং ১টি H-Cl বন্ধন (অথবা ৩টি C-H, ১টি C-Cl ও ১টি H-Cl)',
      'বন্ধন শক্তি: B(C-H)=414, B(Cl-Cl)=244, B(C-Cl)=326, B(H-Cl)=431 kJ/mol',
    ],
    solutionSteps: [
      '১ম ধাপ: বিক্রিয়কের বন্ধন ভাঙতে প্রয়োজনীয় মোট শক্তি (B₁):',
      'B₁ = [1 × B(C-H)] + [1 × B(Cl-Cl)] = 414 + 244 = 658 kJ/mol',
      '২য় ধাপ: উৎপাদের নতুন বন্ধন গঠনে নির্গত মোট শক্তি (B₂):',
      'B₂ = [1 × B(C-Cl)] + [1 × B(H-Cl)] = 326 + 431 = 757 kJ/mol',
      '৩য় ধাপ: বিক্রিয়া তাপ গণনা (ΔH = B₁ - B₂):',
      'ΔH = 658 - 757 = -99 kJ/mol',
      'যেহেতু ΔH এর মান ঋণাত্মক (-ve), বিক্রিয়াটি তাপোৎপাদী (Exothermic)।',
    ],
    finalAnswer: 'বিক্রিয়া তাপ ΔH = -99 kJ/mol। এটি একটি তাপোৎপাদী বিক্রিয়া।',
  },
  {
    level: 'বোর্ড পরীক্ষা স্পেশাল (CQ গ — শতকরা সংযুতি হতে স্থূল ও আণবিক সংকেত)',
    levelBadge: 'bg-purple-500/10 text-purple-400 border border-purple-500/20',
    problemText: 'একটি জৈব যৌগে কার্বন (C) ৪০% এবং হাইড্রোজেন (H) ৬.৬৭% রয়েছে। অবশিষ্ট মৌলটি অক্সিজেন। যৌগটির বাষ্প ঘনত্ব ৩০ হলে এর স্থূল সংকেত ও আণবিক সংকেত নির্ণয় কর।',
    givenData: [
      '%C = 40%, %H = 6.67%',
      '%O = 100 - (40 + 6.67) = 53.33%',
      'বাষ্প ঘনত্ব (D) = 30',
      'পারমাণবিক ভর: C = 12, H = 1, O = 16',
    ],
    solutionSteps: [
      '১ম ধাপ: শতকরা সংযুতিকে নিজ নিজ পারমাণবিক ভর দ্বারা ভাগ:',
      'C = 40 / 12 = 3.333',
      'H = 6.67 / 1 = 6.670',
      'O = 53.33 / 16 = 3.333',
      '২য় ধাপ: প্রাপ্ত ভাগফলগুলোর মধ্যে ক্ষুদ্রতম সংখ্যা (3.333) দ্বারা ভাগ:',
      'C = 3.333 / 3.333 = 1',
      'H = 6.670 / 3.333 ≈ 2',
      'O = 3.333 / 3.333 = 1',
      'অতএব যৌগটির স্থূল সংকেত: CH₂O',
      '৩য় ধাপ: স্থূল সংকেতের ভর = 12 + (2 × 1) + 16 = 30 g/mol',
      '৪র্থ ধাপ: যৌগের আণবিক ভর M = 2 × বাষ্প ঘনত্ব = 2 × 30 = 60 g/mol',
      'গুণক n = আণবিক ভর / স্থূল সংকেতের ভর = 60 / 30 = 2',
      'আণবিক সংকেত = (CH₂O)₂ = C₂H₄O₂ (ইথানয়িক অ্যাসিড বা অ্যাসিটিক অ্যাসিড)।',
    ],
    finalAnswer: 'যৌগটির স্থূল সংকেত CH₂O এবং আণবিক সংকেত C₂H₄O₂।',
  },
];

const faqs: ToolFaqItem[] = [
  {
    question: 'এনসিটিবি পাঠ্যবই অনুযায়ী প্রমাণ তাপমাত্রা ও চাপে (STP) গ্যাসের মোলার আয়তন কত?',
    answer: 'বাংলাদেশ জাতীয় শিক্ষাক্রম ও পাঠ্যপুস্তক বোর্ড (NCTB) অনুমোদিত ৯ম-১০ম শ্রেণির রসায়ন পাঠ্যবই অনুযায়ী প্রমাণ অবস্থা বা STP (0°C বা 273 K এবং 1 atm চাপ)-তে যেকোনো আদর্শ গ্যাসের ১ মোলের আয়তন ২২.৪ লিটার (22.4 L বা 22.4 dm³)। আমাদের ক্যালকুলেটরে মোলের চারমুখী রূপান্তর এই সূত্রের ওপর প্রতিষ্ঠিত।',
  },
  {
    question: 'মোলারিটি নির্ণয়ের সূত্রে আয়তন মিলিলিটারে থাকলে হিসাব কীভাবে করব?',
    answer: 'যদি দ্রবণের আয়তন মিলিলিটার (mL বা cm³) এককে দেওয়া থাকে, তবে প্রমাণ সূত্র হলো: W = (S × V × M) / 1000, যেখানে W = দ্রবের ভর (গ্রামে), S = মোলারিটি (mol/L), V = আয়তন (mL-এ), এবং M = মোলার ভর (g/mol)। দ্রবণ লঘুকরণের ক্ষেত্রে V₁S₁ = V₂S₂ সূত্র প্রযোজ্য।',
  },
  {
    question: 'বন্ধন শক্তি দিয়ে হিসাব করার সময় ΔH ঋণাত্মক ও ধনাত্মক হওয়ার তাৎপর্য কী?',
    answer: 'বিক্রিয়া তাপ ΔH = (বিক্রিয়কের বন্ধন ভাঙতে মোট শক্তি) - (উৎপাদের বন্ধন গড়তে মোট শক্তি)। যদি ΔH এর মান ঋণাত্মক (-ve) আসে, তবে বিক্রিয়াটি তাপোৎপাদী (Exothermic), অর্থাৎ পরিবেশে তাপ নির্গত হয়। যদি ΔH ধনাত্মক (+ve) আসে, তবে বিক্রিয়াটি তাপহারী (Endothermic), অর্থাৎ বাইরে থেকে তাপ শোষণ করে।',
  },
  {
    question: 'কাসিও সায়েন্টিফিক ক্যালকুলেটরে মোলার ভর ও আণবিক সূত্র দ্রুত যাচাই করার উপায় কী?',
    answer: 'কাসিও fx-991EX বা fx-991CW ক্যালকুলেটরে স্টয়কিওমেট্রিক অনুপাত ও ডেসিমেল থেকে ভগ্নাংশ রূপান্তর (S<=>D কি) অত্যন্ত দ্রুত করা যায়। এছাড়া জটিল যৌগের ভর বের করতে বন্ধনী (parentheses) দিয়ে এক লাইনে সম্পূর্ণ সমীকরণ টাইপ করা যায়। নিচে বিস্তারিত কীস্ট্রোক গাইড সংযুক্ত রয়েছে।',
  },
];
---

<ToolLayout
  title="এসএসসি রসায়ন সম্পূর্ণ সমাধান ও সমীকরণ ইঞ্জিন — Biggan.me"
  metaDescription="NCTB এসএসসি রসায়ন ৯ম-১০ম শ্রেণির সম্পূর্ণ গাণিতিক সমীকরণ ক্যালকুলেটর। গ্রাহামের ব্যাপন সূত্র, বোর পরমাণু মডেল, মোল ও মোলারিটি, শতকরা সংযুতি, লিমিটিং বিক্রিয়ক, জারণ সংখ্যা, বন্ধন শক্তি ΔH, pH ও টাইট্রেশন।"
  toolName="এসএসসি রসায়ন সমাধান ও সমীকরণ ইঞ্জিন"
  toolCategory="রসায়ন (SSC Chemistry)"
  curriculumTags={['NCTB এসএসসি রসায়ন (৯ম-১০ম)', 'মোল ও মোলারিটি (W = SVM/1000)', 'বিক্রিয়া তাপ ও বন্ধন শক্তি (ΔH)', 'জারণ সংখ্যা ও টাইট্রেশন']}
  topicId="chemistry-general"
  exemplars={exemplars}
  faqs={faqs}
>
  <div slot="calculator">
    <ChemistryCalculator client:visible lang="bn" />
  </div>

  <div slot="derivation">
    <div class="space-y-4 text-slate-300">
      <h3 class="text-base font-bold text-white">এনসিটিবি এসএসসি রসায়ন পাঠ্যক্রমের পরিমাণগত অধ্যায়সমূহের মূল সূত্রের চার্ট</h3>
      <p class="text-sm">
        এসএসসি রসায়ন পরীক্ষায় পূর্ণ নম্বর অর্জন করতে হলে ২য়, ৩য়, ৬ষ্ঠ, ৭ম, ৮ম, ৯ম ও ১১শ অধ্যায়ের গাণিতিক সূত্রগুলোর উপর গভীর দখল থাকা আবশ্যক। নিচে প্রতিটি অধ্যায়ের প্রমিত সমীকরণ সংকলন করা হলো:
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 font-mono text-xs text-slate-300">
        <div class="p-4 bg-slate-950 rounded-xl border border-slate-800 space-y-1.5">
          <span class="text-teal-400 font-bold block text-sm">২য় অধ্যায়: পদার্থের অবস্থা (গ্রাহামের ব্যাপন সূত্র)</span>
          <p>• ব্যাপন হার ও আণবিক ভর: r₁ / r₂ = √(M₂ / M₁)</p>
          <p>• ব্যাপন সময় ও আণবিক ভর: t₁ / t₂ = √(M₁ / M₂)</p>
          <p>• ভারী গ্যাসের ব্যাপন হার হালকা গ্যাসের চেয়ে কম (r ∝ 1/√M)</p>
        </div>

        <div class="p-4 bg-slate-950 rounded-xl border border-slate-800 space-y-1.5">
          <span class="text-teal-400 font-bold block text-sm">৩য় অধ্যায়: পদার্থের গঠন (পরমাণুর মডেল ও আইসোটোপ)</span>
          <p>• আপেক্ষিক পারমাণবিক ভর: A_avg = Σ (A_i × p_i) / 100</p>
          <p>• বোর কৌণিক ভরবেগ: mvr = (n × h) / (2π)</p>
          <p>• প্লাঙ্কের ধ্রুবক: h = 6.626 × 10⁻³⁴ J·s</p>
          <p>• কক্ষপথে ইলেকট্রন ধারণক্ষমতা: 2n² (উপশক্তিস্তরে: s=2, p=6, d=10, f=14)</p>
        </div>

        <div class="p-4 bg-slate-950 rounded-xl border border-slate-800 space-y-1.5">
          <span class="text-teal-400 font-bold block text-sm">৬ষ্ঠ অধ্যায়: মোলের ধারণা ও রাসায়নিক গণনা (মোল ও মোলারিটি)</span>
          <p>• সমন্বিত মোল সূত্র: n = W / M = V / 22.4 = N / (6.023 × 10²³)</p>
          <p>• দ্রবণের মোলারিটি: W = (S × V × M) / 1000</p>
          <p>• শতকরা সংযুতি: %Element = (n × Ar / Mr) × 100%</p>
          <p>• দ্রবণ লঘুকরণ সূত্র: V₁S₁ = V₂S₂</p>
        </div>

        <div class="p-4 bg-slate-950 rounded-xl border border-slate-800 space-y-1.5">
          <span class="text-teal-400 font-bold block text-sm">৬ষ্ঠ অধ্যায়: স্থূল ও আণবিক সংকেত এবং লিমিটিং বিক্রিয়ক</span>
          <p>• পরমাণুর অনুপাত: atom_ratio = %mass / Ar</p>
          <p>• আণবিক সংকেত: (স্থূল সংকেত)_n, যেখানে n = আণবিক ভর / স্থূল সংকেতের ভর</p>
          <p>• বাষ্প ঘনত্ব সম্পর্ক: আণবিক ভর = 2 × বাষ্প ঘনত্ব (M = 2D)</p>
          <p>• লিমিটিং বিক্রিয়ক: সর্বনিম্ন n / stoichiometric_coefficient</p>
        </div>

        <div class="p-4 bg-slate-950 rounded-xl border border-slate-800 space-y-1.5">
          <span class="text-teal-400 font-bold block text-sm">৭ম অধ্যায়: রাসায়নিক বিক্রিয়া (জারণ সংখ্যা ও রেডক্স)</span>
          <p>• নিরপেক্ষ যৌগে মোট জারণ সংখ্যা = 0 (Σ Oxidation Number = 0)</p>
          <p>• পলিঅ্যাটমিক আয়নে মোট জারণ সংখ্যা = আয়নের চার্জ</p>
          <p>• জারণ = ইলেকট্রন বর্জন (LeO - Lose electrons Oxidation)</p>
          <p>• বিজারণ = ইলেকট্রন গ্রহণ (GeR - Gain electrons Reduction)</p>
        </div>

        <div class="p-4 bg-slate-950 rounded-xl border border-slate-800 space-y-1.5">
          <span class="text-teal-400 font-bold block text-sm">৮ম অধ্যায়: রসায়ন ও শক্তি (বিক্রিয়া তাপ ও বন্ধন শক্তি)</span>
          <p>• বিক্রিয়া তাপ: ΔH = Σ B_broken - Σ B_formed</p>
          <p>• ΔH < 0 হলে বিক্রিয়াটি তাপোৎপাদী (Exothermic)</p>
          <p>• ΔH > 0 হলে বিক্রিয়াটি তাপহারী (Endothermic)</p>
          <p>• মূল বন্ধন শক্তি (kJ/mol): C-H: 414, Cl-Cl: 244, C-Cl: 326, H-Cl: 431, O=O: 498, O-H: 464</p>
        </div>

        <div class="p-4 bg-slate-950 rounded-xl border border-slate-800 space-y-1.5">
          <span class="text-teal-400 font-bold block text-sm">৯ম অধ্যায়: অ্যাসিড-ক্ষার সমতা (pH ও টাইট্রেশন)</span>
          <p>• হাইড্রোজেন আয়ন সূচক: pH = -log₁₀[H⁺]</p>
          <p>• হাইড্রোক্সাইড আয়ন সূচক: pOH = -log₁₀[OH⁻]</p>
          <p>• ২৫°C তাপমাত্রায় পানির আয়ন গুণফল: pH + pOH = 14</p>
          <p>• টাইট্রেশন সমীকরণ: (V_A × S_A) / a = (V_B × S_B) / b</p>
        </div>

        <div class="p-4 bg-slate-950 rounded-xl border border-slate-800 space-y-1.5">
          <span class="text-teal-400 font-bold block text-sm">১১শ অধ্যায়: খনিজ সম্পদ — জীবাশ্ম (হাইড্রোকার্বন সমগোত্রীয় শ্রেণি)</span>
          <p>• অ্যালকেন (Alkane): C_n H_(2n+2) (সম্পৃক্ত প্যারাফিন)</p>
          <p>• অ্যালকিন (Alkene): C_n H_(2n) (দ্বিবন্ধনযুক্ত ওলেফিন)</p>
          <p>• অ্যালকাইন (Alkyne): C_n H_(2n-2) (ত্রিবন্ধনযুক্ত অ্যাসিটিলিন)</p>
          <p>• মিথেন (CH₄), ইথেন (C₂H₆), প্রোপেন (C₃H₈), বিউটেন (C₄H₁₀)</p>
        </div>
      </div>
    </div>
  </div>

  <div slot="applications">
    <div class="space-y-3 text-slate-300">
      <h4 class="text-white font-bold text-sm">বোর্ড পরীক্ষার সতর্কবার্তা ও রসায়নে পূর্ণ নম্বর পাওয়ার কৌশল:</h4>
      <ul class="list-disc list-inside space-y-1.5 text-xs">
        <li><strong>মোলার আয়তনের একক:</strong> STP-তে ২২.৪ লিটার হিসাব করার সময় খেয়াল রাখুন প্রশ্নে আয়তন লিটার নাকি মিলিলিটারে দেওয়া। ১ লিটার = ১০০০ মিলিলিটার = ১ dm³।</li>
        <li><strong>কেলাস পানি যুক্ত যৌগ:</strong> কপার সালফেট পেন্টাহাইড্রেট (CuSO₄·5H₂O) এর আণবিক ভর হিসাব করার সময় ৫ অণু পানির ভর (৫ × ১৮.০১৫ = ৯০.০৭৫ g/mol) অবশ্যই মোট ভরের সাথে যোগ করতে হবে।</li>
        <li><strong>সীমিত বিক্রিয়ক নির্ণয়:</strong> শুধুমাত্র প্রদত্ত ভর দেখে কখনো সীমিত বিক্রিয়ক নির্ধারণ করবেন না। প্রথমে উভয় বিক্রিয়কের মোল সংখ্যা বের করে সমতাকৃত বিক্রিয়া সমীকরণের সহগ অনুপাত দিয়ে ভাগ করে তুলনা করতে হবে।</li>
        <li><strong>বন্ধন শক্তির সমীকরণ:</strong> গাঠনিক সংকেত এঁকে বন্ধনের সংখ্যা সঠিকভাবে গণনা করুন। যেমন— O₂ অণুতে ১টি O=O দ্বিবন্ধন থাকে (৪৯৮ kJ/mol), CO₂ অণুতে ২টি C=O দ্বিবন্ধন থাকে।</li>
        <li><strong>অফলাইন অনুশীলন:</strong> ইন্টারনেট ছাড়া পড়ার জন্য আমাদের পাইথন সিএলআই ক্যালকুলেটর (<code class="text-teal-400">scripts/ssc_chemistry_calculator.py</code>) ব্যবহার করে রাসায়নিক হিসাবগুলো দ্রুত রিভিশন দিতে পারেন।</li>
      </ul>
    </div>
  </div>
