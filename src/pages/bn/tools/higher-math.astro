---
import ToolLayout, { type SolvedExemplar, type ToolFaqItem } from '../../../layouts/ToolLayout.astro';
import { HigherMathCalculator } from '../../../tools/higher-math/HigherMathCalculator';

const exemplars: SolvedExemplar[] = [
  {
    level: 'বোর্ড পরীক্ষা স্পেশাল (CQ গ — ৩য় অধ্যায়: জ্যামিতি)',
    levelBadge: 'bg-indigo-500/10 text-indigo-400 border border-indigo-500/20',
    problemText: 'ΔABC এর তিন বাহু a = 6 সেমি, b = 5 সেমি এবং c = 7 সেমি। BC বাহুর মধ্যমা AD এর দৈর্ঘ্য নির্ণয় করো এবং দেখাও যে, 3(a² + b² + c²) = 4(da² + db² + dc²)।',
    givenData: [
      'ত্রিভুজের বাহুত্রয়: a = 6 সেমি, b = 5 সেমি, c = 7 সেমি',
      'a বাহুর উপর মধ্যমা da = AD',
    ],
    solutionSteps: [
      'এ্যাপোলোনিয়াসের উপপাদ্য অনুযায়ী: b² + c² = 2[da² + (a/2)²]',
      'মান বসিয়ে পাই: 5² + 7² = 2[da² + (6/2)²] ⇒ 25 + 49 = 2[da² + 9]',
      '74 = 2(da² + 9) ⇒ da² + 9 = 37 ⇒ da² = 28 ⇒ da = √28 ≈ 5.292 সেমি।',
      'একইভাবে db² = (2a² + 2c² - b²)/4 = (72 + 98 - 25)/4 = 36.25 এবং dc² = (2a² + 2b² - c²)/4 = (72 + 50 - 49)/4 = 18.25।',
      'বামপক্ষ = 3(a² + b² + c²) = 3(36 + 25 + 49) = 3(110) = 330।',
      'ডানপক্ষ = 4(da² + db² + dc²) = 4(28 + 36.25 + 18.25) = 4(82.5) = 330। (প্রমাণিত)',
    ],
    finalAnswer: 'মধ্যমা da = 5.292 সেমি এবং 3Σa² = 4Σd² = 330 (প্রমাণিত)।',
  },
  {
    level: 'বোর্ড পরীক্ষা স্পেশাল (CQ খ — ৭ম অধ্যায়: অসীম ধারা)',
    levelBadge: 'bg-cyan-500/10 text-cyan-400 border border-cyan-500/20',
    problemText: '0.12̇ কে অসীম গুণোত্তর ধারার সূত্রের সাহায্যে মূলদ সাধারণ ভগ্নাংশে প্রকাশ করো।',
    givenData: ['পৌনঃপুনিক সংখ্যা: 0.12̇ = 0.1222...'],
    solutionSteps: [
      'সংখ্যাটিকে সম্প্রসারিত করি: 0.12̇ = 0.1 + 0.02 + 0.002 + 0.0002 + ...',
      'অনাবৃত্ত অংশ: 0.1 = 1/10।',
      'আবৃত্ত অংশ একটি অসীম গুণোত্তর ধারা: a = 0.02 = 2/100, r = 0.1 = 1/10 (|r| < 1)।',
      'অসীমতক সমষ্টি: S∞ = a / (1 - r) = (2/100) / (1 - 1/10) = (2/100) / (9/10) = 2/90 = 1/45।',
      'মোট ভগ্নাংশ = 1/10 + 1/45 = (9 + 2)/90 = 11/90।',
    ],
    finalAnswer: 'সাধারণ ভগ্নাংশ = 11/90।',
  },
  {
    level: 'বোর্ড পরীক্ষা স্পেশাল (CQ গ — ১১শ অধ্যায়: স্থানাঙ্ক জ্যামিতি)',
    levelBadge: 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20',
    problemText: 'A(2, 3), B(5, 7) এবং C(-2, 4) শীর্ষবিন্দুবিশিষ্ট ত্রিভুজের ক্ষেত্রফল Shoelace সূত্রের সাহায্যে নির্ণয় করো।',
    givenData: ['শীর্ষবিন্দুত্রয়: A(2, 3), B(5, 7), C(-2, 4) ঘড়ির কাঁটার বিপরীতক্রমে'],
    solutionSteps: [
      'Shoelace ক্ষেত্রফল সূত্র: Δ = 1/2 |(x1·y2 + x2·y3 + x3·y1) - (y1·x2 + y2·x3 + y3·x1)|',
      'ধাপ ১: (2×7 + 5×4 + (-2)×3) = (14 + 20 - 6) = 28।',
      'ধাপ ২: (3×5 + 7×(-2) + 4×2) = (15 - 14 + 8) = 9।',
      'ক্ষেত্রফল: Δ = 1/2 |28 - 9| = 1/2 |19| = 9.5 বর্গ একক।',
    ],
    finalAnswer: 'ΔABC এর ক্ষেত্রফল = 9.5 বর্গ একক।',
  },
  {
    level: 'বোর্ড পরীক্ষা স্পেশাল (CQ খ — ১০ম অধ্যায়: দ্বিপদী বিস্তৃতি)',
    levelBadge: 'bg-purple-500/10 text-purple-400 border border-purple-500/20',
    problemText: '(1 + 2x)⁵ এর দ্বিপদী বিস্তৃতি নির্ণয় করো এবং x³ এর সহগ বের করো।',
    givenData: ['দ্বিপদী রাশি: (1 + 2x)⁵', 'ঘাত n = 5'],
    solutionSteps: [
      'সাধারণ পদ: T(r+1) = ⁵Cr (1)⁵⁻ʳ (2x)ʳ = ⁵Cr · 2ʳ · xʳ',
      'r = 0: ⁵C0 · 1 = 1',
      'r = 1: ⁵C1 · 2x = 10x',
      'r = 2: ⁵C2 · 4x² = 40x²',
      'r = 3: ⁵C3 · 8x³ = 10 × 8x³ = 80x³ ⇒ x³ এর সহগ 80',
      'r = 4: ⁵C4 · 16x⁴ = 80x⁴',
      'r = 5: ⁵C5 · 32x⁵ = 32x⁵',
      'পূর্ণ বিস্তৃতি = 1 + 10x + 40x² + 80x³ + 80x⁴ + 32x⁵।',
    ],
    finalAnswer: 'বিস্তৃতি = 1 + 10x + 40x² + 80x³ + 80x⁴ + 32x⁵; x³ এর সহগ = 80।',
  },
];

const faqs: ToolFaqItem[] = [
  {
    question: 'এ্যাপোলোনিয়াসের উপপাদ্য (Apollonius Theorem) কখন প্রয়োগ করতে হয়?',
    answer: 'যখন কোনো ত্রিভুজের তিনটি বাহুর দৈর্ঘ্য দেওয়া থাকে এবং যেকোনো বাহুর উপর অঙ্কিত মধ্যমার (Median) দৈর্ঘ্য বের করতে বলা হয়, তখন এ্যাপোলোনিয়াসের উপপাদ্য ব্যবহৃত হয়। সূত্রটি হলো: AB² + AC² = 2(AD² + BD²)। এছাড়াও তিন বাহুর বর্গের সমষ্টির ৩ গুণ, তিন মধ্যমার বর্গের সমষ্টির ৪ গুণের সমান: 3(a² + b² + c²) = 4(da² + db² + dc²)।',
  },
  {
    question: 'আবৃত্ত/পৌনঃপুনিক দশমিককে অসীম গুণোত্তর ধারায় কীভাবে প্রকাশ করা হয়?',
    answer: 'পৌনঃপুনিক সংখ্যা যেমন 0.aḃ = 0.a + 0.0b + 0.00b + ... এ বিভক্ত করা হয়। এখানে অনাবৃত্ত অংশ 0.a সাধারণ ভগ্নাংশ হিসেবে থাকে এবং আবৃত্ত অংশটি একটি অসীম গুণোত্তর ধারা গঠন করে যার প্রথম পদ a = 0.0b এবং সাধারণ অনুপাত r = 0.1। যেহেতু |r| < 1, তাই S∞ = a / (1 - r) সূত্র প্রয়োগ করে উভয় অংশের যোগফল নির্ণয় করা হয়।',
  },
  {
    question: 'স্থানাঙ্ক জ্যামিতিতে বহুভুজের ক্ষেত্রফল নির্ণয়ে শীর্ষবিন্দু ঘড়ির কাঁটার বিপরীতক্রমে সাজানো কেন প্রয়োজন?',
    answer: 'Shoelace সূত্রে শীর্ষবিন্দুগুলোকে সমতলে ঘড়ির কাঁটার বিপরীতক্রমে (Counter-Clockwise) সাজালে ক্ষেত্রফলের মান স্বয়ংক্রিয়ভাবে ধনাত্মক আসে। ঘড়ির কাঁটার অনুকূলে সাজালে ফলাফলের মান ঋণাত্মক আসে, যার পরমমান (Absolute value) নিলে ক্ষেত্রফল পাওয়া যায়।',
  },
  {
    question: 'কাসিও fx-991EX বা fx-991CW দিয়ে কীভাবে দ্বিঘাত সমীকরণ ও বহুপদী সমাধান করা যায়?',
    answer: 'fx-991EX এ Menu > A (Equation/Func) > 2 (Polynomial) > 2 (Degree 2) চেপে সহগ a, b, c ইনপুট দিয়ে = চাপলেই মূলদ্বয় x1, x2 এবং পরাবৃত্তের সর্বোচ্চ/সর্বনিম্ন বিন্দু পাওয়া যায়। জটিল মূলের ক্ষেত্রে ক্যালকুলেটর স্বয়ংক্রিয়ভাবে i (কাল্পনিক একক) প্রদর্শন করে।',
  },
];
---

<ToolLayout
  title="এসএসসি উচ্চতর গণিত সম্পূর্ণ সমাধান ও সমীকরণ ইঞ্জিন — Biggan.me"
  metaDescription="NCTB এসএসসি উচ্চতর গণিত ৯ম-১০ম শ্রেণির ১৪টি অধ্যায়ের সম্পূর্ণ সমীকরণ সমাধানকারী ও প্রমাণ ইঞ্জিন। এ্যাপোলোনিয়াসের উপপাদ্য, দ্বিঘাত সমীকরণ, অসমতা, অসীম ধারা, দ্বিপদী বিস্তৃতি, স্থানাঙ্ক জ্যামিতি ও সম্ভাবনা।"
  toolName="এসএসসি উচ্চতর গণিত সমাধান ও সমীকরণ ইঞ্জিন"
  toolCategory="উচ্চতর গণিত (SSC Higher Mathematics)"
  curriculumTags={[
    'NCTB উচ্চতর গণিত (৯ম-১০ম)',
    'এ্যাপোলোনিয়াসের উপপাদ্য ও মধ্যমা',
    'দ্বিঘাত সমীকরণ ও নিশ্চয়ক',
    'অসীম ধারা ও পৌনঃপুনিক',
    'দ্বিপদী বিস্তৃতি',
    'Shoelace ক্ষেত্রফল',
  ]}
  topicId="higher-math"
  exemplars={exemplars}
  faqs={faqs}
>
  <div slot="calculator">
    <HigherMathCalculator client:load lang="bn" />
  </div>

  <div slot="derivation">
    <div class="space-y-4">
      <h3 class="text-base font-bold text-white">এনসিটিবি উচ্চতর গণিত কারিকুলাম ও বোর্ড পরীক্ষার মূল ভিত্তি</h3>
      <p class="text-slate-300">
        উচ্চতর গণিতে শতভাগ নম্বর নিশ্চিত করার মূল চাবিকাঠি হলো জ্যামিতিক প্রমাণের যৌক্তিক ধারাবাহিকতা, বীজগণিতের নির্ভুল হিসাব এবং স্থানাঙ্ক জ্যামিতির সূত্রের প্রয়োগ। বিগ্গান.মি-র এই ইন্টারেক্টিভ ইঞ্জিনটি পাঠ্যবইয়ের ১৪টি অধ্যায়ের প্রতিটি সমস্যার জন্য সুনির্দিষ্ট KaTeX গাণিতিক ধাপ তৈরি করে।
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 font-mono text-xs text-slate-300">
        <div class="p-4 bg-slate-950 rounded-xl border border-slate-800 space-y-1">
          <span class="text-indigo-400 font-bold block">৩য় অধ্যায় (এ্যাপোলোনিয়াসের সূত্র):</span>
          <p>• b² + c² = 2[da² + (a/2)²]</p>
          <p>• da² = (2b² + 2c² - a²) / 4</p>
          <p>• 3(a² + b² + c²) = 4(da² + db² + dc²)</p>
        </div>
        <div class="p-4 bg-slate-950 rounded-xl border border-slate-800 space-y-1">
          <span class="text-indigo-400 font-bold block">৭ম ও ১০ম অধ্যায় (ধারা ও দ্বিপদী):</span>
          <p>• S∞ = a / (1 - r) যখন |r| &lt; 1</p>
          <p>• (ax + by)ⁿ = ∑ ⁿCr (ax)ⁿ⁻ʳ (by)ʳ</p>
          <p>• সাধারণ পদ Tr+1 = ⁿCr aⁿ⁻ʳ bʳ</p>
        </div>
      </div>
    </div>
  </div>

  <div slot="applications">
    <p class="text-slate-300">
      উচ্চতর গণিতের এই বিষয়গুলো আধুনিক বিজ্ঞান ও প্রযুক্তির ভিত্তি: কম্পিউটার গ্রাফিক্স ও গেম ডেভেলপমেন্টে দ্বিমাত্রিক ভেক্টর ও স্থানাঙ্ক জ্যামিতি অপরিহার্য; রোবটিক্স ও মেশিন লার্নিংয়ে বহুপদী সমীকরণ ও সম্ভাব্যতা তত্ত্ব ব্যবহৃত হয়; স্যাটেলাইট ট্র্যাকিং ও স্থাপত্যশিল্পে এ্যাপোলোনিয়াসের উপপাদ্য ও ঘন জ্যামিতির সূত্রসমূহ প্রত্যক্ষ ভূমিকা পালন করে।
    </p>
  </div>
</ToolLayout>
