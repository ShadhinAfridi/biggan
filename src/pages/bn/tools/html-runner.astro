---
import ToolLayout, { type SolvedExemplar, type ToolFaqItem } from '../../../layouts/ToolLayout.astro';
import { HtmlRunner } from '../../../tools/ict/html-runner/HtmlRunner';

const exemplars: SolvedExemplar[] = [
  {
    level: 'সহজ / মৌলিক ধারণা',
    levelBadge: 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20',
    problemText: 'একটি সাধারণ HTML ওয়েব পেজ তৈরি করো যাতে একটি প্রধান শিরোনাম <h1> এবং একটি অনুচ্ছেদ <p> থাকবে।',
    givenData: ['শিরোনাম: HSC ICT Class 2026', 'অনুচ্ছেদ: Welcome to Web Design Chapter'],
    solutionSteps: [
      '<!DOCTYPE html> দিয়ে ডকুমেন্টের প্রকার নির্ধারণ করো।',
      '<html> ও <head> ট্যাগের ভেতরে <title> পেজের নাম সেট করো।',
      '<body> ট্যাগের ভেতরে <h1> ও <p> ট্যাগ ব্যবহার করো।',
    ],
    finalAnswer: '<h1>HSC ICT Class 2026</h1><p>Welcome to Web Design Chapter</p>',
  },
  {
    level: 'বোর্ড পরীক্ষা স্পেশাল (CQ গ/ঘ)',
    levelBadge: 'bg-cyan-500/10 text-cyan-400 border border-cyan-500/20',
    problemText: 'একটি টেবিল তৈরি করো যাতে ৩টি কলাম থাকবে (Roll, Subject, Marks)। ২য় রো-তে Marks কলামটি অনুভূমিকভাবে ২টি কলাম (Theory, Practical) জুড়ে থাকবে।',
    givenData: ['কলাম সংখ্যা: ৩টি', 'প্রয়োজনীয় অ্যাট্রিবিউট: colspan="2"'],
    solutionSteps: [
      '<table> ট্যাগ শুরু করে border="1" নির্ধারণ করো।',
      'প্রথম রো-তে <th>Roll</th>, <th>Subject</th> এবং <th colspan="2">Marks</th> লেখো।',
      'দ্বিতীয় রো-তে সাব-হেডার হিসেবে <th>Theory</th> ও <th>Practical</th> যোগ করো।',
    ],
    finalAnswer: '<th colspan="2">Marks</th> দিয়ে কলাম মার্জ সফলভাবে সম্পন্ন হয়।',
  },
  {
    level: 'ভর্তি পরীক্ষা ও বাস্তব প্রয়োগ',
    levelBadge: 'bg-purple-500/10 text-purple-400 border border-purple-500/20',
    problemText: 'একটি অনলাইন ছাত্র ভর্তি ফর্মের জন্য HTML কোড লিখো যাতে নাম নেওয়ার টেক্সট ফিল্ড ও সাইন্স/আর্টস নির্বাচনের রেডিও বাটন থাকবে।',
    givenData: ['ফর্ম ট্যাগ: <form>', 'ইনপুট টাইপ: text ও radio'],
    solutionSteps: [
      '<form action="#" method="POST"> দিয়ে ফর্ম শুরু করো।',
      '<input type="text" name="name"> দিয়ে নাম ফিল্ড তৈরি করো।',
      'গ্রুপ নির্বাচনের জন্য একই name="group" দিয়ে দুটি radio বাটন তৈরি করো যাতে যেকোনো একটি সিলেক্ট করা যায়।',
    ],
    finalAnswer: '<input type="radio" name="group" value="science"> Science',
  },
];

const faqs: ToolFaqItem[] = [
  {
    question: 'rowspan এবং colspan এর মধ্যে মূল পার্থক্য কী?',
    answer: 'rowspan উল্লম্বভাবে (উপর-নিচ) একাধিক রো বা সারির সেল একত্রিত (merge) করতে ব্যবহৃত হয়। অপরদিকে colspan অনুভূমিকভাবে (পাশাপাশি) একাধিক কলামের সেল একত্রিত করতে ব্যবহৃত হয়।',
  },
  {
    question: 'HTML ট্যাগ এবং অ্যাট্রিবিউট এর মধ্যে তফাৎ কী?',
    answer: 'ট্যাগ হলো HTML এলিমেন্টের নির্দেশক (যেমন <table>, <a>), আর অ্যাট্রিবিউট হলো ট্যাগের অতিরিক্ত বৈশিষ্ট্য বা মান (যেমন border="1", href="url")।',
  },
  {
    question: 'কন্টেইনার ট্যাগ এবং এম্পটি ট্যাগ কী?',
    answer: 'যেসব ট্যাগের শুরুর (<tag>) এবং শেষের (</tag>) অংশ থাকে তাকে কন্টেইনার ট্যাগ বলে (যেমন <p>...</p>)। আর যেসব ট্যাগের কোনো শেষ ট্যাগ থাকে না তাদের এম্পটি ট্যাগ বলে (যেমন <br>, <img>, <hr>)।',
  },
];
---

<ToolLayout
  title="এইচটিএমএল (HTML) কোড এডিটর ও রানার — Biggan.me"
  metaDescription="এইচএসসি আইসিটি ৪র্থ অধ্যায়ের জন্য লাইভ HTML কোড এডিটর ও রানার। জটিল টেবিল (rowspan/colspan), ফর্ম ডিজাইন, ওয়েবসাইট কাঠামো এবং বোর্ড পরীক্ষার CQ সমাধানের রিয়েল-টাইম প্লেগ্রাউন্ড।"
  toolName="এইচটিএমএল (HTML) কোড এডিটর ও রানার"
  toolCategory="তথ্য ও যোগাযোগ প্রযুক্তি (HSC ICT)"
  curriculumTags={['NCTB এইচএসসি আইসিটি (অধ্যায় ৪)', 'ওয়েব ডিজাইন পরিচিতি এবং HTML', 'টেবিল ও ফর্ম', 'বোর্ড CQ স্পেশাল']}
  topicId="html-runner"
  exemplars={exemplars}
  faqs={faqs}
>
  <div slot="calculator">
    <HtmlRunner client:load lang="bn" />
  </div>

  <div slot="derivation">
    <div class="space-y-6 text-slate-300">
      <!-- 1. WWW and History -->
      <div class="space-y-2">
        <h3 class="text-base sm:text-lg font-bold text-slate-100 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
          ১. ওয়ার্ল্ড ওয়াইড ওয়েব (WWW) ও HTML-এর ইতিহাস
        </h3>
        <p class="text-xs sm:text-sm leading-relaxed">
          ১৯৮৯ সালে সুইজারল্যান্ডের সার্ন (CERN)-এ কর্মরত ব্রিটিশ পদার্থবিদ <strong>টিম বার্নার্স-লি (Tim Berners-Lee)</strong> বিশ্বব্যাপী বিজ্ঞানীদের মধ্যে গবেষণা তথ্য বিনিময়ের সুবিধার্থে <strong>ওয়ার্ল্ড ওয়াইড ওয়েব (WWW)</strong> আবিষ্কার করেন। পরবর্তীতে ১৯৯০ সালে তিনি ওয়েব পেজ প্রদর্শনের জন্য <strong>HTML (HyperText Markup Language)</strong> উদ্ভাবন করেন। ১৯৯৩ সালে মার্ক অ্যান্ড্রিসেন প্রথম গ্রাফিক্যাল ব্রাউজার <em>Mosaic</em> তৈরি করেন এবং ১৯৯৪ সালে টিম বার্নার্স-লি <strong>W3C (World Wide Web Consortium)</strong> প্রতিষ্ঠা করেন। বর্তমানে <strong>HTML5</strong> হলো ইন্টারনেটের সার্বজনীন আদর্শ সংস্করণ।
        </p>
      </div>

      <!-- 2. Static vs Dynamic Website Table -->
      <div class="space-y-3">
        <h3 class="text-base sm:text-lg font-bold text-slate-100 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
          ২. স্ট্যাটিক (Static) বনাম ডায়নামিক (Dynamic) ওয়েব পেজ তুলনা
        </h3>
        <div class="overflow-x-auto">
          <table class="w-full text-xs text-left border border-slate-700 rounded-xl overflow-hidden">
            <thead class="bg-slate-950 text-slate-200 font-semibold border-b border-slate-700">
              <tr>
                <th class="p-3 border-r border-slate-700">বৈশিষ্ট্য / তুলনার বিষয়</th>
                <th class="p-3 border-r border-slate-700 text-cyan-400">স্ট্যাটিক ওয়েব পেজ (Static)</th>
                <th class="p-3 text-emerald-400">ডায়নামিক ওয়েব পেজ (Dynamic)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800 bg-slate-900/50 font-mono text-[11px]">
              <tr>
                <td class="p-2.5 font-bold font-sans text-slate-200 border-r border-slate-800">কন্টেন্ট পরিবর্তন</td>
                <td class="p-2.5 border-r border-slate-800">নির্দিষ্ট, ব্রাউজারে দ্রুত লোড হয় কিন্তু সরাসরি বদলায় না।</td>
                <td class="p-2.5">ব্যবহারকারী ও সময়ের সাথে ডেটা পরিবর্তনশীল।</td>
              </tr>
              <tr>
                <td class="p-2.5 font-bold font-sans text-slate-200 border-r border-slate-800">ব্যবহৃত ভাষা</td>
                <td class="p-2.5 border-r border-slate-800">HTML, CSS, ক্লায়েন্ট-সাইড JS</td>
                <td class="p-2.5">PHP, Python, Node.js, ASP.NET</td>
              </tr>
              <tr>
                <td class="p-2.5 font-bold font-sans text-slate-200 border-r border-slate-800">ডেটাবেজ সংযোগ</td>
                <td class="p-2.5 border-r border-slate-800">কোনো ডেটাবেজ সংযোগ প্রয়োজন হয় না।</td>
                <td class="p-2.5">MySQL, PostgreSQL বা MongoDB ডেটাবেজ অপরিহার্য।</td>
              </tr>
              <tr>
                <td class="p-2.5 font-bold font-sans text-slate-200 border-r border-slate-800">বিকাশ খরচ ও নিরাপত্তা</td>
                <td class="p-2.5 border-r border-slate-800">কম ব্যয়বহুল ও উচ্চ নিরাপত্তা সম্পন্ন।</td>
                <td class="p-2.5">তুলনামূলক বেশি ব্যয় ও রক্ষণাবেক্ষণ প্রয়োজন।</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- 3. Website Structures -->
      <div class="space-y-3">
        <h3 class="text-base sm:text-lg font-bold text-slate-100 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
          ৩. ওয়েবসাইটের কাঠামো (Website Structures)
        </h3>
        <p class="text-xs sm:text-sm leading-relaxed">
          ওয়েব পেজগুলোর পারস্পরিক লিংকিং পদ্ধতির উপর ভিত্তি করে কাঠামোকে ৪ ভাগে ভাগ করা হয়:
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
          <div class="p-3.5 bg-slate-950/80 rounded-xl border border-slate-800 space-y-1">
            <span class="text-cyan-400 font-bold block font-mono">১. লিনিয়ার / সিকোয়েন্সিয়াল (Linear):</span>
            <p class="text-slate-400">পেজগুলো ক্রমানুসারে একটির পর একটি (Next / Previous) সাজানো থাকে। যেমন: অনলাইন টিউটোরিয়াল বা বই।</p>
          </div>
          <div class="p-3.5 bg-slate-950/80 rounded-xl border border-slate-800 space-y-1">
            <span class="text-cyan-400 font-bold block font-mono">২. ট্রি / হায়ারার্কিক্যাল (Tree / Hierarchical):</span>
            <p class="text-slate-400">হোম পেজ থেকে শাখা-প্রশাখায় সাব-মেনু বিভক্ত থাকে। অধিকাংশ প্রাতিষ্ঠানিক ও শিক্ষাবোর্ড ওয়েবসাইট এই ধরনের।</p>
          </div>
          <div class="p-3.5 bg-slate-950/80 rounded-xl border border-slate-800 space-y-1">
            <span class="text-cyan-400 font-bold block font-mono">৩. নেটওয়ার্ক / ওয়েব-লিঙ্কড (Network):</span>
            <p class="text-slate-400">সবগুলো পেজ পরস্পরের সাথে সরাসরি সংযুক্ত থাকে। ফলে যেকোনো পেজ থেকে যেকোনো পেজে যাওয়া যায়।</p>
          </div>
          <div class="p-3.5 bg-slate-950/80 rounded-xl border border-slate-800 space-y-1">
            <span class="text-cyan-400 font-bold block font-mono">৪. হাইব্রিড / কম্বিনেশন (Hybrid):</span>
            <p class="text-slate-400">একাধিক কাঠামোর (যেমন ট্রি ও লিনিয়ার) সমন্বয়ে গঠিত জটিল আধুনিক ওয়েব পোর্টাল।</p>
          </div>
        </div>
      </div>

      <!-- 4. Table Merging Rules (Rowspan & Colspan) -->
      <div class="space-y-3">
        <h3 class="text-base sm:text-lg font-bold text-slate-100 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
          ৪. এইচটিএমএল টেবিল কাঠামো ও মার্জিং নিয়মাবলী (Rowspan ও Colspan)
        </h3>
        <p class="text-xs sm:text-sm leading-relaxed">
          এইচএসসি বোর্ড পরীক্ষায় ৪র্থ অধ্যায় থেকে প্রতি বছর সৃজনশীল প্রশ্নে একটি জটিল টেবিলের দৃশ্যপট থাকে। টেবিল নির্ভুলভাবে তৈরি করার নিয়ম:
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 font-mono text-xs">
          <div class="p-4 bg-slate-950 rounded-xl border border-slate-800 space-y-1.5">
            <span class="text-cyan-400 font-bold block">রো মার্জিং (Rowspan):</span>
            <p class="text-slate-400 font-sans leading-relaxed">
              যখন কোনো একটি সেলের তথ্য উল্লম্বভাবে নিচের সারিতেও একই থাকে, তখন প্রথম সেলে <code class="text-cyan-300 bg-slate-900 px-1 py-0.5 rounded">&lt;td rowspan="n"&gt;</code> লিখতে হয় এবং পরবর্তী <code class="text-cyan-300">n-1</code> টি সারি (Row) থেকে ওই সেলটি বাদ দিতে হয়।
            </p>
          </div>
          <div class="p-4 bg-slate-950 rounded-xl border border-slate-800 space-y-1.5">
            <span class="text-cyan-400 font-bold block">কলাম মার্জিং (Colspan):</span>
            <p class="text-slate-400 font-sans leading-relaxed">
              যখন একটি হেডার বা সেল অনুভূমিকভাবে পাশাপাশি একাধিক কলাম জুড়ে বিস্তৃত হয়, তখন <code class="text-cyan-300 bg-slate-900 px-1 py-0.5 rounded">&lt;th colspan="n"&gt;</code> ব্যবহার করা হয় এবং একই সারির মোট সেলের সংখ্যা হ্রাস পায়।
            </p>
          </div>
        </div>
      </div>

      <!-- 5. Website Publishing Steps -->
      <div class="space-y-3">
        <h3 class="text-base sm:text-lg font-bold text-slate-100 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
          ৫. ওয়েবসাইট পাবলিশিং-এর ৩টি মৌলিক ধাপ
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
          <div class="p-3.5 bg-slate-950 rounded-xl border border-slate-800 space-y-1">
            <span class="text-cyan-400 font-bold font-mono block">ধাপ ১: ডোমেইন নিবন্ধন</span>
            <p class="text-slate-400">ICANN অনুমোদিত রেজিস্ট্রারের মাধ্যমে ওয়েবসাইটের অনন্য নাম (যেমন: biggan.me) নিবন্ধন করা।</p>
          </div>
          <div class="p-3.5 bg-slate-950 rounded-xl border border-slate-800 space-y-1">
            <span class="text-cyan-400 font-bold font-mono block">ধাপ ২: ওয়েব হোস্টিং ক্রয়</span>
