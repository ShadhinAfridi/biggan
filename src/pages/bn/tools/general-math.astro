---
import ToolLayout, { type SolvedExemplar, type ToolFaqItem } from '../../../layouts/ToolLayout.astro';
import { GeneralMathCalculator } from '../../../tools/math/general-math/GeneralMathCalculator';

const exemplars: SolvedExemplar[] = [
  {
    level: 'বোর্ড পরীক্ষা স্পেশাল (CQ গ — পরিসংখ্যান)',
    levelBadge: 'bg-cyan-500/10 text-cyan-400 border border-cyan-500/20',
    problemText: 'শ্রেণি ব্যবধান ৩১-৪০ (গণসংখ্যা ৪), ৪১-৫০ (গণসংখ্যা ৬), ৫১-৬০ (গণসংখ্যা ৮) সারণী হতে সংক্ষিপ্ত পদ্ধতিতে গড় এবং প্রচুরক নির্ণয় করো।',
    givenData: [
      'শ্রেণি ব্যবধান: ৩১-৪০ (৪), ৪১-৫০ (৬), ৫১-৬০ (৮)',
      'মোট গণসংখ্যা n = ১৮',
      'শ্রেণি ব্যাপ্তি h = ১০',
    ],
    solutionSteps: [
      'মধ্যমান (xi) ও আনুমানিক গড় a = ৪৫.৫ (৪১-৫০ শ্রেণির মধ্যমান) নির্ধারণ করি।',
      'ধাপ বিচ্যুতি: u1 = -১, u2 = ০, u3 = ১। ∑(fi × ui) = (৪ × -১) + (৬ × ০) + (৮ × ১) = ৪।',
      'গড়: x̄ = a + (∑(fi·ui) / n) × h = ৪৫.৫ + (৪ / ১৮) × ১০ = ৪৫.৫ + ২.২২ = ৪৭.৭২।',
      'প্রচুরক শ্রেণি ৫১-৬০ (সর্বোচ্চ গণসংখ্যা ৮)। f1 = ৮ - ৬ = ২, f2 = ৮ - ০ = ৮।',
      'প্রচুরক = L + [f1 / (f1 + f2)] × h = ৫১ + [২ / (২ + ৮)] × ১০ = ৫১ + ২ = ৫৩.০০।',
    ],
    finalAnswer: 'গড় = ৪৭.৭২ এবং প্রচুরক = ৫৩.০০।',
  },
  {
    level: 'বোর্ড পরীক্ষা স্পেশাল (CQ গ/ঘ — ত্রিকোণমিতি ও উচ্চতা)',
    levelBadge: 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20',
    problemText: 'একটি টাওয়ারের পাদদেশ থেকে ৩০ মিটার দূরে ভূতলে কোনো বিন্দুতে টাওয়ারের শীর্ষের উন্নতি কোণ ৬০° হলে টাওয়ারটির উচ্চতা নির্ণয় করো।',
    givenData: ['অনুভূমিক দূরত্ব d = ৩০ মিটার', 'উন্নতি কোণ θ = ৬০°'],
    solutionSteps: [
      'ধরি, টাওয়ারের উচ্চতা h মিটার। সমকোণী ত্রিভুজ হতে পাই: tan(θ) = লম্ব / ভূমি।',
      'tan(৬০°) = h / ৩০',
      '√৩ = h / ৩০ \u27f9 h = ৩০√৩ = ৩০ × ১.৭৩২০৫ = ৫১.৯৬১৫ মিটার।',
    ],
    finalAnswer: 'টাওয়ারটির উচ্চতা ৫১.৯৬১৫ মিটার (প্রায়)।',
  },
  {
    level: 'বীজগাণিতিক রাশি (CQ খ — অনুসিদ্ধান্ত)',
    levelBadge: 'bg-purple-500/10 text-purple-400 border border-purple-500/20',
    problemText: 'যদি a + b = ৫ এবং ab = ৬ হয়, তবে a² + b² এবং a³ + b³ এর মান নির্ণয় করো।',
    givenData: ['a + b = ৫', 'ab = ৬'],
    solutionSteps: [
      'a² + b² = (a + b)² - ২ab = (৫)² - ২(৬) = ২৫ - ১২ = ১৩।',
      'a³ + b³ = (a + b)³ - ৩ab(a + b) = (৫)³ - ৩(৬)(৫) = ১২৫ - ৯০ = ৩৫।',
    ],
    finalAnswer: 'a² + b² = ১৩ এবং a³ + b³ = ৩৫।',
  },
];

const faqs: ToolFaqItem[] = [
  {
    question: 'প্রচুরক নির্ণয়ে f1 এবং f2 কীভাবে বের করতে হয়?',
    answer: 'প্রচুরক শ্রেণিতে সর্বোচ্চ গণসংখ্যা থাকে। f1 হলো প্রচুরক শ্রেণির গণসংখ্যা থেকে তার পূর্ববর্তী শ্রেণির গণসংখ্যার বিয়োগফল (f1 = fm - f(m-1))। f2 হলো প্রচুরক শ্রেণির গণসংখ্যা থেকে তার পরবর্তী শ্রেণির গণসংখ্যার বিয়োগফল (f2 = fm - f(m+1))। যদি প্রচুরক শ্রেণিটি প্রথম শ্রেণি হয় তবে f(m-1) = 0 এবং শেষ শ্রেণি হলে f(m+1) = 0 ধরতে হয়।',
  },
  {
    question: 'গাছ ভাঙার সমস্যায় (Broken Tree Problem) মূল সমীকরণটি কী?',
    answer: 'গাছের সম্পূর্ণ উচ্চতা H হলে এবং গাছটি ভূমি থেকে x উচ্চতায় ভেঙে সম্পূর্ণ বিচ্ছিন্ন না হয়ে ভূমির সাথে θ কোণ তৈরি করলে: sin(θ) = x / (H - x)। এ থেকে পাই x = [H × sin(θ)] / [1 + sin(θ)]।',
  },
  {
    question: 'কাসিও সায়েন্টিফিক ক্যালকুলেটরে কীভাবে পরিসংখ্যান সারণী ও গড় হিসাব করতে হয়?',
    answer: 'fx-991EX ClassWiz-এ Menu > 6 (Statistics) > 1 (1-Variable) চেপে গণসংখ্যা কলাম (Shift > Menu > Statistics > Frequency On) চালু করুন। এরপর শ্রেণি মধ্যমান ও গণসংখ্যা ইনপুট দিয়ে OPTN > 2 চাপলে নিমেষেই x̄ (গড়), ∑x এবং n পাওয়া যায়। fx-991ES PLUS এ Mode > 3 (STAT) ব্যবহার করা হয়।',
  },
];
---

<ToolLayout
  title="এসএসসি সাধারণ গণিত সম্পূর্ণ সমাধান ও সমীকরণ ইঞ্জিন — Biggan.me"
  metaDescription="NCTB এসএসসি সাধারণ গণিত ৯ম-১০ম শ্রেণির জন্য সম্পূর্ণ সমীকরণ সমাধানকারী। পরিসংখ্যান (গড়, মধ্যক, প্রচুরক), ত্রিকোণমিতি ও উচ্চতা, বীজগাণিতিক রাশি, পরিমিতি ও লগারিদম।"
  toolName="এসএসসি সাধারণ গণিত সমাধান ও সমীকরণ ইঞ্জিন"
  toolCategory="সাধারণ গণিত (SSC General Mathematics)"
  curriculumTags={['NCTB এসএসসি সাধারণ গণিত (৯ম-১০ম)', 'পরিসংখ্যান ও ধাপ বিচ্যুতি', 'ত্রিকোণমিতি ও উচ্চতা', 'বীজগাণিতিক অনুসিদ্ধান্ত']}
  topicId="statistics"
  exemplars={exemplars}
  faqs={faqs}
>
  <div slot="calculator">
    <GeneralMathCalculator client:visible lang="bn" />
  </div>

  <div slot="derivation">
    <div class="space-y-4">
      <h3 class="text-base font-bold text-white">এনসিটিবি সাধারণ গণিত বোর্ড পরীক্ষার মূল গাণিতিক ভিত্তি</h3>
      <p>
        এসএসসি সাধারণ গণিত পরীক্ষায় ১০০ নম্বরের মধ্যে সৃজনশীল (CQ) অংশে ৭০ নম্বর এবং নৈর্ব্যক্তিক (MCQ) অংশে ৩০ নম্বর থাকে। আমাদের এই অল-ইন-ওয়ান ক্যালকুলেটর এনসিটিবি কারিকুলামের ৭টি মূল অধ্যায়ের পাঠ্যবইয়ের সূত্রাবলী সরাসরি অ্যালগরিদমে রূপান্তর করে।
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 font-mono text-xs text-slate-300">
        <div class="p-4 bg-slate-950 rounded-xl border border-slate-800 space-y-1">
          <span class="text-cyan-400 font-bold block">১৭শ অধ্যায় (পরিসংখ্যান সূত্র):</span>
          <p>• গড়: x̄ = a + (∑fi·ui / n) × h</p>
          <p>• মধ্যক: L + [(n/2 - Fc) / fm] × h</p>
          <p>• প্রচুরক: L + [f1 / (f1 + f2)] × h</p>
        </div>
        <div class="p-4 bg-slate-950 rounded-xl border border-slate-800 space-y-1">
          <span class="text-cyan-400 font-bold block">১০ম অধ্যায় (উচ্চতা ও দূরত্ব):</span>
          <p>• একক উন্নতি কোণ: h = d × tan(θ)</p>
          <p>• দুই বিন্দু: h = d / (cot θ1 - cot θ2)</p>
          <p>• গাছ ভাঙা: x = [H sin θ] / [1 + sin θ]</p>
        </div>
      </div>
    </div>
  </div>

  <div slot="applications">
    <p>
      জরিপ ও সিভিল ইঞ্জিনিয়ারিংয়ে দূরবর্তী পাহাড় ও টাওয়ারের উচ্চতা নির্ণয়ে ত্রিকোণমিতি ব্যবহৃত হয়। জনশুমারি, জাতীয় আয় ও অর্থনৈতিক তথ্যের বিশ্লেষণে সংক্ষিপ্ত পদ্ধতির পরিসংখ্যানগত গড়, মধ্যক ও প্রচুরক অপরিহার্য। শিক্ষার্থীদের হাতে-কলমে গণিত অনুশীলনের জন্য বিগ্গান.মি-র এই ইঞ্জিনটি বিশেষভাবে ডিজাইন করা হয়েছে।
    </p>
  </div>
</ToolLayout>
