---
import ToolLayout, { type SolvedExemplar, type ToolFaqItem } from '../../../layouts/ToolLayout.astro';
import { BiologyCalculator } from '../../../tools/biology/BiologyCalculator';

const exemplars: SolvedExemplar[] = [
  {
    level: 'বোর্ড পরীক্ষা স্পেশাল (CQ গ/ঘ — পুষ্টি, বিএমআই ও দৈনিক ক্যালরি)',
    levelBadge: 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20',
    problemText: '১৬ বছর বয়সী একজন ছাত্রী শায়লার ওজন ৫০ কেজি এবং উচ্চতা ১৫৫ সেন্টিমিটার। সে সপ্তাহে ৩-৪ দিন মাঝারি ধরনের খেলাধুলা ও ব্যায়াম করে। শায়লার বিএমআই (BMI) ও মৌলিক বিপাকীয় হার (BMR) কত? তার বর্তমান ওজন ঠিক রাখতে দৈনিক কত ক্যালরি খাদ্য গ্রহণ করতে হবে?',
    givenData: [
      'শারীরিক বৈশিষ্ট্য: নারী (Female), বয়স A = 16 বছর',
      'ওজন W = 50 kg, উচ্চতা H = 155 cm = 1.55 m',
      'শারীরিক সক্রিয়তার মাত্রা = মাঝারি পরিশ্রমী (Activity Factor = 1.55)',
    ],
    solutionSteps: [
      '১ম অংশ: বিএমআই (BMI) নির্ণয়:',
      'BMI = ওজন (kg) / [উচ্চতা (m)]² = 50 / (1.55)² = 50 / 2.4025 = 20.81 kg/m²',
      'WHO ও NCTB নির্দেশিকা অনুযায়ী ১৮.৫ থেকে ২৪.৯ স্বাভাবিক ওজনের মানদণ্ড। অতএব শায়লার ওজন সম্পূর্ণ স্বাভাবিক ও স্বাস্থ্যকর।',
      '২য় অংশ: নারীর BMR নির্ণয় (হ্যারিস-বেনেডিক্ট সূত্র):',
      'BMR = 655 + (9.6 × W) + (1.8 × H) - (4.7 × A)',
      'BMR = 655 + (9.6 × 50) + (1.8 × 155) - (4.7 × 16)',
      'BMR = 655 + 480 + 279 - 75.2 = 1414 - 75.2 = 1338.8 kcal/দিন।',
      '৩য় অংশ: দৈনিক ক্যালরি চাহিদা (TDEE):',
      'TDEE = BMR × Activity Factor = 1338.8 × 1.55 = 2075.14 kcal/দিন।',
    ],
    finalAnswer: 'শায়লার বিএমআই ২০.৮১ (স্বাভাবিক ওজন), বিএমআর ১৩৩৮.৮ kcal/দিন এবং দৈনিক প্রয়োজনীয় ক্যালরি ২০৭৫.১ kcal।',
  },
  {
    level: 'বোর্ড পরীক্ষা স্পেশাল (CQ গ — জীবনীশক্তি ও গ্লুকোজ জারণের এটিপি)',
    levelBadge: 'bg-amber-500/10 text-amber-400 border border-amber-500/20',
    problemText: 'সবাত শ্বসন প্রক্রিয়ায় ২ মোল গ্লুকোজ (C₆H₁₂O₆) সম্পূর্ণরূপে জারিত হলে মোট কতটি ATP উৎপন্ন হবে এবং মোট কত কিলো-ক্যালরি কার্যকর শক্তি নির্গত হবে? (NCTB পাঠ্যবইয়ের ক্লাসিক্যাল মডেল অনুযায়ী)',
    givenData: [
      'গ্লুকোজের পরিমাণ = 2 মোল',
      '১ মোল গ্লুকোজের সবাত শ্বসনে উৎপাদিত ATP = 38 টি (NCTB ধারা)',
      'প্রতি মোল ATP-তে সঞ্চিত কার্যকর শক্তি = 7.3 kcal (30.55 kJ)',
    ],
    solutionSteps: [
      '১ম ধাপ: শ্বসনের বিভিন্ন পর্যায়ের এটিপি বণ্টন হিসাব (১ মোলের জন্য):',
      '• গ্লাইকোলাইসিস: সরাসরি ২ ATP + ২ NADH (৬ ATP) = ৮ ATP',
      '• অ্যাসিটাইল কো-এ সৃষ্টি: ২ NADH (৬ ATP) = ৬ ATP',
      '• ক্রেবস চক্র: ২ GTP (২ ATP) + ৬ NADH (১৮ ATP) + ২ FADH₂ (৪ ATP) = ২৪ ATP',
      '• ১ মোল গ্লুকোজে সর্বমোট = ৮ + ৬ + ২৪ = ৩৮টি ATP।',
      '২য় ধাপ: ২ মোল গ্লুকোজের জন্য মোট ATP:',
      'মোট ATP = 2 × 38 = 76 টি ATP।',
      '৩য় ধাপ: নির্গত কার্যকর শক্তির হিসাব:',
      'কিলো-ক্যালরিতে শক্তি = 76 × 7.3 = 554.8 kcal।',
      'কিলো-জুলে শক্তি = 76 × 30.55 = 2321.8 kJ।',
      'নিষ্ক্রান্ত কার্বন ডাই-অক্সাইড = 2 × 6 = 12 মোল CO₂।',
    ],
    finalAnswer: '২ মোল গ্লুকোজের সম্পূর্ণ সবাত শ্বসনে ৭৬টি ATP, ১২ মোল CO₂ এবং ৫৫৪.৮ kcal (২৩২১.৮ kJ) শক্তি উৎপন্ন হয়।',
  },
  {
    level: 'বোর্ড পরীক্ষা স্পেশাল (CQ গ/ঘ — বর্ণান্ধতা ও লিঙ্গ-সংযুক্ত বংশগতি)',
    levelBadge: 'bg-cyan-500/10 text-cyan-400 border border-cyan-500/20',
    problemText: 'একটি পরিবারে মা স্বাভাবিক দৃষ্টিসম্পন্ন কিন্তু বর্ণান্ধতার বাহক (Xᴺ Xⁿ) এবং বাবা সম্পূর্ণ স্বাভাবিক দৃষ্টিসম্পন্ন (Xᴺ Y)। পুনেট স্কয়ারের মাধ্যমে তাদের ভবিষ্যৎ সন্তানদের মধ্যে বর্ণান্ধতার বিস্তার ও শতকরা হার বিশ্লেষণ কর।',
    givenData: [
      'মাতার জিনোটাইপ = Xᴺ Xⁿ (স্বাভাবিক বাহক মা)',
      'পিতার জিনোটাইপ = Xᴺ Y (স্বাভাবিক বাবা)',
      'প্রকট অ্যালিল Xᴺ = স্বাভাবিক দৃষ্টির জিন, প্রচ্ছন্ন অ্যালিল Xⁿ = বর্ণান্ধতার জিন',
    ],
    solutionSteps: [
      '১ম ধাপ: জননকোষ (গ্যামেট) গঠন:',
      'মাতার ডিম্বাণু: ৫০% Xᴺ এবং ৫০% Xⁿ। পিতার শুক্রাণু: ৫০% Xᴺ এবং ৫০% Y।',
      '২য় ধাপ: ২ × ২ পুনেট স্কয়ার ক্রস:',
      '• (Xᴺ × Xᴺ) ⟹ XᴺXᴺ : স্বাভাবিক কন্যা সন্তান (২৫%)',
      '• (Xᴺ × Y) ⟹ XᴺY : স্বাভাবিক পুত্র সন্তান (২৫%)',
      '• (Xⁿ × Xᴺ) ⟹ XᴺXⁿ : স্বাভাবিক কিন্তু বাহক কন্যা সন্তান (২৫%)',
      '• (Xⁿ × Y) ⟹ XⁿY : বর্ণান্ধ পুত্র সন্তান (২৫%)',
      '৩য় ধাপ: লিঙ্গভিত্তিক ফলাফল বিশ্লেষণ:',
      '• কন্যা সন্তান: ১০০% দৃষ্টি স্বাভাবিক (৫০% খাঁটি স্বাভাবিক + ৫০% রোগবাহক)। কোনো কন্যা সন্তান বর্ণান্ধ হবে না।',
      '• পুত্র সন্তান: ৫০% স্বাভাবিক দৃষ্টিসম্পন্ন এবং ৫০% বর্ণান্ধ।',
    ],
    finalAnswer: 'সন্তানদের মধ্যে কোনো কন্যা বর্ণান্ধ হবে না (৫০% বাহক, ৫০% সুস্থ), তবে পুত্রদের ৫০% বর্ণান্ধ এবং ৫০% স্বাভাবিক হবে।',
  },
  {
    level: 'বোর্ড পরীক্ষা স্পেশাল (CQ গ — বাস্তুতন্ত্র ও লিণ্ডেম্যানের ১০% শক্তি প্রবাহ)',
    levelBadge: 'bg-green-500/10 text-green-400 border border-green-500/20',
    problemText: 'একটি পুকুরের বাস্তুতন্ত্রে উৎপাদক স্তরের ফাইটোপ্ল্যাঙ্কটনগুলো সূর্যালোক হতে ১০,০০০ জুল (10,000 J) জৈবশক্তি তৈরি করে। লিণ্ডেম্যানের ১০% শক্তি রূপান্তর নীতি অনুযায়ী সর্বোচ্চ খাদক (বোয়াল মাছ) স্তরে কত জুল শক্তি পৌঁছাবে এবং কতটুকু শক্তি পরিবেশে তাপ হিসেবে বিনষ্ট হবে?',
    givenData: [
      'উৎপাদক (Level 1) শক্তি E₁ = 10,000 J',
      'লিণ্ডেম্যানের শক্তি স্থানান্তর অনুপাত = 10% = 0.10',
      'প্রতি ধাপে অপচয়কৃত শক্তি = 90% = 0.90',
    ],
    solutionSteps: [
      '১ম ধাপ: প্রাথমিক খাদক / জুয়োপ্ল্যাঙ্কটন (Level 2):',
      'E₂ = E₁ × 0.10 = 10,000 × 0.10 = 1,000 Joules (১০%)।',
      '২য় ধাপ: গৌণ খাদক / ছোট মাছ (Level 3):',
      'E₃ = E₂ × 0.10 = 1,000 × 0.10 = 100 Joules (১%)।',
      '৩য় ধাপ: সর্বোচ্চ খাদক / বোয়াল মাছ (Level 4):',
      'E₄ = E₃ × 0.10 = 100 × 0.10 = 10 Joules (০.১%)।',
      '৪র্থ ধাপ: মোট অপচয়কৃত তাপশক্তি:',
      'তাপ ও শ্বসনে বিনষ্ট শক্তি = E₁ - E₄ = 10,000 - 10 = 9,990 Joules (৯৯.৯%)।',
    ],
    finalAnswer: 'সর্বোচ্চ খাদক স্তরে মাত্র ১০ জুল (১০ J) শক্তি পৌঁছাবে এবং বাকি ৯,৯৯০ জুল শক্তি পরিবেশে বিনষ্ট হবে।',
  },
];

const faqs: ToolFaqItem[] = [
  {
    question: 'এনসিটিবি জীববিজ্ঞান বই অনুযায়ী ১ অণু গ্লুকোজ জারণে কতটি ATP উৎপন্ন হয়?',
    answer: 'বাংলাদেশ জাতীয় শিক্ষাক্রম ও পাঠ্যপুস্তক বোর্ড (NCTB) অনুমোদিত ৯ম-১০ম শ্রেণির জীববিজ্ঞান পাঠ্যবই অনুযায়ী সবাত শ্বসনে ১টি গ্লুকোজ অণু সম্পূর্ণরূপে জারিত হয়ে সর্বমোট ৩৮টি ATP উৎপন্ন করে (গ্লাইকোলাইসিসে ৮টি, অ্যাসিটাইল কো-এ সৃষ্টিতে ৬টি এবং ক্রেবস চক্রে ২৪টি)। তবে আধুনিক প্রাণরসায়নের ম্যালেট-অ্যাসপার্টেট বা গ্লিসারল ফসফেট শাটল অনুযায়ী এটি কখনো কখনো ৩৬টি ATP হিসেবেও পরিগণিত হয়। আমাদের ক্যালকুলেটরে উভয় মডেলই প্রদর্শনের সুবিধা রয়েছে।',
  },
  {
    question: 'বিএমআই (BMI) ও বিএমআর (BMR) এর মধ্যে মৌলিক পার্থক্য কী?',
    answer: 'বিএমআই (Body Mass Index) হলো উচ্চতার অনুপাতে দেহের ওজনের সুস্থতার সূচক (BMI = W / H²)। আর বিএমআর (Basal Metabolic Rate) হলো কোনো ব্যক্তি সম্পূর্ণ কায়িক ও মানসিক বিশ্রামাবস্থায় থাকলে তার দেহের মৌলিক শারীরবৃত্তীয় কার্যক্রম (যেমন হৃৎপিণ্ডের স্পন্দন, শ্বাসপ্রশ্বাস, কিডনির ছাঁকন) সচল রাখতে দৈনিক যে ন্যূনতম ক্যালরি শক্তি প্রয়োজন, তার পরিমাপ।',
  },
  {
    question: 'পুরুষরা কেন বর্ণান্ধতার বাহক (Carrier) হতে পারে না?',
    answer: 'লাল-সবুজ বর্ণান্ধতা একটি X-লিংকড প্রচ্ছন্ন বংশগত রোগ। নারীদের দুটি X ক্রোমোজোম (XX) থাকে, ফলে একটিতে ত্রুটিপূর্ণ অ্যালিল (Xⁿ) এবং অন্যটিতে স্বাভাবিক অ্যালিল (Xᴺ) থাকলে তারা রোগাক্রান্ত না হয়ে শুধু বাহক হয়। কিন্তু পুরুষদের একটি মাত্র X ক্রোমোজোম (XY) থাকে। তাই তাদের X ক্রোমোজোমে একটিমাত্র প্রচ্ছন্ন জিন আসলেই তারা সরাসরি বর্ণান্ধ হয়ে যায়। পুরুষদের কোনো দ্বিতীয় X ক্রোমোজোম না থাকায় তারা কখনো বাহক হতে পারে না।',
  },
  {
    question: 'লিণ্ডেম্যানের ১০% নীতি অনুযায়ী খাদ্যশৃঙ্খলে পুষ্টিস্তর ৪-৫ টির বেশি দীর্ঘ হতে পারে না কেন?',
    answer: 'প্রতিটি পুষ্টিস্তরে আগের স্তরের মাত্র ১০% শক্তি স্থানান্তরিত হয় এবং বাকি ৯০% শক্তি জীবের শ্বসন, বিপাক ও রেচনে তাপ হিসেবে মহাশূন্যে অপচয় ঘটে। ফলে ৩য় বা ৪র্থ খাদক স্তর পার হওয়ার পর অবশিষ্ট শক্তি এতই কমে যায় (যেমন ১০০০ জুল থেকে কমে মাত্র ১ জুল বা ০.১ জুল) যে তা দিয়ে আরেকটি উচ্চতর খাদক স্তরের জীবের জীবনধারণ ও বংশবৃদ্ধি সম্ভব হয় না।',
  },
];
---

<ToolLayout
  title="এসএসসি জীববিজ্ঞান সম্পূর্ণ সমাধান ও সমীকরণ ইঞ্জিন — Biggan.me"
  metaDescription="NCTB এসএসসি জীববিজ্ঞান ৯ম-১০ম শ্রেণির সম্পূর্ণ সমীকরণ ও সমাধান ক্যালকুলেটর। বিএমআই, বিএমআর, ক্যালরি চাহিদা, গ্লুকোজ শ্বসনের এটিপি (ATP), পুনেট স্কয়ার ও বংশগতি, খাদ্যশৃঙ্খল ১০% শক্তি পিরামিড ও রক্তের গ্রুপ।"
  toolName="এসএসসি জীববিজ্ঞান সমাধান ও সমীকরণ ইঞ্জিন"
  toolCategory="জীববিজ্ঞান (SSC Biology)"
  curriculumTags={['NCTB এসএসসি জীববিজ্ঞান (৯ম-১০ম)', 'বিএমআই ও বিএমআর (BMI & BMR)', 'জীবনীশক্তি ও শ্বসন ATP', 'পুনেট স্কয়ার ও বর্ণান্ধতা']}
  topicId="biology-general"
  exemplars={exemplars}
  faqs={faqs}
>
  <div slot="calculator">
    <BiologyCalculator client:load lang="bn" />
  </div>

  <div slot="derivation">
    <div class="space-y-4 text-slate-300">
      <h3 class="text-base font-bold text-white">এনসিটিবি এসএসসি জীববিজ্ঞান পাঠ্যক্রমের পরিমাণগত অধ্যায়সমূহের মূল সূত্রের চার্ট</h3>
      <p class="text-sm">
        এসএসসি বোর্ড পরীক্ষায় জীববিজ্ঞান অংশে পূর্ণ নম্বর পেতে হলে ৪র্থ, ৫ম, ৬ষ্ঠ, ১২শ ও ১৩শ অধ্যায়ের গাণিতিক হিসাব এবং পুনেট স্কয়ার ব্যাখ্যা নির্ভুলভাবে সমাধান করতে হয়। নিচে মূল সূত্রের সারসংক্ষেপ দেওয়া হলো:
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 font-mono text-xs text-slate-300">
        <div class="p-4 bg-slate-950 rounded-xl border border-slate-800 space-y-1.5">
          <span class="text-emerald-400 font-bold block text-sm">৫ম অধ্যায়: খাদ্য, পুষ্টি ও পরিপাক (BMI ও BMR)</span>
          <p>• বিএমআই সূত্র: BMI = ওজন (kg) / [উচ্চতা (m)]²</p>
          <p>• পুরুষ BMR: 66 + (13.7 × W) + (5 × H) - (6.8 × A)</p>
          <p>• নারী BMR: 655 + (9.6 × W) + (1.8 × H) - (4.7 × A)</p>
          <p>• দৈনিক ক্যালরি (TDEE) = BMR × Activity Factor (1.2 হতে 1.9)</p>
          <p>• আদর্শ মান: 18.5 - 24.9 (স্বাভাবিক ওজন)</p>
        </div>

        <div class="p-4 bg-slate-950 rounded-xl border border-slate-800 space-y-1.5">
          <span class="text-emerald-400 font-bold block text-sm">৪র্থ অধ্যায়: জীবনীশক্তি (Bioenergetics - ATP ব্যালেন্স)</span>
          <p>• গ্লুকোজের সবাত শ্বসন: C₆H₁₂O₆ + 6O₂ ⟶ 6CO₂ + 6H₂O + 38 ATP</p>
          <p>• গ্লাইকোলাইসিস: ২ সরাসরি ATP + ২ NADH (৬ ATP) = ৮ ATP</p>
          <p>• অ্যাসিটাইল কো-এ: ২ NADH (৬ ATP) = ৬ ATP</p>
          <p>• ক্রেবস চক্র: ২ GTP (২ ATP) + ৬ NADH (১৮) + ২ FADH₂ (৪) = ২৪ ATP</p>
          <p>• প্রতি মোল ATP শক্তি = 7.3 kcal (30.55 kJ)</p>
        </div>

        <div class="p-4 bg-slate-950 rounded-xl border border-slate-800 space-y-1.5">
          <span class="text-emerald-400 font-bold block text-sm">১২শ অধ্যায়: জীবের বংশগতি ও পুনেট স্কয়ার (Genetics)</span>
          <p>• মেন্ডেলের একসংকর জনন: Tt × Tt ⟹ ফিনোটাইপ ৩:১, জিনোটাইপ ১:২:১</p>
          <p>• টেস্ট ক্রস (Test Cross): Tt × tt ⟹ অনুপাত ১:১</p>
          <p>• লাল-সবুজ বর্ণান্ধতা: X-লিংকড প্রচ্ছন্ন রোগ (Xᴺ স্বাভাবিক, Xⁿ বর্ণান্ধ)</p>
          <p>• স্বাভাবিক বাহক মা (XᴺXⁿ) × স্বাভাবিক বাবা (XᴺY) ⟹ ৫০% পুত্র বর্ণান্ধ</p>
          <p>• বর্ণান্ধ মা (XⁿXⁿ) × স্বাভাবিক বাবা (XᴺY) ⟹ ১০০% পুত্র বর্ণান্ধ</p>
        </div>

        <div class="p-4 bg-slate-950 rounded-xl border border-slate-800 space-y-1.5">
          <span class="text-emerald-400 font-bold block text-sm">১৩শ অধ্যায়: জীবের পরিবেশ (লিণ্ডেম্যানের ১০% শক্তি নীতি)</span>
          <p>• ট্রফিক স্তর রূপান্তর সূত্র: E_(n+1) = E_n × 0.10</p>
          <p>• উৎপাদক (Level 1): 100% শক্তি</p>
          <p>• ১ম স্তরের খাদক (তৃণভোজী): 10% শক্তি</p>
          <p>• ২য় স্তরের খাদক (মাংসাশী): 1% শক্তি</p>
          <p>• সর্বোচ্চ খাদক (Level 4): 0.1% শক্তি (৯০% শক্তি প্রতি ধাপে তাপ বিনষ্ট)</p>
        </div>

        <div class="p-4 bg-slate-950 rounded-xl border border-slate-800 space-y-1.5 md:col-span-2">
          <span class="text-emerald-400 font-bold block text-sm">৬ষ্ঠ অধ্যায়: জীবে পরিবহন (রক্তের গ্রুপ ও অ্যান্টিজেন-অ্যান্টিবডি)</span>
          <p>• সার্বজনীন দাতা (Universal Donor): O- (লোহিত কণিকায় কোনো A, B বা Rh অ্যান্টিজেন থাকে না)</p>
          <p>• সার্বজনীন গ্রহীতা (Universal Recipient): AB+ (রক্তরসে কোনো Anti-A, Anti-B বা Anti-Rh অ্যান্টিবডি থাকে না)</p>
          <p>• অ্যান্টিজেন ও অ্যান্টিবডির মিথস্ক্রিয়া: দাতার অ্যান্টিজেন গ্রহীতার সমগোত্রীয় অ্যান্টিবডির মুখোমুখি হলে রক্তকণিকা জমাটবদ্ধ (Agglutination) হয়ে প্রাণহানি ঘটে</p>
        </div>
      </div>
    </div>
  </div>

  <div slot="applications">
    <div class="space-y-3 text-slate-300">
      <h4 class="text-white font-bold text-sm">বোর্ড পরীক্ষার সতর্কবার্তা ও সাধারণ ভুলের সমাধান:</h4>
      <ul class="list-disc list-inside space-y-1.5 text-xs">
        <li><strong>উচ্চতার একক মিটার রূপান্তর:</strong> বিএমআই (BMI) বের করার সময় উচ্চতা সেন্টিমিটারে থাকলে অবশ্যই ১০০ দিয়ে ভাগ করে মিটারে রূপান্তর করে নিতে হবে। যেমন ১৫৫ সেমি = ১.৫৫ মিটার।</li>
        <li><strong>BMR সূত্রে পুরুষ ও নারীর পার্থক্য:</strong> সূত্রের ধ্রুবক সংখ্যা খেয়াল করুন— পুরুষের ক্ষেত্রে শুরুতে ৬৬ এবং নারীর ক্ষেত্রে ৬৫৫। পুরুষের ক্ষেত্রে ওজনের সহগ ১৩.৭, কিন্তু নারীর ক্ষেত্রে ৯.৬।</li>
        <li><strong>পুনেট স্কয়ারে লিঙ্গভিত্তিক অনুপাত:</strong> সৃজনশীল ঘ প্রশ্নে সাধারণত জানতে চায় "কন্যা সন্তানদের মধ্যে বর্ণান্ধতার হার কত?"। মনে রাখবেন, মা বাহক ও বাবা সুস্থ হলে কন্যাদের মধ্যে বর্ণান্ধতার হার ০% (৫০% বাহক, ৫০% সুস্থ), কিন্তু সামগ্রিক সন্তানদের মধ্যে ধরলে তা ২৫%। প্রশ্ন ভালোভাবে পড়ে উত্তর লিখুন।</li>
        <li><strong>অফলাইন প্রস্তুতি:</strong> পরীক্ষা হলের রিভিশন বা ইন্টারনেট ছাড়া অনুশীলনের জন্য আমাদের ওপেন সোর্স পাইথন সিএলআই (<code class="text-emerald-400">scripts/ssc_biology_calculator.py</code>) ব্যবহার করে দ্রুত যেকোনো হিসাব যাচাই করতে পারবেন।</li>
      </ul>
    </div>
  </div>
</ToolLayout>
