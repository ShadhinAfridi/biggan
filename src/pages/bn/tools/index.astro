---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AdSlot from '../../../components/ads/AdSlot.astro';
import { getLocalizedPath } from '../../../i18n/utils';

const scienceTools = [
  {
    id: 'molar-mass',
    name: 'মোলার ভর ও শতকরা সংযুতি বিশ্লেষক',
    desc: 'কেলাস পানি ও ব্র্যাকেটসহ জটিল যৌগের আণবিক ভর (g/mol) এবং প্রতিটি মৌলের শতকরা পরিমাণ নির্ণয়।',
    category: 'রসায়ন',
    curriculum: 'NCTB ৯ম-১২শ • NCERT Class 11',
    badge: 'জনপ্রিয়',
    icon: '⚗️',
  },
  {
    id: 'redox-balancer',
    name: 'আয়ন-ইলেকট্রন জারণ-বিজারণ সমতা ইঞ্জিন',
    desc: 'অম্লীয় ও ক্ষারীয় মাধ্যমে জারণ-বিজারণ অর্ধ-বিক্রিয়া পদ্ধতিতে পূর্ণাঙ্গ সমতাকরণ ও ইলেকট্রন স্থানান্তর।',
    category: 'রসায়ন',
    curriculum: 'NCTB এইচএসসি ১ম পত্র • NEET / JEE',
    badge: 'পরীক্ষার স্পেশাল',
    icon: '⚡',
  },
  {
    id: 'significant-figures',
    name: 'তাৎপর্যপূর্ণ অঙ্ক (Sig Figs) ও রাউন্ডিং ইঞ্জিন',
    desc: 'তাৎপর্যপূর্ণ অঙ্কের সংখ্যা গণনা, বৈজ্ঞানিক রূপান্তর এবং নির্ভুল যোগ, বিয়োগ ও গুণের আন্তর্জাতিক নিয়ম।',
    category: 'পরিমাপ ও ল্যাব',
    curriculum: 'পদার্থবিজ্ঞান ১ম পত্র অধ্যায় ১',
    badge: 'ল্যাবরেটরি',
    icon: '📏',
  },
  {
    id: 'projectile-motion',
    name: 'প্রাস ও প্রক্ষেপক গতিবিদ্যা সমাধানকারী',
    desc: 'সর্বোচ্চ উচ্চতা, বিচরণকাল, অনুভূমিক পাল্লা ও দ্বিমাত্রিক প্যারামেট্রিক গতিপথের ভেক্টর চিত্রায়ন।',
    category: 'পদার্থবিজ্ঞান',
    curriculum: 'NCTB গতিবিদ্যা • NCERT Motion in Plane',
    badge: 'ইন্টারেক্টিভ গ্রাফ',
    icon: '🎯',
  },
  {
    id: 'quadratic-solver',
    name: 'দ্বিঘাত সমীকরণ ধাপে ধাপে সমাধানকারী',
    desc: 'বাস্তব ও জটিল মূল, নিশ্চয়ক (Discriminant) বিশ্লেষণ এবং পূর্ণবর্গকরণ পদ্ধতির পুঙ্খানুপুঙ্খ ব্যাখ্যা।',
    category: 'গণিত',
    curriculum: 'উচ্চতর গণিত ৯ম-১২শ',
    badge: 'বীজগণিত',
    icon: '📐',
  },
  {
    id: 'general-math',
    name: 'এসএসসি সাধারণ গণিত সমাধান ও সমীকরণ ইঞ্জিন',
    desc: 'পরিসংখ্যান (সংক্ষিপ্ত গড়, মধ্যক, প্রচুরক), ত্রিকোণমিতি ও উচ্চতা, বীজগাণিতিক রাশি ও পরিমিতির পূর্ণাঙ্গ সমাধান।',
    category: 'গণিত',
    curriculum: 'NCTB সাধারণ গণিত ৯ম-১০ম',
    badge: 'অল-ইন-ওয়ান',
    icon: '➕',
  },
];

const ictTools = [
  {
    id: 'html-runner',
    name: 'এইচটিএমএল (HTML5) এডিটর ও লাইভ রানার',
    desc: 'এইচএসসি ৪র্থ অধ্যায়ের বোর্ড টেবিল (colspan/rowspan), ভুল কোড ফিক্স চ্যালেঞ্জ ও লাইভ মোবাইল/ডেস্কটপ ভিউ।',
    category: 'আইসিটি ৪র্থ অধ্যায়',
    curriculum: 'NCTB এইচএসসি আইসিটি • ওয়েব ডিজাইন',
    badge: 'বোর্ড স্পেশাল',
    icon: '🌐',
  },
  {
    id: 'circuit-simulator',
    name: 'ডিজিটাল লজিক সার্কিট ও গেট সিমুলেটর',
    desc: 'হাফ এডার, ফুল এডার ও ডি-মরগ্যান উপপাদ্যের লাইভ ইন্টারেক্টিভ সিগন্যাল ফ্লো এবং ট্রুথ টেবিল হাইলাইটিং।',
    category: 'আইসিটি ৩য় অধ্যায়',
    curriculum: 'NCTB এইচএসসি আইসিটি • ডিজিটাল লজিক',
    badge: 'রিয়েল-টাইম গেট',
    icon: '🔌',
  },
  {
    id: 'c-runner',
    name: 'সি প্রোগ্রামিং (C Code) ও মেমরি ট্রেসার',
    desc: 'ফর-লুপ, প্রাইম নাম্বার ও ধারার ধাপভিত্তিক এক্সিকিউশন, লাইভ র‍্যাম ভ্যারিয়েবল রেজিস্টার ও ড্রাই-রান টেবিল।',
    category: 'আইসিটি ৫ম অধ্যায়',
    curriculum: 'NCTB এইচএসসি আইসিটি • প্রোগ্রামিং ভাষা',
    badge: 'ড্রাই-রান ইঞ্জিন',
    icon: '💻',
  },
  {
    id: 'database-simulator',
    name: 'রিলেশনাল ডাটাবেজ ও এসকিউএল (SQL) সিমুলেটর',
    desc: 'Student/Result টেবিল দিয়ে SELECT, WHERE, INNER JOIN ও GROUP BY কুয়েরি এবং লাইভ ইআর স্কিমা ডায়াগ্রাম।',
    category: 'আইসিটি ৬ষ্ঠ অধ্যায়',
    curriculum: 'NCTB এইচএসসি আইসিটি • ডিবিএমএস ও এসকিউএল',
    badge: 'এসকিউএল ল্যাব',
    icon: '🗄️',
  },
];
---

<BaseLayout
  title="সকল বৈজ্ঞানিক ক্যালকুলেটর ও আইসিটি সিমুলেটর — Biggan.me"
  description="বোর্ড পরীক্ষা ও ভর্তি পরীক্ষার উপযোগী ধাপে ধাপে বিজ্ঞান ক্যালকুলেটর ও আইসিটি ল্যাব সিমুলেটর। মোলার ভর, লজিক গেট, সি প্রোগ্রামিং ড্রাই-রান, এইচটিএমএল ও এসকিউএল।"
  lang="bn"
>
  <div class="space-y-12">
    <div class="space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 text-xs font-mono">
        বিজ্ঞান ও আইসিটি টুলস ডিরেক্টরি
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
        ইন্টারেক্টিভ ল্যাব ও প্রোগ্রাম্যাটিক ক্যালকুলেটর
      </h1>
      <p class="text-base text-slate-400 max-w-3xl leading-relaxed">
        বোর্ড পরীক্ষায় ফুল মার্কস পাওয়ার উপযোগী সম্পূর্ণ সমীকরণ প্রতিপাদন, আন্তর্জাতিক একক বিশ্লেষণ, কাসিও fx-991 কি-স্ট্রোক গাইড এবং জিরো-সার্ভার আইসিটি ল্যাব সিমুলেটর।
      </p>
    </div>

    <!-- Ad placeholder -->
    <AdSlot slotType="banner" slotId="tools-index-top" />

    <!-- ICT & Programming Simulators Section -->
    <div class="space-y-6">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <div class="space-y-1">
          <h2 class="text-xl sm:text-2xl font-bold text-white flex items-center gap-2">
            <span>💻</span> আইসিটি ল্যাবরেটরি ও ভার্চুয়াল সিমুলেটর
          </h2>
          <p class="text-xs text-slate-400">এইচএসসি আইসিটির প্র্যাকটিক্যাল, ড্রাই-রান ও কোডিংয়ের জন্য ব্রাউজার-বেসড টুলস</p>
        </div>
        <span class="text-xs font-mono text-cyan-400 bg-cyan-500/10 px-3 py-1 rounded-full border border-cyan-500/20">
          ৪টি সিমুলেটর
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {ictTools.map((tool) => (
          <a
            href={getLocalizedPath(`/tools/${tool.id}`, 'bn')}
            class="group bg-slate-900 border border-slate-800 hover:border-cyan-500/50 rounded-2xl p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-cyan-950/30 flex flex-col justify-between"
          >
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-2xl p-2.5 rounded-xl bg-slate-950 border border-slate-800 group-hover:scale-110 transition">
                  {tool.icon}
                </span>
                <span class="text-[11px] font-mono px-2.5 py-0.5 rounded-full bg-cyan-950 text-cyan-300 border border-cyan-800">
                  {tool.badge}
                </span>
              </div>

              <h3 class="text-lg font-bold text-white group-hover:text-cyan-400 transition leading-snug">
                {tool.name}
              </h3>

              <p class="text-xs text-slate-400 leading-relaxed">
                {tool.desc}
              </p>
            </div>

            <div class="pt-4 mt-4 border-t border-slate-800 flex items-center justify-between text-[11px] text-slate-400">
              <span class="font-mono text-slate-400">{tool.curriculum}</span>
              <span class="text-cyan-400 font-semibold group-hover:translate-x-1 transition-transform">
                সিমুলেটর চালু করুন →
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Science & Math Calculators Section -->
    <div class="space-y-6">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <div class="space-y-1">
          <h2 class="text-xl sm:text-2xl font-bold text-white flex items-center gap-2">
            <span>🔬</span> বিজ্ঞান ও গণিত ক্যালকুলেটর ইঞ্জিন
          </h2>
          <p class="text-xs text-slate-400">পদক্ষেপভিত্তিক সমাধান ও কাসিও ক্যালকুলেটর কি-স্ট্রোক গাইড সম্বলিত টুলস</p>
        </div>
        <span class="text-xs font-mono text-emerald-400 bg-emerald-500/10 px-3 py-1 rounded-full border border-emerald-500/20">
          ৫টি ইঞ্জিন
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {scienceTools.map((tool) => (
          <a
            href={getLocalizedPath(`/tools/${tool.id}`, 'bn')}
            class="group bg-slate-900 border border-slate-800 hover:border-emerald-500/50 rounded-2xl p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-emerald-950/30 flex flex-col justify-between"
          >
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-2xl p-2.5 rounded-xl bg-slate-950 border border-slate-800 group-hover:scale-110 transition">
                  {tool.icon}
                </span>
                <span class="text-[11px] font-mono px-2.5 py-0.5 rounded-full bg-emerald-950 text-emerald-300 border border-emerald-800">
                  {tool.badge}
                </span>
              </div>

              <h3 class="text-lg font-bold text-white group-hover:text-emerald-400 transition leading-snug">
                {tool.name}
              </h3>

              <p class="text-xs text-slate-400 leading-relaxed">
                {tool.desc}
              </p>
            </div>

            <div class="pt-4 mt-4 border-t border-slate-800 flex items-center justify-between text-[11px] text-slate-400">
              <span class="font-mono text-slate-400">{tool.curriculum}</span>
              <span class="text-emerald-400 font-semibold group-hover:translate-x-1 transition-transform">
                হিসাব করুন →
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
