---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import { SigFigCalculator } from '../../../tools/significant-figures/SigFigCalculator';

const exemplars = [
  {
    level: 'পদার্থবিজ্ঞান ১ম পত্র • ব্যবহারিক ও পাঠ্যবই',
    levelBadge: 'নমুনা ১ • পরিমাপ ও যোগফল',
    problemText: 'একটি তারের তিনটি অংশের দৈর্ঘ্য যথাক্রমে ১২.১ সেমি, ১.২৫৩ সেমি এবং ০.০৪ সেমি মাপা হলো। তারটির মোট দৈর্ঘ্য তাৎপর্যপূর্ণ অঙ্কের সঠিক নিয়মে নির্ণয় কর।',
    givenData: [
      'দৈর্ঘ্যসমূহ: l₁ = 12.1 cm (১টি দশমিক স্থান)',
      'l₂ = 1.253 cm (৩টি দশমিক স্থান)',
      'l₃ = 0.04 cm (২টি দশমিক স্থান)',
    ],
    solutionSteps: [
      'প্রাকৃতিক যোগফল: 12.1 + 1.253 + 0.04 = 13.393 cm',
      'যোগের আন্তর্জাতিক নিয়ম: ফলাফলটি প্রদত্ত মানসমূহের মধ্যে সর্বনিম্ন দশমিক স্থান বিশিষ্ট সংখ্যার (১২.১ সেমি, ১ ঘর) সমান দশমিক স্থানে রাখতে হবে।',
      'সুতরাং ১৩.৩৯৩ কে ১ ঘর দশমিকে আসন্ন (Round) করলে হবে ১৩.৪ সেমি (যেহেতু ৩ এর পরবর্তী অঙ্ক ৯ > ৫)।',
    ],
    finalAnswer: 'মোট দৈর্ঘ্য = ১৩.৪ সেমি (তাৎপর্যপূর্ণ অঙ্ক ৩টি)',
  },
  {
    level: 'উচ্চ মাধ্যমিক পদার্থবিজ্ঞান ও রসায়ন গুণন সমস্যা',
    levelBadge: 'নমুনা ২ • গুণন ও ক্ষেত্রফল',
    problemText: 'একটি আয়তাকার পাতের দৈর্ঘ্য ৪.২৩৪ মিটার এবং প্রস্থ ২.১৬ মিটার হলে, এর ক্ষেত্রফল তাৎপর্যপূর্ণ অঙ্কের নিয়মানুযায়ী নির্ণয় কর।',
    givenData: [
      'দৈর্ঘ্য = 4.234 m (৪টি তাৎপর্যপূর্ণ অঙ্ক)',
      'প্রস্থ = 2.16 m (৩টি তাৎপর্যপূর্ণ অঙ্ক)',
    ],
    solutionSteps: [
      'কাঁচা ক্ষেত্রফল = 4.234 × 2.16 = 9.14544 m²',
      'গুণনের নিয়ম: গুণফলে তাৎপর্যপূর্ণ অঙ্কের সংখ্যা হবে ইনপুটগুলোর মধ্যে সর্বনিম্ন তাৎপর্যপূর্ণ অঙ্কের সংখ্যার (২.১৬ এর ৩টি অঙ্ক) সমান।',
      'অতএব ৯.১৪৫৪৪ কে ৩টি তাৎপর্যপূর্ণ অঙ্কে আসন্ন করলে মান দাঁড়ায় ৯.১৫ m²।',
    ],
    finalAnswer: 'ক্ষেত্রফল = ৯.১৫ m²',
  },
  {
    level: 'অলিম্পিয়াড ও বৈজ্ঞানিক সংকেত সমস্যা',
    levelBadge: 'নমুনা ৩ • বৈজ্ঞানিক সংকেত',
    problemText: '০.০০০৪০৫০০ সংখ্যাটিতে কতটি তাৎপর্যপূর্ণ অঙ্ক রয়েছে এবং একে ৩টি তাৎপর্যপূর্ণ অঙ্কে বৈজ্ঞানিক সংকেতে রূপান্তর কর।',
    givenData: [
      'প্রদত্ত সংখ্যা: 0.00040500',
    ],
    solutionSteps: [
      'প্রথম অশূন্য অঙ্ক ৪ এর পূর্বে অবস্থিত শূন্যসমূহ (Leading zeros) কখনই তাৎপর্যপূর্ণ নয়।',
      '৪ এবং ৫ এর মধ্যবর্তী ০ তাৎপর্যপূর্ণ (Captive zero)।',
      'দশমিক বিন্দুর পরবর্তী শেষ দুটি শূন্য তাৎপর্যপূর্ণ (Trailing zeros)।',
      'মোট তাৎপর্যপূর্ণ অঙ্ক: ৪, ০, ৫, ০, ০ অর্থাৎ মোট ৫টি।',
      'একে ৩টি তাৎপর্যপূর্ণ অঙ্কে বৈজ্ঞানিক সংকেতে রূপান্তর: 4.05 × 10⁻⁴',
    ],
    finalAnswer: 'মোট ৫টি তাৎপর্যপূর্ণ অঙ্ক; ৩ অঙ্কে রূপান্তর = ৪.০৫ × ১০⁻⁴',
  },
];

const faqs = [
  {
    question: 'তাৎপর্যপূর্ণ অঙ্ক (Significant Figures) বলতে কী বোঝায়?',
    answer: 'কোনো পরীক্ষণ বা বৈজ্ঞানিক পরিমাপে যেসব অঙ্কের মান সম্পর্কে আমরা সম্পূর্ণ নিশ্চিত এবং যার সাথে অতিরিক্ত একটিমাত্র আনুমানিক বা অনিশ্চিত অঙ্ক অন্তর্ভুক্ত থাকে, সেই নির্ভরযোগ্য সকল অঙ্ককে একত্রে তাৎপর্যপূর্ণ অঙ্ক বলে।',
  },
  {
    question: 'দশমিকবিহীন পূর্ণসংখ্যার শেষের শূন্যগুলো কি তাৎপর্যপূর্ণ?',
    answer: 'সাধারণভাবে কোনো একক বা দশমিক বিন্দু ছাড়া পূর্ণসংখ্যার শেষের শূন্যগুলো (যেমন ১০০ বা ১৫০০) অনিশ্চিত বলে গণ্য হয় এবং তাৎপর্যপূর্ণ হিসেবে ধরা হয় না। তবে যদি সংখ্যাটি বৈজ্ঞানিক সংকেতে লেখা হয় (যেমন ১.০০ × ১০²) তখন স্পষ্টত ৩টি তাৎপর্যপূর্ণ অঙ্ক নির্দেশ করে।',
  },
  {
    question: 'ক্যালকুলেটরে সরাসরি সায়েন্টিফিক মোডে উত্তর কীভাবে আনব?',
    answer: 'কাসিও fx-991ES ক্যালকুলেটরে SHIFT -> MODE -> 7 (Sci) চেপে ৩ চাপলে যেকোনো গণনার ফলাফল স্বয়ংক্রিয়ভাবে ৩টি তাৎপর্যপূর্ণ অঙ্কে স্ক্রিনে প্রদর্শিত হবে। স্বাভাবিক মোডে ফিরতে SHIFT -> MODE -> 8 -> 2 (Norm 2) চাপুন।',
  },
];
---

<ToolLayout
  title="তাৎপর্যপূর্ণ অঙ্ক (Significant Figures) ক্যালকুলেটর ও গাইড — Biggan.me"
  metaDescription="তাৎপর্যপূর্ণ অঙ্কের সংখ্যা গণনা, বৈজ্ঞানিক প্রকাশ এবং যোগ, বিয়োগ, গুণ ও ভাগের নির্ভুল রাউন্ডিং নিয়ম। পাঠ্যবইয়ের সমাধানকৃত উদাহরণ ও কাসিও সায়েন্টিফিক সেটআপ গাইড।"
  toolName="তাৎপর্যপূর্ণ অঙ্ক (Significant Figures) ক্যালকুলেটর"
  toolCategory="ব্যবহারিক পদার্থবিজ্ঞান ও পরিমাপ"
  curriculumTags={['NCTB পদার্থবিজ্ঞান ১ম পত্র অধ্যায় ১', 'NCERT Class 11 Units & Measurements', 'ল্যাবরেটরি প্র্যাকটিক্যাল']}
  topicId="sigfigs"
  exemplars={exemplars}
  faqs={faqs}
>
  <div slot="calculator">
    <SigFigCalculator client:load lang="bn" />
  </div>

  <div slot="derivation" class="space-y-4">
    <p>
      ব্যবহারিক বৈজ্ঞানিক পরিমাপে যেকোনো পরিমাপক যন্ত্রের একটি নির্দিষ্ট সংবেদনশীলতা বা লঘিষ্ঠ গণন (Least Count) থাকে। যেকোনো যন্ত্র কখনো কোনো রাশির পরম নিখুঁত মান দিতে পারে না। তাই পরীক্ষার উপাত্ত লিপিবদ্ধকরণ এবং গণনায় সঠিক সূক্ষ্মতা (Precision) বজায় রাখার জন্য আন্তর্জাতিকভাবে <strong>তাৎপর্যপূর্ণ অঙ্ক নীতি</strong> মেনে চলা হয়।
    </p>

    <h3 class="text-base font-bold text-white mt-4">অঙ্ক গণনার মৌলিক স্বর্ণসূত্রসমূহ</h3>
    <ul class="list-disc list-inside space-y-2 text-slate-300">
      <li>সকল অশূন্য অঙ্ক (১, ২, ..., ৯) সর্বদা তাৎপর্যপূর্ণ।</li>
      <li>দুটি অশূন্য অঙ্কের মধ্যবর্তী শূন্যসমূহ (Captive Zeros) সর্বদা তাৎপর্যপূর্ণ (যেমন: ১০৫ এ ৩টি)।</li>
      <li>প্রথম অশূন্য অঙ্কের বামপাশের শূন্যসমূহ (Leading Zeros) কখনই তাৎপর্যপূর্ণ নয় (যেমন: ০.০০২৫ এ ২টি)।</li>
      <li>দশমিকযুক্ত সংখ্যার ডানপাশের শেষ শূন্যসমূহ (Trailing Zeros) সর্বদা তাৎপর্যপূর্ণ (যেমন: ৩.৫০০ এ ৪টি)।</li>
    </ul>

    <h3 class="text-base font-bold text-white mt-4">গাণিতিক অপারেশনের বাধ্যবাধকতা</h3>
    <p>
      <strong>যোগ ও বিয়োগ:</strong> চূড়ান্ত ফলাফলে দশমিকের পর অঙ্কের সংখ্যা ইনপুটসমূহের মধ্যে সর্বনিম্ন দশমিক স্থান বিশিষ্ট সংখ্যার সমান হতে হবে।
    </p>
    <p>
      <strong>গুণ ও ভাগ:</strong> চূড়ান্ত ফলাফলে মোট তাৎপর্যপূর্ণ অঙ্কের সংখ্যা ইনপুটসমূহের মধ্যে সর্বনিম্ন তাৎপর্যপূর্ণ অঙ্ক বিশিষ্ট সংখ্যার সমান হতে হবে।
    </p>
  </div>

  <div slot="applications" class="space-y-3">
    <p>
      ১. <strong>নির্মাণ ও মেকানিক্যাল ইঞ্জিনিয়ারিং:</strong> ব্রিজ, ফ্লাইওভার ও মহাকাশযানের যন্ত্রাংশ তৈরিতে মাইক্রোমিটার ও ভার্নিয়ার ক্যালিপার্সের ত্রুটি নিয়ন্ত্রণ এবং সঠিক তাৎপর্যপূর্ণ অঙ্কে টলারেন্স বজায় রাখা অত্যন্ত জরুরি।
    </p>
    <p>
      ২. <strong>ঔষধ রসায়ন ও বিষাক্ততা মাত্রা:</strong> ওষুধের উপাদানে মিলিগ্রাম বা মাইক্রোগ্রাম মাত্রার হেরফের জীবন-মৃত্যুর ঝুঁকি তৈরি করতে পারে বিধায় বিশ্লেষণী রসায়নে তাৎপর্যপূর্ণ অঙ্ক কঠোরভাবে মানা হয়।
    </p>
  </div>
</ToolLayout>
