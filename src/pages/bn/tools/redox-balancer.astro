---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import { RedoxBalancer } from '../../../tools/redox-balancer/RedoxBalancer';

const exemplars = [
  {
    level: 'উচ্চ মাধ্যমিক বোর্ড পরীক্ষা (ঢাকা বোর্ড • রসায়ন ১ম পত্র)',
    levelBadge: 'নমুনা ১ • অম্লীয় মাধ্যম',
    problemText: 'অম্লীয় মাধ্যমে পটাশিয়াম পারম্যাঙ্গানেট (KMnO₄) দ্বারা ফেরাস সালফেট (FeSO₄) এর জারণ সমীকরণটি আয়ন-ইলেকট্রন পদ্ধতিতে ধাপে ধাপে সমতা কর।',
    givenData: [
      'জারক: MnO₄⁻ (Mn এর জারণ মান +7 থেকে কমে +2 হয়)',
      'বিজারক: Fe²⁺ (Fe এর জারণ মান +2 থেকে বেড়ে +3 হয়)',
      'মাধ্যম: লঘু H₂SO₄ (অম্লীয়)',
    ],
    solutionSteps: [
      'জারণ অর্ধ-বিক্রিয়া: Fe²⁺ → Fe³⁺ + e⁻  (সমীকরণ ১)',
      'বিজারণ অর্ধ-বিক্রিয়া: MnO₄⁻ + 8H⁺ + 5e⁻ → Mn²⁺ + 4H₂O  (সমীকরণ ২)',
      'ইলেকট্রন সংখ্যা সমান করতে সমীকরণ (১) কে ৫ দ্বারা গুণ করি: 5Fe²⁺ → 5Fe³⁺ + 5e⁻',
      'যোগ করে পাই: MnO₄⁻ + 5Fe²⁺ + 8H⁺ → Mn²⁺ + 5Fe³⁺ + 4H₂O',
      'দর্শক আয়ন (K⁺ ও SO₄²⁻) সংযোগ করে পূর্ণ আণবিক সমীকরণ: 2KMnO₄ + 10FeSO₄ + 8H₂SO₄ → 2MnSO₄ + 5Fe₂(SO₄)₃ + K₂SO₄ + 8H₂O',
    ],
    finalAnswer: 'আয়নিক সমতা: MnO₄⁻ + 5Fe²⁺ + 8H⁺ → Mn²⁺ + 5Fe³⁺ + 4H₂O',
  },
  {
    level: 'সর্বভারতীয় NEET / JEE অ্যাডভান্সড',
    levelBadge: 'নমুনা ২ • ডাইক্রোমেট জারক',
    problemText: 'লঘু সালফিউরিক এসিডের উপস্থিতিতে পটাশিয়াম ডাইক্রোমেট (K₂Cr₂O₇) ও ফেরাস সালফেটের মধ্যে সংঘটিত বিক্রিয়ার আয়নিক সমীকরণ প্রতিপাদন কর।',
    givenData: [
      'জারক: Cr₂O₇²⁻ (প্রতি Cr এর জারণ মান +6 থেকে +3 এ নামে)',
      'বিজারক: Fe²⁺',
    ],
    solutionSteps: [
      'বিজারণ অর্ধ-বিক্রিয়া: Cr₂O₇²⁻ + 14H⁺ + 6e⁻ → 2Cr³⁺ + 7H₂O',
      'জারণ অর্ধ-বিক্রিয়া: (Fe²⁺ → Fe³⁺ + e⁻) × 6 = 6Fe²⁺ → 6Fe³⁺ + 6e⁻',
      'উভয় অর্ধ-বিক্রিয়া যোগ করে: Cr₂O₇²⁻ + 6Fe²⁺ + 14H⁺ → 2Cr³⁺ + 6Fe³⁺ + 7H₂O',
    ],
    finalAnswer: 'Cr₂O₇²⁻ + 6Fe²⁺ + 14H⁺ → 2Cr³⁺ + 6Fe³⁺ + 7H₂O',
  },
  {
    level: 'উচ্চ মাধ্যমিক বোর্ড পরীক্ষা • ক্ষারীয় মাধ্যম',
    levelBadge: 'নমুনা ৩ • ক্ষারীয় মাধ্যম',
    problemText: 'ক্ষারীয় মাধ্যমে পারম্যাঙ্গানেট আয়ন (MnO₄⁻) এবং আয়োডাইড আয়ন (I⁻) এর বিক্রিয়াটি সমতাকরণ কর।',
    givenData: [
      'MnO₄⁻ বিজারিত হয়ে বাদামী বর্ণের MnO₂ তৈরি করে',
      'I⁻ জারিত হয়ে আয়োডেট (IO₃⁻) গঠন করে',
      'মাধ্যম: ক্ষারীয় (OH⁻)',
    ],
    solutionSteps: [
      'জারণ অর্ধ-বিক্রিয়া: I⁻ + 6OH⁻ → IO₃⁻ + 3H₂O + 6e⁻',
      'বিজারণ অর্ধ-বিক্রিয়া: (MnO₄⁻ + 2H₂O + 3e⁻ → MnO₂ + 4OH⁻) × 2',
      'যোগ করে সাধারণ পদ কাটাকাটি করে: 2MnO₄⁻ + I⁻ + H₂O → 2MnO₂ + IO₃⁻ + 2OH⁻',
    ],
    finalAnswer: '2MnO₄⁻ + I⁻ + H₂O → 2MnO₂ + IO₃⁻ + 2OH⁻',
  },
];

const faqs = [
  {
    question: 'আয়ন-ইলেকট্রন পদ্ধতি কেন বীজগণিতীয় পদ্ধতির চেয়ে পরীক্ষার খাতায় বেশি গ্রহণযোগ্য?',
    answer: 'বীজগণিতীয় পদ্ধতিতে কেবল পরমাণুর সমতা হয়, কিন্তু জারণ-বিজারণের প্রকৃত ভৌত প্রক্রিয়া অর্থাৎ কোন মৌলটি ইলেকট্রন ত্যাগ করল এবং কোনটি গ্রহণ করল তা প্রকাশ পায় না। শিক্ষা বোর্ডসমূহের নম্বর বন্টনে জারণ ও বিজারণ অর্ধ-বিক্রিয়া আলাদাভাবে লিখে ইলেকট্রন স্থানান্তর প্রদর্শনের জন্য পৃথক নম্বর নির্ধারিত থাকে।',
  },
  {
    question: 'অম্লীয় ও ক্ষারীয় মাধ্যমে সমতাকরণের মূল পার্থক্য কী?',
    answer: 'অম্লীয় মাধ্যমে অতিরিক্ত অক্সিজেনকে সমতা করতে বিপরীত পাশে H₂O এবং প্রয়োজনীয় হাইড্রোজেন মেলাতে H⁺ যোগ করা হয়। ক্ষারীয় মাধ্যমে প্রতিটি অতিরিক্ত হাইড্রোজেনের জন্য সমসংখ্যক OH⁻ যোগ করে পানি গঠন করতে হয়, অথবা সরাসরি OH⁻ এবং H₂O সমন্বয় করে সমতা রক্ষা করতে হয়।',
  },
  {
    question: 'টাইট্রেশন অংকে জারক ও বিজারকের মোল অনুপাত কীভাবে বের করব?',
    answer: 'সুষম সমীকরণের স্টয়কিওমেট্রিক সহগই হলো মোল অনুপাত। যেমন KMnO₄ ও FeSO₄ এর ক্ষেত্রে অনুপাত ১:৫। অর্থাৎ ১ মোল KMnO₄ ঠিক ৫ মোল Fe²⁺ কে সম্পূর্ণ জারিত করতে পারে (n₁V₁S₁ = n₂V₂S₂)।',
  },
  {
    question: 'কাসিও সায়েন্টিফিক ক্যালকুলেটরে কীভাবে টাইট্রেশন সমীকরণ মেলানো যায়?',
    answer: 'কাসিও fx-991ES PLUS বা fx-991EX এ "ALPHA" "CALC" চেপে সমীকরণ স্ক্রিনে লিখে "SHIFT" "CALC" (SOLVE) চাপলে সরাসরি অজানা ঘনমাত্রা বা আয়তন বের হয়ে যায়।',
  },
];
---

<ToolLayout
  title="আয়ন-ইলেকট্রন জারণ-বিজারণ সমতা ইঞ্জিন — Biggan.me"
  metaDescription="অম্লীয় ও ক্ষারীয় মাধ্যমে জারণ-বিজারণ অর্ধ-বিক্রিয়া পদ্ধতিতে সম্পূর্ণ সমীকরণ প্রতিপাদন। NCTB HSC ও NCERT সিলেবাসের সকল গুরুত্বপূর্ণ রাসায়নিক বিক্রিয়া ও কাসিও সলভ গাইড।"
  toolName="আয়ন-ইলেকট্রন জারণ-বিজারণ সমতা ইঞ্জিন"
  toolCategory="উচ্চ মাধ্যমিক রসায়ন"
  curriculumTags={['NCTB রসায়ন ১ম পত্র অধ্যায় ৩', 'NCERT Class 11 Redox Reactions', 'NEET & JEE Main']}
  topicId="redox"
  exemplars={exemplars}
  faqs={faqs}
>
  <div slot="calculator">
    <RedoxBalancer client:load lang="bn" />
  </div>

  <div slot="derivation" class="space-y-4">
    <p>
      জারণ-বিজারণ (Redox) হলো যুগপৎ সংঘটিত এমন একটি ইলেকট্রনীয় প্রক্রিয়া যেখানে এক বা একাধিক রাসায়নিক সত্ত্বা ইলেকট্রন ত্যাগ করে (জারণ) এবং অন্য সত্ত্বা সেই ইলেকট্রন গ্রহণ করে (বিজারণ)। আধুনিক আয়ন-ইলেকট্রন পদ্ধতিতে বিক্রিয়ার ভৌত নীতি হলো: <strong>বর্জিত মোট ইলেকট্রন সংখ্যা = গৃহীত মোট ইলেকট্রন সংখ্যা</strong>।
    </p>

    <h3 class="text-base font-bold text-white mt-4">আয়ন-ইলেকট্রন পদ্ধতির ধারাবাহিক বৈজ্ঞানিক নিয়মাবলী</h3>
    <ol class="list-decimal list-inside space-y-2 text-slate-300">
      <li><strong>জারণ মান নির্ধারণ:</strong> বিক্রিয়ক ও উৎপাদের প্রতিটি মৌলের জারণ মান নির্ণয় করে জারক ও বিজারক চিহ্নিত করা।</li>
      <li><strong>অর্ধ-বিক্রিয়া পৃথকীকরণ:</strong> জারণ বিক্রিয়াকে (ইলেকট্রন ডানপাশে) এবং বিজারণ বিক্রিয়াকে (ইলেকট্রন বামপাশে) পৃথক দুটি সমীকরণ আকারে লেখা।</li>
      <li><strong>মৌলিক পরমাণু সমতা:</strong> অক্সিজেন ও হাইড্রোজেন ব্যতীত অন্যান্য মূল মৌলসমূহের পরমাণু সংখ্যা উভয়পাশে সমান করা।</li>
      <li><strong>অক্সিজেন সমতা:</strong> অম্লীয় দ্রবণে যে পাশে যতটি অক্সিজেন পরমাণু কম থাকে, সে পাশে ঠিক তত অণু $H_2O$ যোগ করা।</li>
      <li><strong>হাইড্রোজেন সমতা:</strong> যে পাশে হাইড্রোজেন ঘাটতি থাকে, সে পাশে প্রয়োজনীয় সংখ্যক $H^+$ আয়ন যোগ করা।</li>
      <li><strong>চার্জ সমতাকরণ:</strong> উভয় পাশের নিট ধনাত্মক বা ঋণাত্মক চার্জ সমান করার জন্য প্রয়োজনীয় সংখ্যক ইলেকট্রন ($e^-$) যোগ করা।</li>
      <li><strong>ইলেকট্রন সমন্বয়:</strong> উভয় সমীকরণকে ক্ষুদ্রতম পূর্ণসংখ্যা দ্বারা গুণ করে বর্জিত ও গৃহীত ইলেকট্রন সমান করা এবং সমীকরণ দুটি যোগ করা।</li>
    </ol>
  </div>

  <div slot="applications" class="space-y-3">
    <p>
      ১. <strong>শিল্পক্ষেত্রে আয়রন ও স্টিল নিষ্কাশন:</strong> ব্লাস্ট ফার্নেসে হেমাটাইট আকরিক ($Fe_2O_3$) হতে কার্বন মনোক্সাইড দ্বারা লোহা নিষ্কাশন একটি বৃহৎ পরিসরের জারণ-বিজারণ প্রক্রিয়া।
    </p>
    <p>
      ২. <strong>ইলেকট্রোকেমিক্যাল ব্যাটারি ও লিথিয়াম-আয়ন সেল:</strong> স্মার্টফোন এবং বৈদ্যুতিক গাড়ির ব্যাটারিতে অ্যানোড ও ক্যাথোডের মধ্যে অবিরত ইলেকট্রন আদান-প্রদানের মাধ্যমেই শক্তি সঞ্চয় ও সরবরাহ ঘটে।
    </p>
    <p>
      ৩. <strong>ল্যাবরেটরি কোয়ান্টিটেটিভ টাইট্রেশন:</strong> রক্তে গ্লুকোজের মাত্রা নির্ণয়, পানিতে দ্রবীভূত অক্সিজেন (BOD ও COD) এবং পরিবেশ দূষণ মূল্যায়নে পারম্যাঙ্গানেট ও আয়োডোমেট্রিক টাইট্রেশন ব্যবহৃত হয়।
    </p>
  </div>
</ToolLayout>
