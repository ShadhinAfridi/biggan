---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import { SolutionDilutionCalculator } from '../../../tools/solution-dilution/SolutionDilutionCalculator';
import Latex from '../../../components/math/Latex.astro';

const exemplars = [
  {
    level: 'উচ্চ মাধ্যমিক রসায়ন ২য় পত্র (NCTB Class 12)',
    levelBadge: 'নমুনা ১ • প্রাইমারি স্ট্যান্ডার্ড দ্রবণ প্রস্তুতি (W = SMV/1000)',
    problemText: '২৫০ mL আয়তনের প্রমাণ ফ্লাস্কে ০.১ M সোডিয়াম কার্বনেট (Na₂CO₃) দ্রবণ প্রস্তুত করতে কত গ্রাম কঠিন Na₂CO₃ পরিমাপ করতে হবে? [আণবিক ভর M = 106 g/mol]',
    givenData: [
      'টার্গেট মোলারিটি S = 0.1 M (mol/L)',
      'ফ্লাস্কের আয়তন V = 250 mL',
      'সোডিয়াম কার্বনেটের আণবিক ভর M = (23×2) + 12 + (16×3) = 106 g/mol',
    ],
    solutionSteps: [
      'প্রমাণ দ্রবণ প্রস্তুতির সূত্র: W = (S × M × V) / 1000',
      'W = (0.1 × 106 × 250) / 1000',
      'W = 2650 / 1000 = 2.65 g',
    ],
    finalAnswer: 'প্রয়োজনীয় কঠিন Na₂CO₃ এর ভর = ২.৬৫ গ্রাম',
  },
  {
    level: 'উচ্চ মাধ্যমিক রসায়ন ২য় পত্র অধ্যায় ৩ (পরিমাণগত রসায়ন)',
    levelBadge: 'নমুনা ২ • স্টক এসিড লঘুকরণ (V₁S₁ = V₂S₂)',
    problemText: 'ল্যাবরেটরিতে থাকা ১২ M গাঢ় হাইড্রোক্লোরিক এসিড (HCl) থেকে ৫০০ mL ০.১ M লঘু HCl দ্রবণ তৈরি করতে কতটুকু স্টক এসিড ও কতটুকু পাতিত পানি যোগ করতে হবে?',
    givenData: [
      'স্টক দ্রবণের ঘনমাত্রা S₁ = 12 M',
      'কাঙ্ক্ষিত দ্রবণের ঘনমাত্রা S₂ = 0.1 M',
      'কাঙ্ক্ষিত মোট আয়তন V₂ = 500 mL',
    ],
    solutionSteps: [
      'লঘুকরণ সূত্র: V₁ × S₁ = V₂ × S₂',
      'V₁ = (V₂ × S₂) / S₁',
      'V₁ = (500 × 0.1) / 12 = 50 / 12 = 4.167 mL',
      'যোগ করতে হওয়া দ্রাবকের আয়তন = V₂ - V₁ = 500 - 4.167 = 495.83 mL',
    ],
    finalAnswer: 'প্রয়োজনীয় স্টক HCl = ৪.১৭ mL এবং পানি যোগ করতে হবে = ৪৯৫.৮৩ mL',
  },
  {
    level: 'বোর্ড ল্যাব প্র্যাকটিক্যাল ও ভর্তি পরীক্ষা (BUET / Medical)',
    levelBadge: 'নমুনা ৩ • অম্ল-ক্ষার টাইট্রেশন সমতাকরণ',
    problemText: '২০ mL ০.১ M Na₂CO₃ দ্রবণকে সম্পূর্ণ প্রশমিত করতে ২৫ mL HCl দ্রবণ প্রয়োজন হয়। ব্যবহৃত HCl এসিডের মোলার ঘনমাত্রা কত?',
    givenData: [
      'ক্ষারক Na₂CO₃ এর আয়তন V_B = 20 mL, ঘনমাত্রা S_B = 0.1 M, তুল্য সংখ্যা e_B = 2',
      'এসিড HCl এর আয়তন V_A = 25 mL, তুল্য সংখ্যা e_A = 1',
    ],
    solutionSteps: [
      'প্রশমন সমতাকরণ সমীকরণ: V_A × S_A × e_A = V_B × S_B × e_B',
      'S_A = (V_B × S_B × e_B) / (V_A × e_A)',
      'S_A = (20 × 0.1 × 2) / (25 × 1) = 4 / 25 = 0.16 M',
    ],
    finalAnswer: 'HCl দ্রবণের ঘনমাত্রা = ০.১৬ M (মোলার)',
  },
];

const faqs = [
  {
    question: 'প্রাইমারি স্ট্যান্ডার্ড পদার্থ ও সেকেন্ডারি স্ট্যান্ডার্ড পদার্থের পার্থক্য কী?',
    answer: 'প্রাইমারি স্ট্যান্ডার্ড পদার্থ (যেমন: বিশুদ্ধ অনার্দ্র Na₂CO₃, অক্সালিক এসিড ডাইহাইড্রেট) বাতাসে অপরিবর্তিত থাকে, এদের সরাসরি ওজন করে নির্দিষ্ট ঘনমাত্রার প্রমাণ দ্রবণ তৈরি করা যায়। অপরদিকে সেকেন্ডারি স্ট্যান্ডার্ড পদার্থ (যেমন: NaOH, HCl, KMnO₄) বায়ুর আর্দ্রতা বা CO₂ শোষণ করে পরিবর্তিত হয়, তাই এদের প্রস্তুত দ্রবণকে অন্য প্রমাণ দ্রবণ দিয়ে টাইট্রেশনের মাধ্যমে টাইটার নির্ণয় করে প্রমাণ করতে হয়।',
  },
  {
    question: 'W = (SMV) / 1000 সূত্রে ১০০০ দিয়ে ভাগ করা হয় কেন?',
    answer: 'মোলারিটি S-এর একক হলো mol/L বা মোল প্রতি লিটার। কিন্তু ল্যাবরেটরিতে আমরা আয়তন V সাধারণত মিলিলিটারে (mL) মেপে থাকি। মিলিলিটারকে লিটারে রূপান্তর করতে ১০০০ দ্বারা ভাগ করতে হয় (V mL / 1000 = V/1000 L)।',
  },
  {
    question: 'পিপিএম (PPM) ও মোলারিটির মধ্যে সম্পর্ক কী?',
    answer: 'PPM (Parts Per Million) এর সাধারণ একক হলো mg/L (প্রতি লিটারে কত মিলিগ্রাম দ্রাব দ্রবীভূত)। মোলারিটি (M) থেকে PPM বের করার নিয়ম: PPM = মোলারিটি (M) × আণবিক ভর (Molar Mass) × 1000। যেমন: ০.০০১ M NaOH দ্রবণের PPM = 0.001 × 40 × 1000 = 40 ppm।',
  },
];
---

<ToolLayout
  title="দ্রবণ প্রস্তুতি ও লঘুকরণ ক্যালকুলেটর (W=SMV/1000, V₁S₁=V₂S₂) — Biggan.me"
  metaDescription="অনলাইনে প্রাইমারি স্ট্যান্ডার্ড দ্রবণ প্রস্তুতি, স্টক এসিড লঘুকরণ, মোলারিটি থেকে PPM রূপান্তর ও টাইট্রেশন সমতাকরণ। NCTB একাদশ-দ্বাদশ শ্রেণি রসায়ন ২য় পত্র সিলেবাস।"
  toolName="দ্রবণ প্রস্তুতি ও লঘুকরণ ক্যালকুলেটর"
  toolCategory="রসায়ন"
  curriculumTags={['রসায়ন ২য় পত্র অধ্যায় ৩ (পরিমাণগত রসায়ন)', 'বোর্ড ল্যাব প্র্যাকটিক্যাল', 'প্রকৌশল ও মেডিকেল ভর্তি পরীক্ষা']}
  topicId="solution-dilution"
  exemplars={exemplars}
  faqs={faqs}
>
  <div slot="calculator">
    <SolutionDilutionCalculator client:load lang="bn" />
  </div>

  <div slot="theory" class="space-y-4">
    <h3 class="text-lg font-bold text-white flex items-center gap-2">
      <span>🧪</span> দ্রবণ রসায়নের মৌলিক সূত্রাবলি
    </h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
      <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2">
        <h4 class="font-semibold text-teal-400">১. নির্দিষ্ট মোলারিটির দ্রবণ প্রস্তুতি:</h4>
        <p class="text-slate-300 text-xs">
          <Latex math="W = \frac{S \times M \times V}{1000}" />
        </p>
        <p class="text-slate-400 text-xs">যেখানে W = দ্রব্যের ভর (g), S = মোলারিটি (mol/L), M = আণবিক ভর (g/mol), V = আয়তন (mL)।</p>
      </div>

      <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2">
        <h4 class="font-semibold text-teal-400">২. স্টক দ্রবণ লঘুকরণ সূত্র:</h4>
        <p class="text-slate-300 text-xs">
          <Latex math="V_1 S_1 = V_2 S_2" />
        </p>
        <p class="text-slate-400 text-xs">প্রয়োজনীয় অতিরিক্ত দ্রাবক = V₂ - V₁। এসিড লঘুকরণে পানির মধ্যে আস্তে আস্তে এসিড ঢালতে হয়।</p>
      </div>

      <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2">
        <h4 class="font-semibold text-teal-400">৩. অম্ল-ক্ষারক প্রশমন ও টাইট্রেশন:</h4>
        <p class="text-slate-300 text-xs">
          <Latex math="V_A S_A e_A = V_B S_B e_B" />
        </p>
        <p class="text-slate-400 text-xs">e_A ও e_B হলো অম্ল ও ক্ষারকের ক্ষারকত্ব ও অম্লত্ব (তুল্য সংখ্যা)। যেমন: H₂SO₄ এর e=2, NaOH এর e=1।</p>
      </div>

      <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2">
        <h4 class="font-semibold text-teal-400">৪. ঘনমাত্রার বিভিন্ন একক ও PPM:</h4>
        <p class="text-slate-300 text-xs">
          <Latex math="\text{PPM} = \text{Molarity} \times M \times 1000 = \frac{\text{mg}}{\text{L}}" />
        </p>
        <p class="text-slate-400 text-xs">%(w/v) থেকে মোলারিটি: <Latex math="S = \frac{10 \times \%}{M}" /></p>
      </div>
    </div>
  </div>
</ToolLayout>
