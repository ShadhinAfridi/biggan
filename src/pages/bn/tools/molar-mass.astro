---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import { MolarMassCalculator } from '../../../tools/molar-mass/MolarMassCalculator';
import { Latex } from '../../../components/math/Latex';

const exemplars = [
  {
    level: 'উচ্চ মাধ্যমিক পাঠ্যবই অনুশীলন (NCTB Class 11)',
    levelBadge: 'নমুনা ১ • পাঠ্যবই',
    problemText: 'তুঁতে বা ব্লু ভিট্রিওলের (CuSO₄·5H₂O) মোলার ভর এবং এতে কেলাস পানির শতকরা পরিমাণ নির্ণয় কর। [Cu=63.55, S=32.06, O=16, H=1.008]',
    givenData: [
      'যৌগের রাসায়নিক সংকেত: CuSO₄·5H₂O',
      'পারমাণবিক ভর: Cu = 63.55, S = 32.06, O = 16.00, H = 1.008',
    ],
    solutionSteps: [
      'CuSO₄ অংশের ভর = 63.55 + 32.06 + (4 × 16.00) = 159.61 g/mol',
      '5H₂O (কেলাস পানি) অংশের ভর = 5 × [(2 × 1.008) + 16.00] = 5 × 18.016 = 90.08 g/mol',
      'মোট মোলার ভর M = 159.61 + 90.08 = 249.69 g/mol',
      'কেলাস পানির শতকরা সংযুতি = (90.08 / 249.69) × 100%',
    ],
    finalAnswer: 'মোলার ভর = ২৪৯.৬৯ g/mol; কেলাস পানির শতকরা হার = ৩৬.০৮%',
  },
  {
    level: 'এডভান্সড অলিম্পিয়াড ও ভর্তি পরীক্ষা',
    levelBadge: 'নমুনা ২ • জটিল যৌগ',
    problemText: 'পটাশিয়াম ফেরোসায়ানাইড K₄[Fe(CN)₆] এর মোলার ভর ও এতে নাইট্রোজেনের শতকরা সংযুতি হিসাব কর।',
    givenData: [
      'জটিল লবণের সংকেত: K₄[Fe(CN)₆]',
      'K = 39.10, Fe = 55.85, C = 12.011, N = 14.007',
    ],
    solutionSteps: [
      'K এর ভর = 4 × 39.10 = 156.40 g/mol',
      'Fe এর ভর = 1 × 55.85 = 55.85 g/mol',
      'CN লিগ্যান্ডের ভর = 6 × (12.011 + 14.007) = 6 × 26.018 = 156.11 g/mol',
      'মোট আণবিক ভর M = 156.40 + 55.85 + 156.11 = 368.36 g/mol',
      'নাইট্রোজেনের মোট ভর = 6 × 14.007 = 84.04 g/mol',
      'N এর শতকরা হার = (84.04 / 368.36) × 100% = 22.81%',
    ],
    finalAnswer: 'মোট ভর = ৩৬৮.৩৬ g/mol; নাইট্রোজেনের শতকরা হার = ২২.৮১%',
  },
  {
    level: 'বিগত বোর্ড পরীক্ষা প্রশ্ন (ঢাকা বোর্ড)',
    levelBadge: 'নমুনা ৩ • বোর্ড পরীক্ষা',
    problemText: 'কেলাস পানিযুক্ত সোডিয়াম কার্বনেট Na₂CO₃·10H₂O কে উত্তপ্ত করলে কত শতাংশ ভরের ঘাটতি ঘটবে?',
    givenData: [
      'Na = 23, C = 12, O = 16, H = 1.008',
      'উত্তপ্ত করলে ১০ অণু কেলাস পানি বাষ্পীভূত হয়ে অপসারিত হয়।',
    ],
    solutionSteps: [
      'Na₂CO₃ এর ভর = (2 × 23) + 12 + (3 × 16) = 106 g/mol',
      '10H₂O এর ভর = 10 × 18.016 = 180.16 g/mol',
      'মোট আণবিক ভর = 106 + 180.16 = 286.16 g/mol',
      'ভরের ঘাটতির শতকরা হার = (180.16 / 286.16) × 100%',
    ],
    finalAnswer: '৬২.৯৬% ভরের ঘাটতি ঘটবে।',
  },
];

const faqs = [
  {
    question: 'মোলার ভর (Molar Mass) এবং আণবিক ভরের (Molecular Weight) মধ্যে পার্থক্য কী?',
    answer: 'আণবিক ভর হলো কোনো একটিমাত্র অণুর ভর, যা সাধারণত ডাল্টন (Da) বা amu এককে পরিমাপ করা হয়। অন্যদিকে মোলার ভর হলো এক মোল (৬.০২২ × ১০²³ টি) অণুর সামগ্রিক ভর, যা গ্রাম/মোল (g/mol) এককে প্রকাশিত হয়। সাংখ্যিকভাবে দুটি মান অভিন্ন হলেও এদের একক ও ভৌত তাৎপর্য ভিন্ন।',
  },
  {
    question: 'কেলাস পানিযুক্ত লবণে ডট (·) চিহ্নের অর্থ কী?',
    answer: 'কেলাস লবণে ডট চিহ্নটি কোনো গাণিতিক গুণন নির্দেশ করে না। এটি নির্দেশ করে যে নির্দিষ্ট ধাতব আয়ন বা লবণের ল্যাটিস কাঠামোর সাথে নির্দিষ্ট অনুপাতে পানির অণু হাইড্রোজেন বন্ধন বা সন্নিবেশ সমযোজী বন্ধনে আবদ্ধ রয়েছে। যেমন CuSO₄·5H₂O তে প্রতি মোল কপার সালফেটের সাথে ৫ মোল পানি আবদ্ধ থাকে।',
  },
  {
    question: 'মৌলের শতকরা সংযুতি যোগ করলে কি সর্বদা ১০০% হতে হবে?',
    answer: 'হ্যাঁ, একটি যৌগের সকল উপাদান মৌলের শতকরা সংযুতি যোগ করলে তাত্ত্বিকভাবে অবশ্যই ১০০% হতে হবে। তবে বিভিন্ন পাঠ্যবই বা গণনায় দশমিকের আসন্নমানের (Rounding) কারণে ৯৯.৯৯% বা ১০০.০১% হতে পারে, যা বৈজ্ঞানিকভাবে গ্রহণযোগ্য।',
  },
  {
    question: 'আইসোটোপিক তারতম্য মোলার ভরের মানে কি প্রভাব ফেলে?',
    answer: 'IUPAC স্বীকৃত স্ট্যান্ডার্ড পারমাণবিক ভর পৃথিবীর ভূত্বকে প্রাপ্ত মৌলসমূহের প্রাকৃতিক আইসোটোপিক প্রাচুর্যের গড় ভর হিসেবে নির্ধারিত হয়। কৃত্রিমভাবে সমৃদ্ধ (Enriched) কোনো যৌগে এই ভর পরিবর্তিত হতে পারে।',
  },
  {
    question: 'পরীক্ষার হলে কাসিও ক্যালকুলেটরে মোলার ভর কীভাবে দ্রুত হিসাব করব?',
    answer: 'কাসিও fx-991ES PLUS বা fx-991EX এ বারবার মৌলের পারমাণবিক ভর না লিখে A, B, C ইত্যাদি মেমরি ভ্যারিয়েবলে স্টোর করে রাখা যায়। অথবা ব্র্যাকেট ব্যবহার করে এক লাইনে পুরো সংকেত লিখে "=" চাপলে নির্ভুল উত্তর পাওয়া যায়। বিস্তারিত নিচের কি-স্ট্রোক গাইডে দেখুন।',
  },
];
---

<ToolLayout
  title="মোলার ভর ও শতকরা সংযুতি ক্যালকুলেটর — Biggan.me"
  metaDescription="কেলাস পানিযুক্ত লবণ, জটিল আয়ন ও পলিমারিক যৌগের নিখুঁত মোলার ভর (g/mol) ও মৌলসমূহের শতকরা সংযুতি নির্ণয়। NCTB ও NCERT বোর্ড সিলেবাস অনুযায়ী সম্পূর্ণ সমীকরণ ও কাসিও fx-991 কি-স্ট্রোক গাইড।"
  toolName="মোলার ভর ও শতকরা সংযুতি বিশ্লেষক"
  toolCategory="রসায়ন ও স্টয়কিওমেট্রি"
  curriculumTags={['NCTB রসায়ন ৯ম-১০ম অধ্যায় ৬', 'NCTB একাদশ-দ্বাদশ ১ম পত্র অধ্যায় ৩', 'NCERT Class 11 Chemistry Ch 1']}
  topicId="molar-mass"
  exemplars={exemplars}
  faqs={faqs}
>
  <div slot="calculator">
    <MolarMassCalculator client:load lang="bn" />
  </div>

  <div slot="derivation" class="space-y-4">
    <p>
      রসায়নবিজ্ঞানে কোনো পদার্থের নির্দিষ্ট পরিমাণ এবং তার ভরের মধ্যকার সম্পর্ক স্থাপনের সবচেয়ে মৌলিক একক হলো <strong>মোল (Mole)</strong>। ১৮১১ সালে বিজ্ঞানী অ্যামেদেও অ্যাভোগাড্রোর অনুসিদ্ধান্ত এবং পরবর্তীতে আন্তর্জাতিক পরিমাপ ব্যুরো (BIPM) কর্তৃক সংজ্ঞায়িত আধুনিক এসআই (SI) একক পদ্ধতি অনুযায়ী, কার্বন-১২ আইসোটোপের ঠিক ০.০১২ কিলোগ্রামে যতসংখ্যক পরমাণু থাকে, কোনো পদার্থের ঠিক ততসংখ্যক মৌলিক কণিকাকে <strong>১ মোল</strong> বলা হয়। এই ধ্রুব সংখ্যাটি হলো <strong>অ্যাভোগাড্রো সংখ্যা</strong> (N_A = 6.02214076 × 10²³ mol⁻¹)।
    </p>

    <h3 class="text-base font-bold text-white mt-4">মৌলিক সমীকরণ ও প্রতিপাদন</h3>
    <p>
      কোনো রাসায়নিক যৌগের সামগ্রিক মোলার ভর (M) হলো তার প্রতিটি উপাদান মৌলের পারমাণবিক ভর (M_i) এবং অণুতে সেই মৌলের পরমাণু সংখ্যার (n_i) গুণফলের সমষ্টি:
    </p>
    <div class="p-3 bg-slate-950 rounded-xl border border-slate-800 text-center font-mono text-cyan-300">
      <Latex formula={'M = \\sum_{i=1}^{k} \\left( n_i \\times M_i \\right)'} displayMode={true} />
    </div>

    <h3 class="text-base font-bold text-white mt-4">শতকরা সংযুতির সূত্র (Mass Percent Composition)</h3>
    <p>
      একটি রাসায়নিক যৌগের ১০০ ভাগে কোনো নির্দিষ্ট মৌলের যত ভাগ ভর বিদ্যমান থাকে, তাকে ঐ মৌলের শতকরা সংযুতি বলে:
    </p>
    <div class="p-3 bg-slate-950 rounded-xl border border-slate-800 text-center font-mono text-emerald-300">
      <Latex formula={'\\% \\text{ Composition} = \\frac{n_i \\times M_i}{M_{\\text{total}}} \\times 100\\%'} displayMode={true} />
    </div>

    <h3 class="text-base font-bold text-white mt-4">একক ও মাত্রা বিশ্লেষণ (Dimensional Analysis)</h3>
    <p>
      মোলার ভরের এসআই একক kg/mol, তবে ল্যাবরেটরি ও পাঠ্যপুস্তকে প্রচলিত ব্যবহারিক একক হলো g/mol। এর মাত্রীয় সংকেত [M N⁻¹]।
    </p>
  </div>

  <div slot="applications" class="space-y-3">
    <p>
      ১. <strong>ফার্মাসিউটিক্যাল ও ওষুধ শিল্প:</strong> ট্যাবলেটের সঠিক ডোজ নির্ধারণে এপিআই (Active Pharmaceutical Ingredient) এর মোলার ভর এবং আর্দ্রতা অনুপাত নিখুঁতভাবে নিয়ন্ত্রণ করা বাধ্যতামূলক। সামান্য বিচ্যুতির কারণে ওষুধের সক্রিয়তা হ্রাস পেতে পারে।
    </p>
    <p>
      ২. <strong>কৃষি ও সার উৎপাদন:</strong> ইউরিয়া ($CO(NH_2)_2$), টিএসপি এবং পটাশ সারে নাইট্রোজেন ও ফসফরাসের কার্যকর শতকরা অনুপাত নির্ধারণে মোলার ভরের সূত্র প্রয়োগ করা হয়।
    </p>
    <p>
      ৩. <strong>পরিবেশ রসায়ন ও কার্বন ফুটপ্রিন্ট:</strong> জীবাশ্ম জ্বালানি দহনে উৎপন্ন গ্রিনহাউস গ্যাসের ভর হিসাব করতে স্টয়কিওমেট্রি ও মোলার ভর বিশ্লেষণ অপরিহার্য।
    </p>
  </div>
</ToolLayout>
