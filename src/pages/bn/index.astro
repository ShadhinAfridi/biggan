---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/ads/AdSlot.astro';
import { getLocalizedPath } from '../../i18n/utils';
import { QuickSolverPreview } from '../../components/home/QuickSolverPreview';

const sscSubjects = [
  {
    id: 'physics',
    name: 'পদার্থবিজ্ঞান',
    chapters: '১৩টি অধ্যায়',
    topics: 'গতি, বল (F=ma), কাজ-শক্তি, পদার্থের অবস্থা ও চাপ, তরঙ্গ ও শব্দ, আলো, চলবিদ্যুৎ',
    link: getLocalizedPath('/tools/physics', 'bn'),
    icon: '⚡',
    color: 'border-blue-500/40 text-blue-400 bg-blue-500/10',
  },
  {
    id: 'higher-math',
    name: 'উচ্চতর গণিত',
    chapters: '১৪টি অধ্যায়',
    topics: 'এ্যাপোলোনিওস উপপাদ্য, দ্বিঘাত সমীকরণ, অসীম গুণোত্তর ধারা, দ্বিপদী বিস্তৃতি, স্থানাঙ্ক জ্যামিতি',
    link: getLocalizedPath('/tools/higher-math', 'bn'),
    icon: '📐',
    color: 'border-amber-500/40 text-amber-400 bg-amber-500/10',
  },
  {
    id: 'chemistry',
    name: 'রসায়ন',
    chapters: '১২টি অধ্যায়',
    topics: 'মোল ধারণা, মোলারিটি (S=1000w/MV), ব্যাপন হার, বোর মডেল, সীমিত বিক্রিয়ক, বন্ধন শক্তি (ΔH), pH',
    link: getLocalizedPath('/tools/chemistry', 'bn'),
    icon: '⚗️',
    color: 'border-emerald-500/40 text-emerald-400 bg-emerald-500/10',
  },
  {
    id: 'general-math',
    name: 'সাধারণ গণিত ও পরিসংখ্যান',
    chapters: 'বোর্ড স্পেশাল',
    topics: 'ক্রমযোজিত গণসংখ্যা সারণী, সংক্ষিপ্ত গড়, মধ্যক, প্রচুরক, ত্রিকোণমিতিক উচ্চতা-দূরত্ব, পরিমিতি',
    link: getLocalizedPath('/tools/general-math', 'bn'),
    icon: '➕',
    color: 'border-cyan-500/40 text-cyan-400 bg-cyan-500/10',
  },
  {
    id: 'biology',
    name: 'জীববিজ্ঞান',
    chapters: '১৪টি অধ্যায়',
    topics: 'বিএমআই, হ্যারিস-বেনেডিক্ট BMR ও ক্যালোরি, গ্লুকোজ জারণে নিট ৩৮ ATP, ২×২ পুনেট স্কয়ার',
    link: getLocalizedPath('/tools/biology', 'bn'),
    icon: '🧬',
    color: 'border-rose-500/40 text-rose-400 bg-rose-500/10',
  },
];

const hscTools = [
  {
    name: 'লজিক গেট সার্কিট ডিজাইনার',
    desc: 'AND, OR, NOT, NAND, NOR, XOR গেটের লাইভ ট্রুথ টেবিল ও আউটপুট ভোল্টেজ',
    link: getLocalizedPath('/tools/circuit-simulator', 'bn'),
    icon: '🔌',
  },
  {
    name: 'সি প্রোগ্রামিং মেমরি ড্রাই-রান',
    desc: 'লুপ ও কন্ডিশনাল কোডের ধাপে ধাপে এক্সিকিউশন ও লাইভ RAM ভ্যারিয়েবল টেবিল',
    link: getLocalizedPath('/tools/c-runner', 'bn'),
    icon: '💻',
  },
  {
    name: 'HTML5 এডিটর ও লাইভ প্রিভিউ',
    desc: 'এইচএসসি ৩য় অধ্যায়ের ট্যাগ ও টেবিল কোডিং সরাসরি ব্রাউজারে অনুশীলন',
    link: getLocalizedPath('/tools/html-runner', 'bn'),
    icon: '🌐',
  },
  {
    name: 'SQL ডেটাবেজ সিমুলেটর',
    desc: 'SELECT, WHERE, JOIN এবং ডেটাবেজ রিলেশনশিপ টেবিল কোয়েরি সিমুলেটর',
    link: getLocalizedPath('/tools/database-simulator', 'bn'),
    icon: '🗄️',
  },
];
---

<BaseLayout
  title="Biggan.me — বিজ্ঞান ও গণিত সমস্যা সমাধান ও গাণিতিক টুলস"
  description="NCTB ৯ম-১০ম ও একাদশ-দ্বাদশ শ্রেণির পদার্থবিজ্ঞান, উচ্চতর গণিত, রসায়ন, জীববিজ্ঞান ও আইসিটির প্রতিটি অধ্যায়ের নির্ভুল হিসাব, সূত্র এবং অনুমোদিত কাসিও fx-991 কি-স্ট্রোক সহায়িকা।"
  lang="bn"
>
  <div class="space-y-16">
    <!-- Asymmetric Product-First Hero Section -->
    <section class="pt-4 sm:pt-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
        <!-- Left Column: Grounded Editorial Value & Fast Jumps -->
        <div class="lg:col-span-7 space-y-5 text-left">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-900 border border-slate-800 text-slate-300 text-xs font-mono">
            <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
            NCTB ৯ম-১০ম ও একাদশ-দ্বাদশ শ্রেণি
          </div>

          <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight">
            বিজ্ঞান ও গণিতের সমস্যা <br class="hidden sm:inline" />
            সমাধান করুন ধাপে ধাপে
          </h1>

          <p class="text-base text-slate-300 leading-relaxed max-w-xl">
            পদার্থবিজ্ঞান, রসায়ন, উচ্চতর গণিত, সাধারণ গণিত ও জীববিজ্ঞানের প্রতিটি অধ্যায়ের নির্ভুল হিসাব — সূত্র প্রতিপাদন, এসআই একক এবং অনুমোদিত কাসিও fx-991 ক্যালকুলেটরের কি-স্ট্রোকসহ।
          </p>

          <!-- Quick Subject Filter Pills -->
          <div class="space-y-2 pt-1">
            <span class="text-[11px] font-mono text-slate-400 uppercase tracking-wider block">
              সরাসরি বিষয়ে যান:
            </span>
            <div class="flex flex-wrap gap-2">
              <a href={getLocalizedPath('/tools/physics', 'bn')} class="px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 text-xs font-medium text-slate-200 border border-slate-800 hover:border-slate-700 transition flex items-center gap-1.5">
                <span>⚡</span> পদার্থবিজ্ঞান
              </a>
              <a href={getLocalizedPath('/tools/chemistry', 'bn')} class="px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 text-xs font-medium text-slate-200 border border-slate-800 hover:border-slate-700 transition flex items-center gap-1.5">
                <span>⚗️</span> রসায়ন
              </a>
              <a href={getLocalizedPath('/tools/higher-math', 'bn')} class="px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 text-xs font-medium text-slate-200 border border-slate-800 hover:border-slate-700 transition flex items-center gap-1.5">
                <span>📐</span> উচ্চতর গণিত
              </a>
              <a href={getLocalizedPath('/tools/general-math', 'bn')} class="px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 text-xs font-medium text-slate-200 border border-slate-800 hover:border-slate-700 transition flex items-center gap-1.5">
                <span>➕</span> সাধারণ গণিত
              </a>
              <a href={getLocalizedPath('/tools/biology', 'bn')} class="px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 text-xs font-medium text-slate-200 border border-slate-800 hover:border-slate-700 transition flex items-center gap-1.5">
                <span>🧬</span> জীববিজ্ঞান
              </a>
              <a href={getLocalizedPath('/tools/c-runner', 'bn')} class="px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 text-xs font-medium text-slate-200 border border-slate-800 hover:border-slate-700 transition flex items-center gap-1.5">
                <span>💻</span> আইসিটি
              </a>
            </div>
          </div>

          <!-- Secondary Links -->
          <div class="flex flex-wrap items-center gap-3 pt-2">
            <a
              href={getLocalizedPath('/tools', 'bn')}
              class="px-5 py-2.5 rounded-xl bg-cyan-600 hover:bg-cyan-500 text-slate-950 font-bold text-xs transition"
            >
              সকল ১৪টি ক্যালকুলেটর দেখুন →
            </a>
            <a
              href={getLocalizedPath('/formulas', 'bn')}
              class="px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-850 text-slate-300 border border-slate-800 text-xs font-medium transition"
            >
              সূত্র সংকলন (Formula Sheet)
            </a>
          </div>
        </div>

        <!-- Right Column: Actual Live Working Product Demo Widget -->
        <div class="lg:col-span-5">
          <QuickSolverPreview client:load lang="bn" />
        </div>
      </div>
    </section>

    <!-- Ad Placeholder -->
    <AdSlot slotType="banner" slotId="home-hero-bottom" />

    <!-- Section 1: SSC Class 9-10 Subject Directory -->
    <section class="space-y-6">
      <div class="border-b border-slate-800 pb-3 flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-white flex items-center gap-2">
            <span>📚</span> এসএসসি বিষয়ভিত্তিক ক্যালকুলেটর (৯ম-১০ম শ্রেণি)
          </h2>
          <p class="text-xs text-slate-400 mt-0.5">
            NCTB পাঠ্যবইয়ের প্রতিটি অধ্যায়ের সূত্র, চলক পরিবর্তন ও ধাপসহ সমাধান
          </p>
        </div>
        <span class="text-xs font-mono text-slate-500">৫টি মূল বিষয়</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {sscSubjects.map((sub) => (
          <a
            href={sub.link}
            class="p-5 rounded-2xl bg-slate-900/90 border border-slate-800 hover:border-slate-700 transition flex flex-col justify-between space-y-4 group"
          >
            <div class="space-y-2.5">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2.5">
                  <span class="text-2xl">{sub.icon}</span>
                  <h3 class="font-bold text-white text-base group-hover:text-cyan-400 transition">
                    {sub.name}
                  </h3>
                </div>
                <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-slate-950 text-slate-400 border border-slate-800">
                  {sub.chapters}
                </span>
              </div>

              <p class="text-xs text-slate-400 leading-relaxed">
                {sub.topics}
              </p>
            </div>

            <div class="pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs text-slate-400 group-hover:text-cyan-400 transition">
              <span>ক্যালকুলেটর খুলুন</span>
              <span>→</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Section 2: HSC Class 11-12 ICT Simulators -->
    <section class="space-y-6">
      <div class="border-b border-slate-800 pb-3 flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-white flex items-center gap-2">
            <span>💻</span> এইচএসসি আইসিটি সিমুলেটর ল্যাব (একাদশ-দ্বাদশ শ্রেণি)
          </h2>
          <p class="text-xs text-slate-400 mt-0.5">
            লজিক গেট, সি প্রোগ্রামিং মেমরি ড্রাই-রান, এইচটিএমএল এবং এসকিউএল অনুশীলন
          </p>
        </div>
        <span class="text-xs font-mono text-slate-500">৪টি ল্যাব সিমুলেটর</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {hscTools.map((tool) => (
          <a
            href={tool.link}
            class="p-4 rounded-xl bg-slate-900/70 border border-slate-800 hover:border-slate-700 transition flex flex-col justify-between space-y-3 group"
          >
            <div class="space-y-2">
              <span class="text-2xl block">{tool.icon}</span>
              <h3 class="font-bold text-white text-sm group-hover:text-cyan-400 transition">
                {tool.name}
              </h3>
              <p class="text-xs text-slate-400 leading-relaxed">
                {tool.desc}
              </p>
            </div>
            <span class="text-xs text-cyan-400 font-medium pt-2">
              সিমুলেটর চালু করুন →
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Section 3: Essential Study & Revision Hubs -->
    <section class="bg-slate-900/60 border border-slate-800 rounded-2xl p-6 sm:p-8 space-y-6">
      <div class="border-b border-slate-800 pb-3">
        <h2 class="text-lg sm:text-xl font-bold text-white">
          দ্রুত রিভিশন ও রেফারেন্স টুলস
        </h2>
        <p class="text-xs text-slate-400 mt-0.5">
          পরীক্ষার প্রস্তুতি ও বোর্ড পরীক্ষার জন্য জরুরি রেফারেন্স সংকলন
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
        <a
          href={getLocalizedPath('/periodic-table', 'bn')}
          class="p-4 rounded-xl bg-slate-950 border border-slate-800 hover:border-slate-700 transition space-y-2 block"
        >
          <div class="flex items-center gap-2">
            <span class="text-xl">🧪</span>
            <h3 class="font-bold text-white text-sm">১১৮ মৌলের পর্যায় সারণি</h3>
          </div>
          <p class="text-slate-400 leading-relaxed">
            IUPAC স্বীকৃত ১১৮টি মৌল, ছন্দে ছন্দে মনে রাখার টেকনিক, ল্যাটিন নাম ও যোজ্যতা চার্ট।
          </p>
          <span class="text-cyan-400 font-medium inline-block pt-1">সারণি দেখুন →</span>
        </a>

        <a
          href={getLocalizedPath('/formulas', 'bn')}
          class="p-4 rounded-xl bg-slate-950 border border-slate-800 hover:border-slate-700 transition space-y-2 block"
        >
          <div class="flex items-center gap-2">
            <span class="text-xl">📜</span>
            <h3 class="font-bold text-white text-sm">সূত্র সংকলন (Formula Sheet)</h3>
          </div>
          <p class="text-slate-400 leading-relaxed">
            পদার্থ, রসায়ন, গণিত ও আইসিটির প্রয়োজনীয় সব সূত্র এক পাতায় — প্রিন্ট ও পিডিএফ উপযোগী।
          </p>
          <span class="text-cyan-400 font-medium inline-block pt-1">সূত্রাবলী দেখুন →</span>
        </a>

        <a
          href={getLocalizedPath('/my-progress', 'bn')}
          class="p-4 rounded-xl bg-slate-950 border border-slate-800 hover:border-slate-700 transition space-y-2 block"
        >
          <div class="flex items-center gap-2">
            <span class="text-xl">✅</span>
            <h3 class="font-bold text-white text-sm">অধ্যায় রিভিশন ট্র্যাকার</h3>
          </div>
          <p class="text-slate-400 leading-relaxed">
            কোন কোন অধ্যায় সমাধান ও রিভিশন সম্পন্ন হলো তা ব্রাউজারেই চিহ্নিত করে রাখার ব্যবস্থা।
          </p>
          <span class="text-cyan-400 font-medium inline-block pt-1">অগ্রগতি দেখুন →</span>
        </a>
      </div>
    </section>

    <!-- Section 4: Authentic Curriculum Standards (Zero Fake Social Proof) -->
    <section class="border border-slate-800/80 rounded-2xl p-6 bg-slate-950 text-xs text-slate-400 space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-800 pb-3">
        <span class="font-bold text-slate-300 text-sm">
          পাঠ্যবই ও পরীক্ষার মানদণ্ড (Curriculum Conventions)
        </span>
        <span class="font-mono text-[11px] text-slate-500">
          NCTB SSC & HSC Syllabus Mapped
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 font-mono">
        <div class="space-y-1">
          <span class="text-slate-500 block text-[10px]">অভিকর্ষজ ত্বরণ:</span>
          <span class="text-slate-200 font-semibold">g = 9.8 m/s²</span>
        </div>
        <div class="space-y-1">
          <span class="text-slate-500 block text-[10px]">অ্যাভোগাড্রো সংখ্যা:</span>
          <span class="text-slate-200 font-semibold">N_A = 6.023 × 10²³</span>
        </div>
        <div class="space-y-1">
          <span class="text-slate-500 block text-[10px]">STP তে মোলার আয়তন:</span>
          <span class="text-slate-200 font-semibold">V_m = 22.4 L/mol</span>
        </div>
        <div class="space-y-1">
          <span class="text-slate-500 block text-[10px]">পানির ঘনত্ব (4°C):</span>
          <span class="text-slate-200 font-semibold">ρ = 1000 kg/m³</span>
        </div>
      </div>

      <p class="text-slate-500 pt-1 border-t border-slate-900 text-[11px]">
        বি. দ্র.: সকল ক্যালকুলেশন ক্লায়েন্ট-সাইডে সম্পন্ন হয়। কোনো ব্যক্তিগত ডেটা সংগ্রহ বা লগইন করার প্রয়োজন নেই।
      </p>
    </section>
  </div>
</BaseLayout>
