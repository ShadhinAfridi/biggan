---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AdSlot from '../../../components/ads/AdSlot.astro';
import { getSubjectsByLevel } from '../../../data/curriculum';
import { getLocalizedPath } from '../../../i18n/utils';

const hscSubjects = getSubjectsByLevel('hsc');
const sscSubjects = getSubjectsByLevel('ssc');
---

<BaseLayout
  title="এনসিটিবি কারিকুলাম ও বিষয়ভিত্তিক অধ্যায় নির্দেশিকা (SSC & HSC) — Biggan.me"
  description="বাংলাদেশ জাতীয় শিক্ষাক্রম ও পাঠ্যপুস্তক বোর্ড (NCTB) অনুমোদিত এসএসসি ও এইচএসসি বিজ্ঞান ও আইসিটি বিষয়ের অধ্যায়ভিত্তিক সিলেবাস, সৃজনশীল নম্বর বণ্টন ও ইন্টারঅ্যাক্টিভ সিমুলেটর।"
  lang="bn"
>
  <div class="space-y-12">
    <!-- Header -->
    <div class="space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 text-xs font-mono">
        কারিকুলাম ও বোর্ড সিলেবাস ডিরেক্টরি
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
        বিষয়ভিত্তিক অধ্যায় ও টপিক গাইড
      </h1>
      <p class="text-base text-slate-400 max-w-3xl leading-relaxed">
        জাতীয় শিক্ষাক্রম ও পাঠ্যপুস্তক বোর্ড (NCTB) অনুযায়ী এসএসসি (৯ম-১০ম) এবং এইচএসসি (১১শ-১২শ) বিজ্ঞান বিভাগের ৬টি মূল বিষয়ের বোর্ড প্রশ্নের ধরন, CQ ও MCQ নম্বর বণ্টন, মৌলিক সূত্রাবলী এবং সংশ্লিষ্ট লাইভ সিমুলেটর।
      </p>
    </div>

    <!-- Ad placeholder -->
    <AdSlot slotType="banner" slotId="curriculum-index-top" />

    <!-- HSC Section -->
    <div class="space-y-6">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-800 pb-4">
        <div>
          <span class="text-xs font-mono text-cyan-400 uppercase tracking-wider font-semibold">উচ্চ মাধ্যমিক স্তর</span>
          <h2 class="text-2xl sm:text-3xl font-bold text-white flex items-center gap-3 mt-1">
            <span>🎓</span> এইচএসসি (HSC) — একাদশ ও দ্বাদশ শ্রেণি
          </h2>
        </div>
        <span class="text-xs font-mono text-cyan-300 bg-cyan-950 px-3 py-1 rounded-full border border-cyan-800">
          {hscSubjects.length}টি বিষয় তালিকাভুক্ত
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {hscSubjects.map((subject) => (
          <div class="bg-slate-900 border border-slate-800 hover:border-cyan-500/40 rounded-2xl p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-cyan-950/20 flex flex-col justify-between">
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="text-3xl p-2.5 rounded-xl bg-slate-950 border border-slate-800">
                  {subject.icon}
                </span>
                <span class="text-[11px] font-mono px-2.5 py-0.5 rounded-full bg-slate-950 text-cyan-400 border border-slate-800">
                  কোড: {subject.code}
                </span>
              </div>

              <div>
                <h3 class="text-xl font-bold text-white leading-snug">
                  {subject.nameBn}
                </h3>
                <p class="text-xs text-slate-400 font-mono mt-0.5">
                  {subject.nameEn}
                </p>
              </div>

              <p class="text-xs text-slate-300 leading-relaxed line-clamp-3">
                {subject.descriptionBn}
              </p>

              <div class="bg-slate-950/60 rounded-xl p-3 border border-slate-800/80 text-xs space-y-1.5 font-mono">
                <div class="flex justify-between text-slate-400">
                  <span>অধ্যায় সংখ্যা:</span>
                  <span class="text-cyan-400 font-bold">{subject.chapters.length}টি অধ্যায়</span>
                </div>
                <div class="flex justify-between text-slate-400">
                  <span>বোর্ড পরীক্ষা:</span>
                  <span class="text-slate-300">১০০ নম্বর (CQ ৫০/৭০ + MCQ ২৫/৩০)</span>
                </div>
              </div>
            </div>

            <div class="pt-5 mt-5 border-t border-slate-800/80">
              <a
                href={getLocalizedPath(`/curriculum/${subject.level}/${subject.id}`, 'bn')}
                class="w-full flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-400 text-xs font-semibold border border-cyan-500/30 transition-colors"
              >
                অধ্যায় ও সূত্রাবলী দেখুন →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- SSC Section -->
    <div class="space-y-6 pt-6">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-800 pb-4">
        <div>
          <span class="text-xs font-mono text-emerald-400 uppercase tracking-wider font-semibold">মাধ্যমিক স্তর</span>
          <h2 class="text-2xl sm:text-3xl font-bold text-white flex items-center gap-3 mt-1">
            <span>🏫</span> এসএসসি (SSC) — নবম ও দশম শ্রেণি
          </h2>
        </div>
        <span class="text-xs font-mono text-emerald-300 bg-emerald-950 px-3 py-1 rounded-full border border-emerald-800">
          {sscSubjects.length}টি বিষয় তালিকাভুক্ত
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sscSubjects.map((subject) => (
          <div class="bg-slate-900 border border-slate-800 hover:border-emerald-500/40 rounded-2xl p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-emerald-950/20 flex flex-col justify-between">
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="text-3xl p-2.5 rounded-xl bg-slate-950 border border-slate-800">
                  {subject.icon}
                </span>
                <span class="text-[11px] font-mono px-2.5 py-0.5 rounded-full bg-slate-950 text-emerald-400 border border-slate-800">
                  কোড: {subject.code}
                </span>
              </div>

              <div>
                <h3 class="text-xl font-bold text-white leading-snug">
                  {subject.nameBn}
                </h3>
                <p class="text-xs text-slate-400 font-mono mt-0.5">
                  {subject.nameEn}
                </p>
              </div>

              <p class="text-xs text-slate-300 leading-relaxed line-clamp-3">
                {subject.descriptionBn}
              </p>

              <div class="bg-slate-950/60 rounded-xl p-3 border border-slate-800/80 text-xs space-y-1.5 font-mono">
                <div class="flex justify-between text-slate-400">
                  <span>অধ্যায় সংখ্যা:</span>
                  <span class="text-emerald-400 font-bold">{subject.chapters.length}টি অধ্যায়</span>
                </div>
                <div class="flex justify-between text-slate-400">
                  <span>বোর্ড পরীক্ষা:</span>
                  <span class="text-slate-300">১০০ নম্বর (CQ ৫০/৭০ + MCQ ২৫/৩০)</span>
                </div>
              </div>
            </div>

            <div class="pt-5 mt-5 border-t border-slate-800/80">
              <a
                href={getLocalizedPath(`/curriculum/${subject.level}/${subject.id}`, 'bn')}
                class="w-full flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 text-xs font-semibold border border-emerald-500/30 transition-colors"
              >
                অধ্যায় ও সূত্রাবলী দেখুন →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
