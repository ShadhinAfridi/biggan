---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/ads/AdSlot.astro';
import { PeriodicTableIsland } from '../../components/periodic-table/PeriodicTableIsland';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "পর্যায় সারণিতে মোট কয়টি মৌল, পর্যায় এবং গ্রুপ রয়েছে?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "আধুনিক IUPAC অনুমোদিত পর্যায় সারণিতে সর্বমোট ১১৮টি মৌল রয়েছে। এর মধ্যে ৭টি আনুভূমিক পর্যায় (Periods) এবং ১৮টি খাড়া স্তম্ভ বা গ্রুপ (Groups) রয়েছে। ১ থেকে ৯৪ নং মৌল পর্যন্ত প্রকৃতিতে পাওয়া যায় এবং ৯৫ থেকে ১১৮ নং মৌলগুলো কৃত্রিম বা গবেষণাগারে তৈরি।"
      }
    },
    {
      "@type": "Question",
      "name": "ক্রোমিয়াম (Cr) এবং কপার (Cu) এর ক্ষেত্রে আউফবাউ নীতির ব্যতিক্রম ঘটে কেন?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "সমশক্তি সম্পন্ন d-অরবিটাল অর্ধপূর্ণ (d⁵) বা সম্পূর্ণ পূর্ণ (d¹⁰) অবস্থায় সর্বাধিক প্রতিসাম্য এবং উচ্চ এক্সচেঞ্জ শক্তির কারণে বিশেষ স্থায়িত্ব অর্জন করে। তাই ক্রোমিয়ামের সাধারণ বিন্যাস [Ar] 3d⁴ 4s² না হয়ে 4s হতে একটি ইলেকট্রন 3d তে স্থানান্তরিত হয়ে অধিক স্থিতিশীল [Ar] 3d⁵ 4s¹ হয়। একইভাবে কপারের ক্ষেত্রে [Ar] 3d⁹ 4s² এর বদলে [Ar] 3d¹⁰ 4s¹ হয়।"
      }
    },
    {
      "@type": "Question",
      "name": "ক্লোরিনের ইলেকট্রন আসক্তি ফ্লোরিনের চেয়ে বেশি হয় কেন?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "ফ্লোরিনের পারমাণবিক আকার ২য় শক্তিস্তরে অত্যন্ত ক্ষুদ্র হওয়ায় এর সর্ববহিস্থ স্তরে ইলেকট্রন ঘনত্ব অনেক বেশি থাকে। ফলে নতুন ইলেকট্রন প্রবেশকালে তীব্র আন্তঃইলেকট্রনীয় বিকর্ষণ বল কাজ করে। পক্ষান্তরে ক্লোরিনের ৩য় শক্তিস্তরের আকার তুলনামূলক বড় হওয়ায় ইলেকট্রন ঘনত্ব অপেক্ষাকৃত কম এবং ইলেকট্রন সহজে প্রবেশ করতে পারে। ফলে ক্লোরিনের ইলেকট্রন আসক্তি (-৩৪৯ kJ/mol) ফ্লোরিনের (-৩২৮ kJ/mol) চেয়ে বেশি।"
      }
    },
    {
      "@type": "Question",
      "name": "কক্ষ তাপমাত্রায় (STP) তরল থাকে এমন মৌল কোনগুলো?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "কক্ষ তাপমাত্রায় স্বাভাবিকভাবে মাত্র দুটি মৌল তরল অবস্থায় থাকে: ধাতুর মধ্যে পারদ বা মার্কারি (Hg, পারমাণবিক সংখ্যা ৮০) এবং অধাতুর মধ্যে ব্রোমিন (Br, পারমাণবিক সংখ্যা ৩৫)। এছাড়া মানবদেহের সামান্য উষ্ণতায় গ্যালিয়াম (Ga) এবং সিজিয়াম (Cs) গলে তরল হয়ে যায়।"
      }
    },
    {
      "@type": "Question",
      "name": "পর্যায় সারণির কোন মৌলের তড়িৎ ঋণাত্মকতা সবচেয়ে বেশি?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "পাউলিং স্কেলে ফ্লোরিনের (F) তড়িৎ ঋণাত্মকতার মান ৩.৯৮ (বা প্রায় ৪.০), যা পর্যায় সারণির সমস্ত মৌলের মধ্যে সর্বোচ্চ। সমযোজী বন্ধনের ইলেকট্রন জোড়কে নিজের দিকে আকর্ষণ করার ক্ষমতা ফ্লোরিনের সবচেয়ে বেশি।"
      }
    }
  ]
};
const datasetSchema = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": "118 IUPAC Elements Complete Periodic Table Dataset",
  "description": "Comprehensive periodic table database featuring 118 chemical elements with IUPAC standard atomic weights, authentic Bengali phonetic names, Latin origins, electronegativity, atomic radii, ionization energies, and subshell electron configurations.",
  "keywords": [
    "periodic table",
    "পর্যায় সারণি",
    "IUPAC",
    "chemistry",
    "atomic mass",
    "electron configuration",
    "NCTB",
    "SSC",
    "HSC"
  ],
  "creator": {
    "@type": "Organization",
    "name": "Biggan.me",
    "url": "https://biggan.me"
  },
  "license": "https://creativecommons.org/licenses/by-nc/4.0/"
};
---

<BaseLayout
  title="পর্যায় সারণি (১১৮টি মৌল): ছন্দ, যোজ্যতা ও ব্যতিক্রম — Biggan.me"
  description="IUPAC স্বীকৃত পূর্ণাঙ্গ ১১৮টি মৌলের ইন্টারেক্টিভ পর্যায় সারণী। খাঁটি বাংলা উচ্চারণ, ছন্দে ছন্দে মনে রাখার টেকনিক, ল্যাটিন নাম, যোজ্যতা চার্ট ও NCTB বোর্ড পরীক্ষার আউফবাউ ব্যতিক্রম।"
  lang="bn"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(datasetSchema)} />

  <div class="space-y-12 max-w-7xl mx-auto px-2 sm:px-4">
    <!-- Header Section -->
    <div class="space-y-4 text-center sm:text-left">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 text-xs font-mono font-semibold">
        রসায়ন রেফারেন্স হাব • NCTB ও IUPAC স্বীকৃত
      </div>
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-tight">
        ইন্টারেক্টিভ পর্যায় সারণি ও রসায়ন সহায়িকা
      </h1>
      <p class="text-base sm:text-lg text-slate-300 max-w-4xl leading-relaxed">
        আধুনিক ১১৮টি মৌলের বিশদ ডেটাবেস, খাঁটি বাংলা উচ্চারণ, ছন্দে ছন্দে মুখস্থ করার উপায়, ল্যাটিন নামের চার্ট, আউফবাউ নিয়মের ব্যতিক্রম এবং এসএসসি ও এইচএসসি বোর্ড পরীক্ষার প্রস্তুতি কুইজ।
      </p>
    </div>

    <!-- Interactive Island -->
    <PeriodicTableIsland client:load lang="bn" />

    <!-- Ad Placeholder Mid-Content -->
    <AdSlot slotType="banner" slotId="ptable-mid" />

    <!-- Section 1: Mnemonics / ছন্দে ছন্দে পর্যায় সারণি -->
    <section class="bg-slate-900/80 border border-slate-800 rounded-3xl p-6 sm:p-9 space-y-7 shadow-xl">
      <div class="border-b border-slate-800 pb-4">
        <span class="text-cyan-400 font-mono text-xs uppercase tracking-wider block font-semibold">স্মৃতিসহায়ক টেকনিক</span>
        <h2 class="text-2xl sm:text-3xl font-black text-white flex items-center gap-2.5 mt-1">
          <span class="w-3 h-3 rounded-full bg-cyan-400"></span>
          ছন্দে ছন্দে পর্যায় সারণি মুখস্থ করার সহজ উপায়
        </h2>
        <p class="text-sm text-slate-400 mt-2">
          NCTB এসএসসি ও এইচএসসি শিক্ষার্থীদের জন্য প্রতিটি গুরুত্বপূর্ণ গ্রুপ এবং পর্যায়ের মৌলসমূহ মনে রাখার ঐতিহ্যবাহী জনপ্রিয় ছন্দ:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 text-xs sm:text-sm">
        <div class="p-5 bg-slate-950/70 border border-rose-500/30 rounded-2xl space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="font-bold text-rose-300 text-base">গ্রুপ ১ (ক্ষার ধাতু)</h3>
            <span class="text-[11px] font-mono text-slate-500">H, Li, Na, K, Rb, Cs, Fr</span>
          </div>
          <p class="text-slate-300 italic font-serif text-sm">
            "হাই লিনা কে রুবি সাজাবে ফ্রান্সে"
          </p>
          <div class="text-[11px] text-slate-400 pt-1 border-t border-slate-800 font-mono">
            H (হাই), Li (লি), Na (না), K (কে), Rb (রুবি), Cs (সাজাবে), Fr (ফ্রান্সে)
          </div>
        </div>

        <div class="p-5 bg-slate-950/70 border border-amber-500/30 rounded-2xl space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="font-bold text-amber-300 text-base">গ্রুপ ২ (মৃৎক্ষার ধাতু)</h3>
            <span class="text-[11px] font-mono text-slate-500">Be, Mg, Ca, Sr, Ba, Ra</span>
          </div>
          <p class="text-slate-300 italic font-serif text-sm">
            "বিরিয়ানি মোগলাই কাবাব সরিয়ে বাটিতে রাখো"
          </p>
          <div class="text-[11px] text-slate-400 pt-1 border-t border-slate-800 font-mono">
            Be (বিরিয়ানি), Mg (মোগলাই), Ca (কাবাব), Sr (সরিয়ে), Ba (বাটিতে), Ra (রাখো)
          </div>
        </div>

        <div class="p-5 bg-slate-950/70 border border-emerald-500/30 rounded-2xl space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="font-bold text-emerald-300 text-base">গ্রুপ ১৩ (বোরন গ্রুপ)</h3>
            <span class="text-[11px] font-mono text-slate-500">B, Al, Ga, In, Tl</span>
          </div>
          <p class="text-slate-300 italic font-serif text-sm">
            "বাংলাদেশী আলী গেল ইন্ডিয়া ও থাইল্যান্ড"
          </p>
          <div class="text-[11px] text-slate-400 pt-1 border-t border-slate-800 font-mono">
            B (বাংলাদেশী), Al (আলী), Ga (গেল), In (ইন্ডিয়া), Tl (থাইল্যান্ড)
          </div>
        </div>

        <div class="p-5 bg-slate-950/70 border border-teal-500/30 rounded-2xl space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="font-bold text-teal-300 text-base">গ্রুপ ১৪ (কার্বন গ্রুপ)</h3>
            <span class="text-[11px] font-mono text-slate-500">C, Si, Ge, Sn, Pb</span>
          </div>
          <p class="text-slate-300 italic font-serif text-sm">
            "কাঁদলে সিলিকন জার্মেনিয়াম স্নেক পাবে"
          </p>
          <div class="text-[11px] text-slate-400 pt-1 border-t border-slate-800 font-mono">
            C (কাঁদলে), Si (সিলিকন), Ge (জার্মেনিয়াম), Sn (স্নেক), Pb (পাবে)
          </div>
        </div>

        <div class="p-5 bg-slate-950/70 border border-sky-500/30 rounded-2xl space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="font-bold text-sky-300 text-base">গ্রুপ ১৫ (নিকটোজেন)</h3>
            <span class="text-[11px] font-mono text-slate-500">N, P, As, Sb, Bi</span>
          </div>
          <p class="text-slate-300 italic font-serif text-sm">
            "নাই প্রিয়া আজ সব ভুলেছি"
          </p>
          <div class="text-[11px] text-slate-400 pt-1 border-t border-slate-800 font-mono">
            N (নাই), P (প্রিয়া), As (আজ), Sb (সব), Bi (ভুলেছি)
          </div>
        </div>

        <div class="p-5 bg-slate-950/70 border border-lime-500/30 rounded-2xl space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="font-bold text-lime-300 text-base">গ্রুপ ১৬ (চ্যালকোজেন)</h3>
            <span class="text-[11px] font-mono text-slate-500">O, S, Se, Te, Po</span>
          </div>
          <p class="text-slate-300 italic font-serif text-sm">
            "ও এস এস সি তে পড়ে"
          </p>
          <div class="text-[11px] text-slate-400 pt-1 border-t border-slate-800 font-mono">
            O (ও), S (এস), Se (এস), Te (তে), Po (পড়ে)
          </div>
        </div>

        <div class="p-5 bg-slate-950/70 border border-violet-500/30 rounded-2xl space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="font-bold text-violet-300 text-base">গ্রুপ ১৭ (হ্যালোজেন)</h3>
            <span class="text-[11px] font-mono text-slate-500">F, Cl, Br, I, At</span>
          </div>
          <p class="text-slate-300 italic font-serif text-sm">
            "ফেল করলে ব্রাদার ইন্ডিয়া আসবে"
          </p>
          <div class="text-[11px] text-slate-400 pt-1 border-t border-slate-800 font-mono">
            F (ফেল), Cl (করলে), Br (ব্রাদার), I (ইন্ডিয়া), At (আসবে)
          </div>
        </div>

        <div class="p-5 bg-slate-950/70 border border-indigo-500/30 rounded-2xl space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="font-bold text-indigo-300 text-base">গ্রুপ ১৮ (নিষ্ক্রিয় গ্যাস)</h3>
            <span class="text-[11px] font-mono text-slate-500">He, Ne, Ar, Kr, Xe, Rn</span>
          </div>
          <p class="text-slate-300 italic font-serif text-sm">
            "হিলিয়াম নিয়ন আর ক্রিপ্টন জেনন রেডন"
          </p>
          <div class="text-[11px] text-slate-400 pt-1 border-t border-slate-800 font-mono">
            He (হিলিয়াম), Ne (নিয়ন), Ar (আর), Kr (ক্রিপ্টন), Xe (জেনন), Rn (রেডন)
          </div>
        </div>

        <div class="p-5 bg-slate-950/70 border border-cyan-500/30 rounded-2xl space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="font-bold text-cyan-300 text-base">পর্যায় ২ ও ৩ (১-২০ মৌল)</h3>
            <span class="text-[11px] font-mono text-slate-500">Li থেকে Ne এবং Na থেকে Ar</span>
          </div>
          <p class="text-slate-300 italic font-serif text-sm">
            পর্যায় ২: "লি বে ব ক না ও ফ নি"<br/>
            পর্যায় ৩: "না মগ আল সি ফ স কল আর"
          </p>
          <div class="text-[11px] text-slate-400 pt-1 border-t border-slate-800 font-mono">
            বোর্ড পরীক্ষায় বহুনির্বাচনি ও সৃজনশীল দ্রুত সমাধানের জন্য সর্বাধিক কার্যকরী।
          </div>
        </div>
      </div>
    </section>

    <!-- Section 2: Latin Names & Variable Valency Table -->
    <section class="bg-slate-900/80 border border-slate-800 rounded-3xl p-6 sm:p-9 space-y-6 shadow-xl">
      <div class="border-b border-slate-800 pb-4">
        <span class="text-amber-400 font-mono text-xs uppercase tracking-wider block font-semibold">পরীক্ষার কমন প্রশ্ন</span>
        <h2 class="text-2xl sm:text-3xl font-black text-white flex items-center gap-2.5 mt-1">
          <span class="w-3 h-3 rounded-full bg-amber-400"></span>
          মৌলসমূহের ল্যাটিন নাম ও পরিবর্তনশীল যোজ্যতা চার্ট
        </h2>
        <p class="text-sm text-slate-400 mt-2">
