---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import AdSlot from '../../../../components/ads/AdSlot.astro';
import { Latex } from '../../../../components/math/Latex';
import { CURRICULUM_DATA, type CurriculumSubject } from '../../../../data/curriculum';
import { getLocalizedPath } from '../../../../i18n/utils';

export function getStaticPaths() {
  return CURRICULUM_DATA.map((subject) => ({
    params: { level: subject.level, subject: subject.id },
    props: { subject },
  }));
}

interface Props {
  subject: CurriculumSubject;
}

const { subject } = Astro.props;

const toolMeta: Record<string, { nameBn: string; nameEn: string; icon: string }> = {
  'physics': { nameBn: 'পদার্থবিজ্ঞান ক্যালকুলেটর', nameEn: 'Physics Solver', icon: '⚡' },
  'chemistry': { nameBn: 'রসায়ন ক্যালকুলেটর', nameEn: 'Chemistry Solver', icon: '⚗️' },
  'biology': { nameBn: 'জীববিজ্ঞান ক্যালকুলেটর', nameEn: 'Biology Calculator', icon: '🧬' },
  'general-math': { nameBn: 'এসএসসি সাধারণ গণিত সমাধানকারী', nameEn: 'SSC General Math Solver', icon: '➕' },
  'higher-math': { nameBn: 'উচ্চতর গণিত সমাধানকারী', nameEn: 'Higher Math Solver', icon: '📐' },
  'molar-mass': { nameBn: 'মোলার ভর বিশ্লেষক', nameEn: 'Molar Mass Deconstructor', icon: '⚖️' },
  'redox-balancer': { nameBn: 'আয়ন-ইলেকট্রন সমতা ইঞ্জিন', nameEn: 'Redox Balancing Engine', icon: '⚡' },
  'significant-figures': { nameBn: 'তাৎপর্যপূর্ণ অঙ্ক নির্ণায়ক', nameEn: 'Significant Figures Engine', icon: '📏' },
  'projectile-motion': { nameBn: 'প্রাস ও গতিবিদ্যা সিমুলেটর', nameEn: 'Projectile Motion Solver', icon: '🎯' },
  'quadratic-solver': { nameBn: 'দ্বিঘাত সমীকরণ সমাধানকারী', nameEn: 'Quadratic Equation Solver', icon: '📐' },
  'vector-calculator': { nameBn: 'ভেক্টর ৩ডি গুণন ও কোণ ক্যালকুলেটর', nameEn: '3D Vector Calculator', icon: '↗️' },
  'gas-law-calculator': { nameBn: 'আদর্শ গ্যাস সূত্র ও গতিবিদ্যা ক্যালকুলেটর', nameEn: 'Ideal Gas Law Solver', icon: '💨' },
  'solution-dilution': { nameBn: 'দ্রবণ লঘুকরণ ও ঘনমাত্রা ক্যালকুলেটর', nameEn: 'Solution Dilution & Molarity', icon: '🧪' },
  'html-runner': { nameBn: 'এইচটিএমএল এডিটর ও লাইভ রানার', nameEn: 'HTML5 Live Runner', icon: '🌐' },
  'circuit-simulator': { nameBn: 'ডিজিটাল লজিক সার্কিট সিমুলেটর', nameEn: 'Digital Logic Circuit Simulator', icon: '🔌' },
  'c-runner': { nameBn: 'সি প্রোগ্রামিং কোড ও মেমরি ট্রেসার', nameEn: 'C Code Runner & Memory Tracer', icon: '💻' },
  'database-simulator': { nameBn: 'রিলেশনাল ডাটাবেজ ও এসকিউএল সিমুলেটর', nameEn: 'Relational Database & SQL Simulator', icon: '🗄️' },
};

const levelLabel = subject.level === 'hsc' ? 'Higher Secondary (Classes 11–12)' : 'Secondary (Classes 9–10)';
const canonicalUrl = `https://biggan.me/en/curriculum/${subject.level}/${subject.id}/`;
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://biggan.me/en/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Curriculum',
      item: 'https://biggan.me/en/curriculum/',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: subject.nameEn,
      item: canonicalUrl,
    },
  ],
};

const courseSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: `${subject.nameEn} (${levelLabel})`,
  description: `Comprehensive NCTB syllabus roadmap for ${levelLabel} ${subject.nameEn}. Creative Question (CQ) & MCQ mark distribution, core KaTeX formulas, and live interactive simulators.`,
  provider: {
    '@type': 'EducationalOrganization',
    name: 'Biggan.me',
    url: 'https://biggan.me',
  },
  inLanguage: 'en-US',
};
---

<BaseLayout
  title={`${subject.nameEn} (${levelLabel}) — Syllabus & Topic Guide | Biggan.me`}
  description={`Comprehensive NCTB syllabus roadmap for ${levelLabel} ${subject.nameEn}. Creative Question (CQ) & MCQ mark distribution, core KaTeX formulas, and live interactive simulators.`}
  lang="en"
  jsonLd={[breadcrumbSchema, courseSchema]}
>
  <div class="space-y-10">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs font-mono text-slate-400">
      <a href={getLocalizedPath('/', 'en')} class="hover:text-white transition">Home</a>
      <span>/</span>
      <a href={getLocalizedPath('/curriculum', 'en')} class="hover:text-white transition">Curriculum</a>
      <span>/</span>
      <span class="text-cyan-400 font-semibold">{subject.nameEn}</span>
    </nav>

    <!-- Subject Hero Header -->
    <div class="bg-gradient-to-br from-slate-900 via-slate-900 to-slate-950 border border-slate-800 rounded-3xl p-6 sm:p-10 shadow-2xl space-y-6">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-4">
          <span class="text-4xl sm:text-5xl p-3 sm:p-4 rounded-2xl bg-slate-950 border border-slate-800 shadow-inner">
            {subject.icon}
          </span>
          <div>
            <div class="flex items-center gap-2">
              <span class="text-xs font-mono px-3 py-0.5 rounded-full bg-cyan-950 text-cyan-300 border border-cyan-800">
                {levelLabel}
              </span>
              <span class="text-xs font-mono px-2.5 py-0.5 rounded-full bg-slate-800 text-slate-300 border border-slate-700">
                Subject Code: {subject.code}
              </span>
            </div>
            <h1 class="text-2xl sm:text-4xl font-black text-white mt-1">
              {subject.nameEn}
            </h1>
            <p class="text-xs sm:text-sm text-slate-400 font-mono">
              {subject.nameBn}
            </p>
          </div>
        </div>
      </div>

      <p class="text-sm sm:text-base text-slate-300 leading-relaxed max-w-4xl">
        {subject.descriptionEn}
      </p>

      <!-- Quick Metrics Ribbon -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2">
        <div class="bg-slate-950/70 border border-slate-800/80 rounded-xl p-3 text-center">
          <span class="text-[11px] font-mono text-slate-400 block uppercase">Curriculum Chapters</span>
          <span class="text-lg sm:text-xl font-bold text-white mt-0.5 block">{subject.chapters.length} Chapters</span>
        </div>
        <div class="bg-slate-950/70 border border-slate-800/80 rounded-xl p-3 text-center">
          <span class="text-[11px] font-mono text-slate-400 block uppercase">Board Assessment</span>
          <span class="text-lg sm:text-xl font-bold text-cyan-400 mt-0.5 block">100 Marks</span>
        </div>
        <div class="bg-slate-950/70 border border-slate-800/80 rounded-xl p-3 text-center">
          <span class="text-[11px] font-mono text-slate-400 block uppercase">Creative Questions (CQ)</span>
          <span class="text-lg sm:text-xl font-bold text-emerald-400 mt-0.5 block">50 / 70 Marks</span>
        </div>
        <div class="bg-slate-950/70 border border-slate-800/80 rounded-xl p-3 text-center">
          <span class="text-[11px] font-mono text-slate-400 block uppercase">Curriculum Board</span>
          <span class="text-lg sm:text-xl font-bold text-amber-400 mt-0.5 block">NCTB Bangladesh</span>
        </div>
      </div>
    </div>

    <!-- Ad placeholder -->
    <AdSlot slotType="banner" slotId="curriculum-subject-top" />

    <!-- Chapter Roadmap -->
    <div class="space-y-6">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <h2 class="text-xl sm:text-2xl font-bold text-white flex items-center gap-2">
          <span>📚</span> Chapter Breakdown & Syllabus Scope
        </h2>
        <span class="text-xs font-mono text-slate-400">
          Total {subject.chapters.length} Chapters
        </span>
      </div>

      <div class="space-y-6">
        {subject.chapters.map((chapter) => (
          <div class="bg-slate-900 border border-slate-800 hover:border-slate-700 rounded-2xl p-6 sm:p-8 space-y-5 transition-all">
            {/* Chapter Header */}
            <div class="flex flex-wrap items-start justify-between gap-3 border-b border-slate-800/80 pb-4">
              <div class="space-y-1">
                <div class="flex items-center gap-2">
                  <span class="text-xs font-mono font-bold text-cyan-400 bg-cyan-950/80 px-2.5 py-0.5 rounded-md border border-cyan-800">
                    Chapter {chapter.chapterNumber}
                  </span>
                  {chapter.paper && (
                    <span class="text-xs font-mono text-slate-400 bg-slate-950 px-2 py-0.5 rounded-md border border-slate-800">
                      {chapter.paper === 1 ? 'Paper 1' : 'Paper 2'}
                    </span>
                  )}
                </div>
                <h3 class="text-xl sm:text-2xl font-bold text-white pt-1">
                  {chapter.titleEn}
                </h3>
                <p class="text-xs text-slate-400 font-mono">
                  {chapter.titleBn}
                </p>
              </div>

              {/* Marks Weightage Badge */}
              <div class="flex flex-col items-end gap-1 font-mono text-xs">
                <span class="px-3 py-1 rounded-lg bg-emerald-950/50 text-emerald-400 border border-emerald-800/50">
                  CQ: {chapter.marksWeightage.cq}
                </span>
                <span class="px-3 py-1 rounded-lg bg-sky-950/50 text-sky-400 border border-sky-800/50">
                  MCQ: {chapter.marksWeightage.mcq}
                </span>
              </div>
            </div>

            <!-- Summary & Scope -->
            <p class="text-sm text-slate-300 leading-relaxed">
              {chapter.summaryEn}
            </p>

            <!-- Key Topics -->
            {chapter.keyTopics.length > 0 && (
              <div class="space-y-2">
                <span class="text-xs font-mono text-slate-400 uppercase tracking-wider block">
                  Key Topics & Concepts:
                </span>
                <div class="flex flex-wrap gap-2">
                  {chapter.keyTopics.map((topic) => (
                    <span class="text-xs bg-slate-950 text-slate-300 border border-slate-800 px-3 py-1 rounded-lg">
                      • {topic}
                    </span>
                  ))}
                </div>
              </div>
            )}

            <!-- Core Formulas (if any) -->
            {chapter.coreFormulas && chapter.coreFormulas.length > 0 && (
              <div class="space-y-3 pt-2">
                <span class="text-xs font-mono text-cyan-400 uppercase tracking-wider block">
                  Governing Formulas & Equations (KaTeX):
                </span>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                  {chapter.coreFormulas.map((formula) => (
                    <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2">
                      <div class="flex justify-between items-center text-xs font-medium text-slate-300">
                        <span>{formula.nameEn}</span>
                        <span class="text-slate-400 font-mono text-[11px]">{formula.nameBn}</span>
                      </div>
                      <div class="overflow-x-auto py-1 text-center font-mono text-sm text-cyan-300">
                        <Latex formula={formula.latex} displayMode client:visible />
                      </div>
                      {formula.notesEn && (
                        <p class="text-[11px] text-slate-400 border-t border-slate-900 pt-1.5 leading-snug">
                          {formula.notesEn}
                        </p>
                      )}
                    </div>
                  ))}
                </div>
              </div>
            )}

            <!-- Linked Interactive Simulator / Calculator -->
            {chapter.linkedToolIds && chapter.linkedToolIds.length > 0 && (
              <div class="bg-gradient-to-r from-cyan-950/40 via-slate-950 to-slate-950 p-4 rounded-xl border border-cyan-500/30 flex flex-wrap items-center justify-between gap-4 mt-4">
                <div class="space-y-1">
                  <span class="text-[11px] font-mono uppercase text-cyan-400 font-semibold block">
                    Interactive Lab Simulator
                  </span>
                  <div class="flex items-center gap-2">
                    {chapter.linkedToolIds.map((toolId) => {
                      const meta = toolMeta[toolId];
                      return (
                        <span class="text-sm font-bold text-white flex items-center gap-1.5">
                          <span>{meta ? meta.icon : '⚙️'}</span>
                          <span>{meta ? meta.nameEn : toolId}</span>
                        </span>
                      );
                    })}
                  </div>
                </div>

                <div class="flex gap-2">
                  {chapter.linkedToolIds.map((toolId) => (
                    <a
                      href={getLocalizedPath(`/tools/${toolId}`, 'en')}
                      class="inline-flex items-center gap-1.5 py-2 px-4 rounded-lg bg-cyan-500 hover:bg-cyan-400 text-slate-950 text-xs font-bold transition shadow-lg shadow-cyan-950/50"
                    >
                      Launch Simulator →
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>

    <!-- Board Exam Prep Strategy Section -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8 space-y-4">
      <h3 class="text-lg font-bold text-white flex items-center gap-2">
        <span>💡</span> {subject.nameEn} Examination Mastery Strategy
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs text-slate-300 leading-relaxed">
        <div class="p-4 bg-slate-950 rounded-xl border border-slate-800/80 space-y-2">
          <span class="text-cyan-400 font-bold block text-sm">Creative Questions (CQ) Protocol:</span>
          <p>• Always state given parameters and target variables clearly at the top of numerical solutions.</p>
          <p>• Display base governing equations before substituting numbers, and maintain explicit unit tracking.</p>
          <p>• Box the final answer with its correct SI unit and appropriate significant figures.</p>
        </div>
        <div class="p-4 bg-slate-950 rounded-xl border border-slate-800/80 space-y-2">
          <span class="text-emerald-400 font-bold block text-sm">MCQ & Hardware Optimization:</span>
          <p>• Master Casio fx-991 series shortcut modes (EQN, VECT, BASE-N) for instant verification in timed exams.</p>
          <p>• Memorize fundamental physical constants and dimensional unit conversions.</p>
          <p>• Use our Biggan.me interactive simulators to explore edge cases and visualize abstract phenomena.</p>
        </div>
      </div>
    </div>

    <!-- Bottom Ad -->
    <AdSlot slotType="banner" slotId="curriculum-subject-bottom" />
  </div>
</BaseLayout>
