---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocalizedPath } from '../../i18n/utils';

const siteUrl = 'https://biggan.me';
const canonicalUrl = `${siteUrl}/en/contact`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${siteUrl}/en`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Contact Us',
      item: canonicalUrl,
    },
  ],
};

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact & Academic Support — Biggan.me',
  description: 'Connect with the Biggan.me academic and engineering teams for curriculum inquiries, bug reports, teacher collaborations, and platform feedback.',
  url: canonicalUrl,
  mainEntity: {
    '@type': 'EducationalOrganization',
    name: 'Biggan.me',
    url: siteUrl,
    email: 'support@biggan.me',
    sameAs: ['https://github.com/ShadhinAfridi/biggan'],
  },
};
---

<BaseLayout
  title="Contact & Academic Support — Biggan.me"
  description="Connect with the Biggan.me academic and engineering teams for curriculum inquiries, bug reports, teacher collaborations, and platform feedback."
  lang="en"
  jsonLd={[breadcrumbSchema, contactSchema]}
>
  <div class="max-w-4xl mx-auto space-y-10">
    <!-- Breadcrumbs -->
    <nav aria-label="Breadcrumb">
      <ol class="flex items-center gap-2 text-xs font-mono text-slate-400">
        <li>
          <a href={getLocalizedPath('/', 'en')} class="hover:text-cyan-400 transition">Home</a>
        </li>
        <li>/</li>
        <li class="text-cyan-400 font-semibold">Contact</li>
      </ol>
    </nav>

    <!-- Header Section -->
    <div class="space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 text-xs font-mono font-semibold">
        <span>📬</span>
        <span>Support & Collaboration</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
        We Are Here to Help & Listen
      </h1>
      <p class="text-sm sm:text-base text-slate-300 max-w-2xl leading-relaxed">
        Whether you spot a mathematical typographical oversight, wish to recommend a new STEM simulator, or seek institutional partnership, our team welcomes your input.
      </p>
    </div>

    <!-- Contact Channels Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800 space-y-3 shadow-lg">
        <div class="w-10 h-10 rounded-xl bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 flex items-center justify-center text-xl">
          ✉️
        </div>
        <h2 class="text-base font-bold text-white">General Inquiries</h2>
        <p class="text-xs text-slate-400 leading-relaxed">
          Questions regarding formulas, syllabus coverage, or usage permissions.
        </p>
        <a href="mailto:support@biggan.me" class="inline-block text-xs font-mono text-cyan-400 font-semibold hover:underline">
          support@biggan.me
        </a>
      </div>

      <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800 space-y-3 shadow-lg">
        <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-400 flex items-center justify-center text-xl">
          🔍
        </div>
        <h2 class="text-base font-bold text-white">Corrections & Errata</h2>
        <p class="text-xs text-slate-400 leading-relaxed">
          Direct channel for educators and students reporting calculation errata.
        </p>
        <a href="mailto:editorial@biggan.me" class="inline-block text-xs font-mono text-amber-400 font-semibold hover:underline">
          editorial@biggan.me
        </a>
      </div>

      <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800 space-y-3 shadow-lg">
        <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center text-xl">
          💻
        </div>
        <h2 class="text-base font-bold text-white">Developer Community</h2>
        <p class="text-xs text-slate-400 leading-relaxed">
          Contribute code, propose features, or track open development issues.
        </p>
        <a href="https://github.com/ShadhinAfridi/biggan" target="_blank" rel="noopener noreferrer" class="inline-block text-xs font-mono text-emerald-400 font-semibold hover:underline">
          GitHub Repository →
        </a>
      </div>
    </div>

    <!-- Feedback & Message Form -->
    <div class="p-6 sm:p-8 rounded-3xl bg-slate-900/80 border border-slate-800 shadow-xl space-y-6">
      <div class="border-b border-slate-800 pb-4">
        <h2 class="text-lg sm:text-xl font-bold text-white flex items-center gap-2">
          <span>📝</span>
          <span>Send a Direct Message</span>
        </h2>
        <p class="text-xs text-slate-400 mt-1">
          Your feedback routes directly to our editorial and engineering team.
        </p>
      </div>

      <form class="space-y-4" onsubmit="event.preventDefault(); alert('Thank you! Your message has been received. Our team will get back to you promptly.'); this.reset();">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label for="contact-name" class="block text-xs font-semibold text-slate-300">
              Your Name <span class="text-rose-400">*</span>
            </label>
            <input
              type="text"
              id="contact-name"
              required
              placeholder="e.g. John Doe"
              class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-slate-100 text-xs focus:outline-none focus:border-cyan-400 transition"
            />
          </div>
          <div class="space-y-1.5">
            <label for="contact-email" class="block text-xs font-semibold text-slate-300">
              Email Address <span class="text-rose-400">*</span>
            </label>
            <input
              type="email"
              id="contact-email"
              required
              placeholder="e.g. student@school.edu"
              class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-slate-100 text-xs focus:outline-none focus:border-cyan-400 transition"
            />
          </div>
        </div>

        <div class="space-y-1.5">
          <label for="contact-subject" class="block text-xs font-semibold text-slate-300">
            Subject Category <span class="text-rose-400">*</span>
          </label>
          <select
            id="contact-subject"
            class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-slate-300 text-xs focus:outline-none focus:border-cyan-400 transition"
          >
            <option value="math-error">Mathematical Discrepancy or Typo</option>
            <option value="feature-request">Propose a New Tool or Simulator</option>
            <option value="academic-partnership">Educator or School Partnership</option>
            <option value="general">General Academic Question</option>
          </select>
        </div>

        <div class="space-y-1.5">
          <label for="contact-message" class="block text-xs font-semibold text-slate-300">
            Message <span class="text-rose-400">*</span>
          </label>
          <textarea
            id="contact-message"
            rows="4"
            required
            placeholder="Please detail your observation, referencing the tool name or equation..."
            class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-slate-100 text-xs focus:outline-none focus:border-cyan-400 transition"
          ></textarea>
        </div>

        <button
          type="submit"
          class="px-6 py-2.5 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold text-xs transition shadow-lg shadow-cyan-950/50"
        >
          Dispatch Message →
        </button>
      </form>
    </div>

    <!-- Trust & Verification Footer -->
    <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs text-slate-400">
      <div>
        <span class="font-semibold text-slate-200 block">Editorial Turnaround Commitment</span>
        <span>All reported mathematical errata are verified and updated within 24 to 48 hours.</span>
      </div>
      <div class="flex items-center gap-3 font-mono text-cyan-400 shrink-0">
        <a href={getLocalizedPath('/editorial', 'en')} class="hover:underline">Editorial Guidelines →</a>
        <a href={getLocalizedPath('/methodology', 'en')} class="hover:underline">Verification Methodology →</a>
      </div>
    </div>
  </div>
</BaseLayout>
