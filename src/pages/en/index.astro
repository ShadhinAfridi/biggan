---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/ads/AdSlot.astro';
import { getLocalizedPath } from '../../i18n/utils';
import { QuickSolverPreview } from '../../components/home/QuickSolverPreview';

const sscSubjects = [
  {
    id: 'physics',
    name: 'Physics',
    chapters: '13 Chapters',
    topics: 'Kinematics, Dynamics (F=ma), Work-Energy-Power, Pressure, Waves, Optics, Current Electricity',
    link: getLocalizedPath('/tools/physics', 'en'),
    icon: '⚡',
  },
  {
    id: 'higher-math',
    name: 'Higher Mathematics',
    chapters: '14 Chapters',
    topics: 'Apollonius Theorem, Quadratic Equations, Infinite Series, Binomial Theorem, Coordinate Geometry',
    link: getLocalizedPath('/tools/higher-math', 'en'),
    icon: '📐',
  },
  {
    id: 'chemistry',
    name: 'Chemistry',
    chapters: '12 Chapters',
    topics: 'Mole Concept, Molarity (S=1000w/MV), Graham Diffusion, Bohr Model, Enthalpy (ΔH), pH',
    link: getLocalizedPath('/tools/chemistry', 'en'),
    icon: '⚗️',
  },
  {
    id: 'general-math',
    name: 'General Math & Statistics',
    chapters: 'Board Special',
    topics: 'Grouped Frequency Tables, Step-Deviation Mean, Median, Mode, Trig Heights & Distances',
    link: getLocalizedPath('/tools/general-math', 'en'),
    icon: '➕',
  },
  {
    id: 'biology',
    name: 'Biology',
    chapters: '14 Chapters',
    topics: 'BMI, Harris-Benedict BMR, Net 38 ATP Yield in Respiration, 2×2 Punnett Square',
    link: getLocalizedPath('/tools/biology', 'en'),
    icon: '🧬',
  },
];

const hscTools = [
  {
    name: 'Logic Gate Circuit Simulator',
    desc: 'Live truth tables and output state evaluation for AND, OR, NOT, NAND, NOR, XOR gates',
    link: getLocalizedPath('/tools/circuit-simulator', 'en'),
    icon: '🔌',
  },
  {
    name: 'C Programming Memory Tracer',
    desc: 'Step-through execution of loops and conditions with live RAM variable stack table',
    link: getLocalizedPath('/tools/c-runner', 'en'),
    icon: '💻',
  },
  {
    name: 'HTML5 Runner & Live Preview',
    desc: 'In-browser sandbox for practicing NCTB HSC Chapter 4 web design tags and tables',
    link: getLocalizedPath('/tools/html-runner', 'en'),
    icon: '🌐',
  },
  {
    name: 'SQL Database Simulator',
    desc: 'Interactive table queries with SELECT, WHERE, and JOIN clauses directly in browser',
    link: getLocalizedPath('/tools/database-simulator', 'en'),
    icon: '🗄️',
  },
];
---

<BaseLayout
  title="Biggan.me — Step-by-Step STEM Solvers & Scientific Calculators"
  description="Step-by-step problem solvers for Secondary & Higher Secondary Science and Math with algebraic derivations, dimensional units, and Casio fx-991 hardware keystroke steps."
  lang="en"
>
  <div class="space-y-16">
    <!-- Asymmetric Product-First Hero Section -->
    <section class="pt-4 sm:pt-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
        <!-- Left Column: Grounded Editorial Value & Fast Jumps -->
        <div class="lg:col-span-7 space-y-5 text-left">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-900 border border-slate-800 text-slate-300 text-xs font-mono">
            <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
            Secondary & Higher Secondary Curriculum Solvers
          </div>

          <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight">
            Step-by-Step Science & <br class="hidden sm:inline" />
            Math Problem Solvers
          </h1>

          <p class="text-base text-slate-300 leading-relaxed max-w-xl">
            Solve quantitative textbook problems across Physics, Chemistry, Mathematics, Biology, and ICT with full algebraic derivations, SI units, and physical Casio fx-991 keystroke steps.
          </p>

          <!-- Quick Subject Filter Pills -->
          <div class="space-y-2 pt-1">
            <span class="text-[11px] font-mono text-slate-400 uppercase tracking-wider block">
              Jump to Subject:
            </span>
            <div class="flex flex-wrap gap-2">
              <a href={getLocalizedPath('/tools/physics', 'en')} class="px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 text-xs font-medium text-slate-200 border border-slate-800 hover:border-slate-700 transition flex items-center gap-1.5">
                <span>⚡</span> Physics
              </a>
              <a href={getLocalizedPath('/tools/chemistry', 'en')} class="px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 text-xs font-medium text-slate-200 border border-slate-800 hover:border-slate-700 transition flex items-center gap-1.5">
                <span>⚗️</span> Chemistry
              </a>
              <a href={getLocalizedPath('/tools/higher-math', 'en')} class="px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 text-xs font-medium text-slate-200 border border-slate-800 hover:border-slate-700 transition flex items-center gap-1.5">
                <span>📐</span> Higher Math
              </a>
              <a href={getLocalizedPath('/tools/general-math', 'en')} class="px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 text-xs font-medium text-slate-200 border border-slate-800 hover:border-slate-700 transition flex items-center gap-1.5">
                <span>➕</span> General Math
              </a>
              <a href={getLocalizedPath('/tools/biology', 'en')} class="px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 text-xs font-medium text-slate-200 border border-slate-800 hover:border-slate-700 transition flex items-center gap-1.5">
                <span>🧬</span> Biology
              </a>
              <a href={getLocalizedPath('/tools/c-runner', 'en')} class="px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 text-xs font-medium text-slate-200 border border-slate-800 hover:border-slate-700 transition flex items-center gap-1.5">
                <span>💻</span> ICT Lab
              </a>
            </div>
          </div>

          <!-- Secondary Links -->
          <div class="flex flex-wrap items-center gap-3 pt-2">
            <a
              href={getLocalizedPath('/tools', 'en')}
              class="px-5 py-2.5 rounded-xl bg-cyan-600 hover:bg-cyan-500 text-slate-950 font-bold text-xs transition"
            >
              Browse All 14 Solvers →
            </a>
            <a
              href={getLocalizedPath('/formulas', 'en')}
              class="px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-850 text-slate-300 border border-slate-800 text-xs font-medium transition"
            >
              Formula Reference Sheet
            </a>
          </div>
        </div>

        <!-- Right Column: Actual Live Working Product Demo Widget -->
        <div class="lg:col-span-5">
          <QuickSolverPreview client:load lang="en" />
        </div>
      </div>
    </section>

    <!-- Ad Placeholder -->
    <AdSlot slotType="banner" slotId="home-hero-bottom" />

    <!-- Section 1: SSC Class 9-10 Subject Directory -->
    <section class="space-y-6">
      <div class="border-b border-slate-800 pb-3 flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-white flex items-center gap-2">
            <span>📚</span> Secondary School Solvers (Class 9-10)
          </h2>
          <p class="text-xs text-slate-400 mt-0.5">
            Full curriculum solvers with formula derivations, bidirectional variables, and steps
          </p>
        </div>
        <span class="text-xs font-mono text-slate-500">5 Core Subjects</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {sscSubjects.map((sub) => (
          <a
            href={sub.link}
            class="p-5 rounded-2xl bg-slate-900/90 border border-slate-800 hover:border-slate-700 transition flex flex-col justify-between space-y-4 group"
          >
            <div class="space-y-2.5">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2.5">
                  <span class="text-2xl">{sub.icon}</span>
                  <h3 class="font-bold text-white text-base group-hover:text-cyan-400 transition">
                    {sub.name}
                  </h3>
                </div>
                <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-slate-950 text-slate-400 border border-slate-800">
                  {sub.chapters}
                </span>
              </div>

              <p class="text-xs text-slate-400 leading-relaxed">
                {sub.topics}
              </p>
            </div>

            <div class="pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs text-slate-400 group-hover:text-cyan-400 transition">
              <span>Open Solver</span>
              <span>→</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Section 2: HSC Class 11-12 ICT Simulators -->
    <section class="space-y-6">
      <div class="border-b border-slate-800 pb-3 flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-white flex items-center gap-2">
            <span>💻</span> Higher Secondary ICT Lab Simulators (Class 11-12)
          </h2>
          <p class="text-xs text-slate-400 mt-0.5">
            Logic circuit prototyping, C memory dry-runs, HTML sandbox, and SQL query simulators
          </p>
        </div>
        <span class="text-xs font-mono text-slate-500">4 Lab Simulators</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {hscTools.map((tool) => (
          <a
            href={tool.link}
            class="p-4 rounded-xl bg-slate-900/70 border border-slate-800 hover:border-slate-700 transition flex flex-col justify-between space-y-3 group"
          >
            <div class="space-y-2">
              <span class="text-2xl block">{tool.icon}</span>
              <h3 class="font-bold text-white text-sm group-hover:text-cyan-400 transition">
                {tool.name}
              </h3>
              <p class="text-xs text-slate-400 leading-relaxed">
                {tool.desc}
              </p>
            </div>
            <span class="text-xs text-cyan-400 font-medium pt-2">
              Launch Simulator →
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Section 3: Essential Study & Revision Hubs -->
    <section class="bg-slate-900/60 border border-slate-800 rounded-2xl p-6 sm:p-8 space-y-6">
      <div class="border-b border-slate-800 pb-3">
        <h2 class="text-lg sm:text-xl font-bold text-white">
          Curriculum Study & Reference Hubs
        </h2>
        <p class="text-xs text-slate-400 mt-0.5">
          Essential tools for revision and board exam preparation
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
        <a
          href={getLocalizedPath('/periodic-table', 'en')}
          class="p-4 rounded-xl bg-slate-950 border border-slate-800 hover:border-slate-700 transition space-y-2 block"
        >
          <div class="flex items-center gap-2">
            <span class="text-xl">🧪</span>
            <h3 class="font-bold text-white text-sm">118-Element Periodic Table</h3>
          </div>
          <p class="text-slate-400 leading-relaxed">
            IUPAC standard 18-column table with heatmaps, Latin origins, and Aufbau exception analysis.
          </p>
          <span class="text-cyan-400 font-medium inline-block pt-1">Explore Table →</span>
        </a>

        <a
          href={getLocalizedPath('/formulas', 'en')}
          class="p-4 rounded-xl bg-slate-950 border border-slate-800 hover:border-slate-700 transition space-y-2 block"
        >
          <div class="flex items-center gap-2">
            <span class="text-xl">📜</span>
            <h3 class="font-bold text-white text-sm">Formula Reference Sheet</h3>
          </div>
          <p class="text-slate-400 leading-relaxed">
            All core Physics, Chemistry, Math, and ICT formulas on a single searchable, print-optimized page.
          </p>
          <span class="text-cyan-400 font-medium inline-block pt-1">View Sheet →</span>
        </a>

        <a
          href={getLocalizedPath('/my-progress', 'en')}
          class="p-4 rounded-xl bg-slate-950 border border-slate-800 hover:border-slate-700 transition space-y-2 block"
        >
          <div class="flex items-center gap-2">
            <span class="text-xl">✅</span>
            <h3 class="font-bold text-white text-sm">Chapter Revision Tracker</h3>
          </div>
          <p class="text-slate-400 leading-relaxed">
            Keep track of revised chapters across your subjects directly in your browser without accounts.
          </p>
          <span class="text-cyan-400 font-medium inline-block pt-1">View Progress →</span>
        </a>
      </div>
    </section>

    <!-- Section 4: Authentic Curriculum Standards (Zero Fake Social Proof) -->
    <section class="border border-slate-800/80 rounded-2xl p-6 bg-slate-950 text-xs text-slate-400 space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-800 pb-3">
        <span class="font-bold text-slate-300 text-sm">
          Authoritative Syllabus Standards & Constants
        </span>
        <span class="font-mono text-[11px] text-slate-500">
          NCTB & Board Exam Conventions
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 font-mono">
        <div class="space-y-1">
          <span class="text-slate-500 block text-[10px]">Standard Gravity:</span>
          <span class="text-slate-200 font-semibold">g = 9.8 m/s²</span>
        </div>
        <div class="space-y-1">
          <span class="text-slate-500 block text-[10px]">Avogadro's Number:</span>
          <span class="text-slate-200 font-semibold">N_A = 6.023 × 10²³</span>
        </div>
        <div class="space-y-1">
          <span class="text-slate-500 block text-[10px]">Molar Gas Volume (STP):</span>
          <span class="text-slate-200 font-semibold">V_m = 22.4 L/mol</span>
        </div>
        <div class="space-y-1">
          <span class="text-slate-500 block text-[10px]">Water Density (4°C):</span>
          <span class="text-slate-200 font-semibold">ρ = 1000 kg/m³</span>
        </div>
      </div>

      <p class="text-slate-500 pt-1 border-t border-slate-900 text-[11px]">
        Note: Calculations execute entirely client-side in your browser. No personal data collection or account creation required.
      </p>
    </section>
  </div>
</BaseLayout>
