---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/ads/AdSlot.astro';
import { getLocalizedPath } from '../../i18n/utils';

const tools = [
  {
    id: 'molar-mass',
    name: 'Molar Mass & Composition',
    desc: 'Calculate molecular mass of hydrates, coordination complexes, and isotopic percent compositions.',
    icon: '⚗️',
    badge: 'Chemistry',
  },
  {
    id: 'redox-balancer',
    name: 'Ion-Electron Redox Balancer',
    desc: 'Balance oxidation-reduction reactions in acidic and basic media via step-by-step half-reactions.',
    icon: '⚡',
    badge: 'High School & College',
  },
  {
    id: 'significant-figures',
    name: 'Significant Figures Engine',
    desc: 'Determine significant digits, scientific notation conversions, and precision-tracked arithmetic.',
    icon: '📏',
    badge: 'Measurement & Lab',
  },
  {
    id: 'projectile-motion',
    name: 'Kinematic Projectile Solver',
    desc: 'Calculate maximum height, time of flight, range, and interactive 2D trajectory vector plots.',
    icon: '🎯',
    badge: 'Physics Mechanics',
  },
  {
    id: 'quadratic-solver',
    name: 'Procedural Quadratic Solver',
    desc: 'Real and complex roots, discriminant analysis, and completing-the-square derivations.',
    icon: '📐',
    badge: 'Algebra',
  },
];
---

<BaseLayout
  title="Biggan.me — Step-by-Step STEM Solvers & Scientific Calculators"
  description="Bilingual STEM platform featuring step-by-step LaTeX derivations, Casio fx-991 keystroke guides, and NCTB/NCERT curriculum alignment."
  lang="en"
>
  <div class="space-y-16">
    <!-- Hero Section -->
    <section class="text-center space-y-6 pt-6 sm:pt-12 max-w-4xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 text-xs font-mono">
        🚀 Bilingual STEM Educational Computational Platform
      </div>

      <h1 class="text-4xl sm:text-6xl font-black text-white tracking-tight leading-tight sm:leading-tight">
        Every STEM Problem Step <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-400 to-indigo-400">
          Transparent, Rigorous & Exam-Ready
        </span>
      </h1>

      <p class="text-base sm:text-lg text-slate-400 max-w-2xl mx-auto leading-relaxed">
        Full algebraic derivations rendered in KaTeX, dimensional unit validation, and physical Casio fx-991 hardware keystroke sequences for secondary and college scholars.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <a
          href={getLocalizedPath('/tools', 'en')}
          class="px-6 py-3 rounded-xl bg-cyan-600 hover:bg-cyan-500 active:bg-cyan-700 text-white font-bold text-sm transition shadow-lg shadow-cyan-900/30"
        >
          Explore All Calculators →
        </a>
        <a
          href={getLocalizedPath('/periodic-table', 'en')}
          class="px-6 py-3 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-700 font-semibold text-sm transition"
        >
          Periodic Table Explorer
        </a>
      </div>

      <!-- Curriculum Trust Badges -->
      <div class="pt-6 flex flex-wrap items-center justify-center gap-2 text-xs font-mono text-slate-400">
        <span class="px-2.5 py-1 rounded-md bg-slate-900 border border-slate-800">
          International & AP Curriculum
        </span>
        <span class="px-2.5 py-1 rounded-md bg-slate-900 border border-slate-800">
          CBSE & NCERT (India)
        </span>
        <span class="px-2.5 py-1 rounded-md bg-slate-900 border border-slate-800">
          NCTB (Bangladesh)
        </span>
      </div>
    </section>

    <!-- Ad Placeholder -->
    <AdSlot slotType="banner" slotId="home-hero-bottom" />

    <!-- Flagship Calculators Grid -->
    <section class="space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 border-b border-slate-800 pb-4">
        <div>
          <h2 class="text-2xl font-bold text-white">Flagship Computational Solvers</h2>
          <p class="text-xs text-slate-400 mt-1">
            Standardized calculators embedded within comprehensive pedagogical guides
          </p>
        </div>
        <a href={getLocalizedPath('/tools', 'en')} class="text-xs font-semibold text-cyan-400 hover:underline">
          View All Tools ({tools.length}) →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {tools.map((tool) => (
          <a
            href={getLocalizedPath(`/tools/${tool.id}`, 'en')}
            class="group bg-slate-900 border border-slate-800 hover:border-cyan-500/50 rounded-2xl p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-cyan-950/30 flex flex-col justify-between"
          >
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-2xl p-2.5 rounded-xl bg-slate-950 border border-slate-800 group-hover:scale-110 transition">
                  {tool.icon}
                </span>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-cyan-950 text-cyan-300 border border-cyan-800">
                  {tool.badge}
                </span>
              </div>

              <h3 class="text-base font-bold text-white group-hover:text-cyan-400 transition">
                {tool.name}
              </h3>

              <p class="text-xs text-slate-400 leading-relaxed">
                {tool.desc}
              </p>
            </div>

            <div class="pt-4 mt-4 border-t border-slate-800/80 flex items-center justify-between text-xs text-cyan-400 font-medium">
              <span>Step-by-step solution</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Why Biggan.me Pillars -->
    <section class="bg-slate-900/60 border border-slate-800 rounded-3xl p-8 sm:p-12 space-y-8">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
          How Biggan.me Solves Core Student Frustrations
        </h2>
        <p class="text-xs sm:text-sm text-slate-400">
          Eliminating black-box calculations and bridging the divide to physical examination hardware
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-5 bg-slate-950/70 border border-slate-800 rounded-2xl space-y-3">
          <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center font-bold text-lg border border-amber-500/20">
            ⌨️
          </div>
          <h3 class="font-bold text-white text-base">Casio fx-991 Hardware Bridge</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Smartphones are prohibited in exam halls. Every calculator provides an exact keystroke guide for the Casio fx-991CW, fx-991EX, fx-991ES PLUS, and fx-100MS.
          </p>
        </div>

        <div class="p-5 bg-slate-950/70 border border-slate-800 rounded-2xl space-y-3">
          <div class="w-10 h-10 rounded-xl bg-cyan-500/10 text-cyan-400 flex items-center justify-center font-bold text-lg border border-cyan-500/20">
            📝
          </div>
          <h3 class="font-bold text-white text-base">Transparent Step-by-Step Proofs</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Every solution exposes the base governing equation, isolated target variable, intermediate value substitutions, and dimensional unit cancellations in KaTeX.
          </p>
        </div>

        <div class="p-5 bg-slate-950/70 border border-slate-800 rounded-2xl space-y-3">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center font-bold text-lg border border-emerald-500/20">
            ⚡
          </div>
          <h3 class="font-bold text-white text-base">Zero-JS HTML First Performance</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Built with Astro and isolated React islands. Sub-1.2s page loads even on metered 3G mobile connections with zero layout shifts.
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
