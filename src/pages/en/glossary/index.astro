---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AdSlot from '../../../components/ads/AdSlot.astro';
import { GLOSSARY_TERMS } from '../../../data/glossaryTerms';
import { GlossarySearch } from '../../../components/glossary/GlossarySearch';

const siteUrl = 'https://biggan.me';
const canonicalUrl = `${siteUrl}/en/glossary`;

// DefinedTermSet Schema for SEO
const definedTermSetSchema = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  '@id': canonicalUrl,
  name: 'Bilingual STEM Glossary & Formula Lexicon — Biggan.me',
  description: 'Authoritative bilingual scientific glossary featuring standard SI units, defining equations in KaTeX, dimensional analysis, and curriculum-aligned exam guides.',
  inLanguage: 'en',
  url: canonicalUrl,
  hasDefinedTerm: GLOSSARY_TERMS.map((term) => ({
    '@type': 'DefinedTerm',
    '@id': `${canonicalUrl}/${term.id}`,
    name: term.termEn,
    alternateName: [term.termBn, term.pronunciationBn],
    description: term.definitionEn,
    inDefinedTermSet: canonicalUrl,
    url: `${canonicalUrl}/${term.id}`,
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${siteUrl}/en`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'STEM Glossary',
      item: canonicalUrl,
    },
  ],
};

const jsonLd = [definedTermSetSchema, breadcrumbSchema];
---

<BaseLayout
  title="Bilingual STEM Glossary & Formula Lexicon — Biggan.me"
  description="Comprehensive bilingual scientific lexicon linking authoritative Bengali vocabulary with standardized English terminology, LaTeX equations, SI units, and dimensional analysis."
  lang="en"
  jsonLd={jsonLd}
>
  <div class="space-y-8">
    {/* Page Header */}
    <header class="space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 text-xs font-mono">
        Bilingual Scientific Lexicon
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
        STEM Concept & Formula Glossary
      </h1>
      <p class="text-base sm:text-lg text-slate-300 max-w-3xl leading-relaxed">
        Standardized symbols, defining mathematical equations, SI & CGS units, dimensional analysis, and board exam revision aids across Physics, Chemistry, Biology, Mathematics, and ICT.
      </p>

      {/* Quick Stats Bar */}
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2">
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-3 text-center">
          <span class="text-xs text-slate-400 block">Total Terms</span>
          <span class="text-xl font-black text-cyan-400 font-mono">{GLOSSARY_TERMS.length}+</span>
        </div>
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-3 text-center">
          <span class="text-xs text-slate-400 block">Disciplines</span>
          <span class="text-xl font-black text-emerald-400 font-mono">5 Subjects</span>
        </div>
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-3 text-center">
          <span class="text-xs text-slate-400 block">Math Display</span>
          <span class="text-xl font-black text-amber-400 font-mono">Pre-rendered KaTeX</span>
        </div>
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-3 text-center">
          <span class="text-xs text-slate-400 block">Interactive Solvers</span>
          <span class="text-xl font-black text-purple-400 font-mono">Cross-linked</span>
        </div>
      </div>
    </header>

    {/* Top Ad Slot */}
    <AdSlot slotType="banner" slotId="glossary-top" />

    {/* Interactive Search Island */}
    <GlossarySearch client:load terms={GLOSSARY_TERMS} lang="en" />

    {/* In-Content Ad */}
    <AdSlot slotType="in-content" slotId="glossary-mid" />

    {/* Educational Context & FAQ Guide for SEO */}
    <section class="bg-slate-900/60 border border-slate-800 rounded-2xl p-6 sm:p-8 space-y-6">
      <div class="border-b border-slate-800 pb-4">
        <h2 class="text-xl sm:text-2xl font-bold text-white">
          Scientific Conventions & Dimensional Standards
        </h2>
        <p class="text-sm text-slate-400 mt-1">
          Essential rules for writing units, dimensions, and symbols in secondary and higher secondary scientific examinations.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm text-slate-300">
        <div class="space-y-3 bg-slate-950/80 p-5 rounded-xl border border-slate-800/80">
          <h3 class="text-base font-bold text-cyan-300 flex items-center gap-2">
            <span>📏</span> SI Unit Notation Rules
          </h3>
          <p class="text-xs sm:text-sm leading-relaxed text-slate-400">
            Units named after scientists (e.g., newton, joule, watt) are written in lowercase when spelled out, but their symbols are capitalized (N, J, W). Standard units not derived from proper names are written with lowercase symbols (e.g., m for meter, kg for kilogram, s for second). Never pluralize symbols with an "s" (write 50 kg, not 50 kgs).
          </p>
        </div>

        <div class="space-y-3 bg-slate-950/80 p-5 rounded-xl border border-slate-800/80">
          <h3 class="text-base font-bold text-emerald-300 flex items-center gap-2">
            <span>📐</span> Dimensional Homogeneity
          </h3>
          <p class="text-xs sm:text-sm leading-relaxed text-slate-400">
            The Principle of Homogeneity states that terms added or subtracted in any physical equation must share identical dimensions. Dimensional analysis is vital for verifying formula correctness and deriving relationships between physical quantities without empirical constants.
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
