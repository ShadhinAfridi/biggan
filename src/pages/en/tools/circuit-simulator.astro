---
import ToolLayout, { type SolvedExemplar, type ToolFaqItem } from '../../../layouts/ToolLayout.astro';
import { CircuitSimulator } from '../../../tools/ict/circuit-simulator/CircuitSimulator';

const exemplars: SolvedExemplar[] = [
  {
    level: 'Foundational Gate',
    levelBadge: 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20',
    problemText: 'Determine the output of a 2-input XOR gate when inputs are A = 1 and B = 1.',
    givenData: ['Inputs: A = 1, B = 1', 'Gate: XOR'],
    solutionSteps: [
      'Boolean definition: Y = A ⊕ B = A\'B + AB\'.',
      'Substitute values: (0 · 1) + (1 · 0) = 0 + 0 = 0.',
      'An XOR gate outputs 0 whenever both inputs are identical.',
    ],
    finalAnswer: 'Output Y = 0',
  },
  {
    level: 'Secondary Board Standard',
    levelBadge: 'bg-cyan-500/10 text-cyan-400 border border-cyan-500/20',
    problemText: 'Calculate the Sum and Carry generated by a Half Adder when adding two binary bits 1 and 1.',
    givenData: ['Operands: A = 1, B = 1'],
    solutionSteps: [
      'Binary arithmetic: 1 + 1 = 10 in base-2 (decimal 2).',
      'Sum bit: S = A ⊕ B = 1 ⊕ 1 = 0.',
      'Carry bit: C = A · B = 1 · 1 = 1.',
    ],
    finalAnswer: 'Sum (S) = 0, Carry (C) = 1 (Binary: 10₂)',
  },
  {
    level: 'Universal Gate Implementation',
    levelBadge: 'bg-purple-500/10 text-purple-400 border border-purple-500/20',
    problemText: 'Demonstrate how an OR gate can be constructed using only universal NAND gates.',
    givenData: ['Target gate: OR', 'Available: 2-input NAND gates'],
    solutionSteps: [
      'Apply De Morgan: A + B = ((A + B)\')\' = (A\' · B\')\'.',
      'Invert input A using NAND(A, A) to get A\'.',
      'Invert input B using NAND(B, B) to get B\'.',
      'Feed A\' and B\' into a third NAND to yield A + B.',
    ],
    finalAnswer: 'Exactly 3 NAND gates implement an OR function.',
  },
];

const faqs: ToolFaqItem[] = [
  {
    question: 'Why are NAND and NOR classified as universal gates?',
    answer: 'NAND and NOR gates are universal because any Boolean function and all basic gates (AND, OR, NOT) can be synthesized exclusively using networks of either NAND or NOR gates alone.',
  },
  {
    question: 'What differentiates a Half Adder from a Full Adder?',
    answer: 'A Half Adder adds two single bits producing Sum and Carry. A Full Adder adds three bits (including an incoming Carry-in from a previous stage). Two Half Adders and an OR gate form a Full Adder.',
  },
  {
    question: 'How can logic operations be executed on a physical Casio calculator?',
    answer: 'On Casio fx-991EX or fx-991CW, navigate to Base-N mode. Press OPTN or LOGIC to access bitwise AND, OR, XOR, and NOT operations directly on binary or hex numbers.',
  },
];
---

<ToolLayout
  title="Digital Logic Gate & Circuit Simulator — Biggan.me"
  metaDescription="Interactive digital logic circuit simulator covering basic gates (AND, OR, NOT), universal gates (NAND, NOR), Half/Full Adders, and real-time truth tables."
  toolName="Digital Logic Gate & Circuit Simulator"
  toolCategory="Information & Communication Technology (ICT)"
  curriculumTags={['NCTB HSC ICT Chapter 3', 'Digital Devices & Logic Gates', 'Combinational Circuits']}
  topicId="circuit-simulator"
  exemplars={exemplars}
  faqs={faqs}
>
  <div slot="calculator">
    <CircuitSimulator client:load lang="en" />
  </div>

  <div slot="derivation">
    <div class="space-y-4">
      <h3 class="text-base font-bold text-white">Boolean Algebra & Combinational Logic Principles</h3>
      <p>
        Modern central processing units execute billions of arithmetic operations per second by cascading combinational logic gates switching between 0V (logic 0) and +5V (logic 1).
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 font-mono text-xs text-slate-300">
        <div class="p-4 bg-slate-950 rounded-xl border border-slate-800 space-y-1">
          <span class="text-cyan-400 font-bold block">Half Adder Equations:</span>
          <p>Sum: S = A ⊕ B</p>
          <p>Carry: C = A · B</p>
        </div>
        <div class="p-4 bg-slate-950 rounded-xl border border-slate-800 space-y-1">
          <span class="text-cyan-400 font-bold block">Full Adder Equations:</span>
          <p>Sum: S = A ⊕ B ⊕ Cin</p>
          <p>Cout = (A · B) + (Cin · (A ⊕ B))</p>
        </div>
      </div>
    </div>
  </div>

  <div slot="applications">
    <p>
      From arithmetic logic units (ALUs) inside mobile chipsets to hardware encryption coprocessors and field-programmable gate arrays (FPGAs), these fundamental logic circuits are the bedrock of computing. Toggling switches in this live visualizer lets students ground abstract classroom truth tables in tangible circuit physics.
    </p>
  </div>
</ToolLayout>
