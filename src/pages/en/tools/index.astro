const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://biggan.me/en/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Tools Directory',
      item: 'https://biggan.me/en/tools/',
    },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Scientific Calculators & ICT Lab Simulators — Biggan.me',
  description: 'Free step-by-step STEM calculation utilities and zero-backend ICT simulators. Molar mass, logic circuits, C memory tracer, HTML runner, and SQL engine.',
  url: 'https://biggan.me/en/tools/',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: allTools.map((t, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: t.name,
      description: t.desc,
      url: `https://biggan.me/en/tools/${t.id}/`,
    })),
  },
};
---

<BaseLayout
  title="Scientific Calculators & ICT Lab Simulators — Biggan.me"
  description="Free step-by-step STEM calculation utilities and zero-backend ICT simulators. Molar mass, logic circuits, C memory tracer, HTML runner, and SQL engine."
  lang="en"
  jsonLd={[breadcrumbSchema, collectionSchema]}
>
  <div class="space-y-10">
    <!-- Header -->
    <div class="space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 text-xs font-mono">
        STEM & ICT Tools Directory
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
        Interactive Labs & Programmatic Calculators
      </h1>
      <p class="text-base text-slate-300 max-w-3xl leading-relaxed">
        Board exam verified derivations, dimensional unit analysis, physical Casio fx-991 hardware keystroke bridge, and zero-server client-side ICT lab simulators.
      </p>
    </div>

    <!-- Ad placeholder -->
    <AdSlot slotType="banner" slotId="tools-index-top" />

    <!-- Filter Bar & Live Search -->
    <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-4 sm:p-5 space-y-4 backdrop-blur-md shadow-xl">
      <!-- Search Input -->
      <div class="relative">
        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </span>
        <input
          type="text"
          id="tool-search"
          placeholder="Search tools or topics (e.g. projectile, mole, C loop, logic gate, series, pH)..."
          class="w-full pl-11 pr-4 py-3 bg-slate-950 border border-slate-700/80 rounded-xl text-white placeholder-slate-500 text-sm focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition"
        />
      </div>

      <!-- Filter Buttons -->
      <div class="flex flex-wrap items-center gap-2 pt-1" id="filter-tabs">
        <button
          type="button"
          data-filter="all"
          class="filter-btn active px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-cyan-500 text-slate-950 border border-cyan-400 transition cursor-pointer"
        >
          All Tools ({allTools.length})
        </button>
        <button
          type="button"
          data-filter="level-ssc"
          class="filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-slate-950 text-slate-300 hover:text-white border border-slate-800 hover:border-slate-700 transition cursor-pointer"
        >
          Secondary (SSC)
        </button>
        <button
          type="button"
          data-filter="level-hsc"
          class="filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-slate-950 text-slate-300 hover:text-white border border-slate-800 hover:border-slate-700 transition cursor-pointer"
        >
          Higher Sec (HSC)
        </button>
        <button
          type="button"
          data-filter="cat-physics"
          class="filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-slate-950 text-slate-300 hover:text-white border border-slate-800 hover:border-slate-700 transition cursor-pointer"
        >
          ⚡ Physics
        </button>
        <button
          type="button"
          data-filter="cat-chemistry"
          class="filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-slate-950 text-slate-300 hover:text-white border border-slate-800 hover:border-slate-700 transition cursor-pointer"
        >
          ⚗️ Chemistry
        </button>
        <button
          type="button"
          data-filter="cat-math"
          class="filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-slate-950 text-slate-300 hover:text-white border border-slate-800 hover:border-slate-700 transition cursor-pointer"
        >
          📐 Mathematics
        </button>
        <button
          type="button"
          data-filter="cat-biology"
          class="filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-slate-950 text-slate-300 hover:text-white border border-slate-800 hover:border-slate-700 transition cursor-pointer"
        >
          🧬 Biology
        </button>
        <button
          type="button"
          data-filter="cat-ict"
          class="filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-slate-950 text-slate-300 hover:text-white border border-slate-800 hover:border-slate-700 transition cursor-pointer"
        >
          💻 ICT Lab
        </button>
      </div>
    </div>

    <!-- Active Tool Count & Feedback -->
    <div class="flex items-center justify-between text-xs text-slate-400 px-1">
      <span id="active-count">Showing {allTools.length} computational solvers & simulators</span>
      <span class="font-mono text-cyan-400">100% Client-Side</span>
    </div>

    <!-- Tools Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="tools-container">
      {allTools.map((tool) => (
        <div
          class={`tool-card group rounded-2xl transition-all duration-300 flex flex-col justify-between ${
            tool.isFlagship
              ? 'bg-gradient-to-b from-slate-900 to-slate-950 border border-cyan-500/30 hover:border-cyan-400/70 p-6 hover:-translate-y-1 hover:shadow-xl hover:shadow-cyan-950/40 md:col-span-1 lg:col-span-1'
              : 'bg-slate-900/80 border border-slate-800 hover:border-slate-700 p-6 hover:-translate-y-1 hover:shadow-lg'
          }`}
          data-category={tool.categoryKey}
          data-level={tool.levelKey}
          data-name={tool.name.toLowerCase()}
          data-keywords={tool.keywords.toLowerCase()}
        >
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-2xl p-2.5 rounded-xl bg-slate-950 border border-slate-800 group-hover:scale-110 transition">
                {tool.icon}
              </span>
              <span class={`text-[10px] font-mono px-2.5 py-0.5 rounded-full border ${
                tool.isFlagship
                  ? 'bg-cyan-950/80 text-cyan-300 border-cyan-700/60 font-bold'
                  : 'bg-slate-950 text-slate-300 border-slate-800'
              }`}>
                {tool.badge}
              </span>
            </div>

            <h3 class="text-base sm:text-lg font-bold text-white group-hover:text-cyan-400 transition leading-snug">
              {tool.name}
            </h3>

            <p class="text-xs text-slate-400 leading-relaxed">
              {tool.desc}
            </p>
          </div>

          <div class="pt-4 mt-4 border-t border-slate-800/80 flex items-center justify-between text-xs">
            <span class="text-[11px] font-mono text-slate-400">{tool.curriculum}</span>
            <a
              href={getLocalizedPath(`/tools/${tool.id}`, 'en')}
              class="font-semibold text-cyan-400 hover:text-cyan-300 group-hover:translate-x-0.5 transition-all flex items-center gap-1"
            >
              <span>Launch</span>
              <span>→</span>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Empty State -->
    <div id="no-results" class="hidden text-center py-16 px-4 bg-slate-900/50 border border-slate-800 rounded-3xl space-y-4">
      <span class="text-4xl">🔍</span>
      <h3 class="text-lg font-bold text-white">No calculators or simulators found</h3>
      <p class="text-xs text-slate-400 max-w-md mx-auto">
        No tools matched your search criteria. Please check your spelling or reset active filters.
      </p>
      <button
        type="button"
        id="reset-search"
        class="px-4 py-2 rounded-xl bg-cyan-600 hover:bg-cyan-500 text-white font-semibold text-xs transition"
      >
        Reset Filters
      </button>
    </div>
  </div>
</BaseLayout>

<script>
  function setupToolsFilter() {
    const searchInput = document.getElementById('tool-search') as HTMLInputElement | null;
    const filterButtons = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.tool-card') as NodeListOf<HTMLElement>;
    const noResults = document.getElementById('no-results');
    const activeCount = document.getElementById('active-count');
    const resetBtn = document.getElementById('reset-search');

    let currentFilter = 'all';

    function applyFilter() {
      const query = (searchInput?.value || '').toLowerCase().trim();
      let visibleCount = 0;

      cards.forEach((card) => {
        const cat = card.getAttribute('data-category') || '';
        const level = card.getAttribute('data-level') || '';
        const name = card.getAttribute('data-name') || '';
        const keywords = card.getAttribute('data-keywords') || '';

        // Check filter match
        let matchesFilter = false;
        if (currentFilter === 'all') {
          matchesFilter = true;
        } else if (currentFilter === 'level-ssc') {
          matchesFilter = level === 'ssc' || level === 'all';
        } else if (currentFilter === 'level-hsc') {
          matchesFilter = level === 'hsc' || level === 'all';
        } else if (currentFilter.startsWith('cat-')) {
          const targetCat = currentFilter.replace('cat-', '');
          matchesFilter = cat === targetCat;
        }

        // Check search match
        const matchesSearch = !query || name.includes(query) || keywords.includes(query);

        if (matchesFilter && matchesSearch) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }

      if (activeCount) {
        activeCount.textContent = `Showing ${visibleCount} computational solvers & simulators`;
      }
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtons.forEach((b) => {
          b.classList.remove('bg-cyan-500', 'text-slate-950', 'border-cyan-400');
          b.classList.add('bg-slate-950', 'text-slate-300', 'border-slate-800');
        });

        btn.classList.remove('bg-slate-950', 'text-slate-300', 'border-slate-800');
        btn.classList.add('bg-cyan-500', 'text-slate-950', 'border-cyan-400');

        currentFilter = btn.getAttribute('data-filter') || 'all';
        applyFilter();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', applyFilter);
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        currentFilter = 'all';
        const firstBtn = filterButtons[0];
        if (firstBtn) (firstBtn as HTMLButtonElement).click();
      });
    }
  }

  setupToolsFilter();
  document.addEventListener('astro:after-swap', setupToolsFilter);
</script>
