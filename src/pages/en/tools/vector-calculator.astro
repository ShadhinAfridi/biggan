---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import { VectorCalculator } from '../../../tools/vector/VectorCalculator';
import Latex from '../../../components/math/Latex.astro';

const exemplars = [
  {
    level: 'Higher Secondary Physics (NCTB Class 11)',
    levelBadge: 'Sample 1 • Orthogonal Vector Condition',
    problemText: 'Given vectors A = 2i + 3j - k and B = 3i - 2j + m k, determine the value of m for which the vectors are perpendicular.',
    givenData: [
      'Vector A = 2î + 3ĵ - k̂',
      'Vector B = 3î - 2ĵ + m k̂',
      'Condition: A ⊥ B ⇒ A · B = 0',
    ],
    solutionSteps: [
      'Dot product formula: A · B = Ax·Bx + Ay·By + Az·Bz',
      'Substituting: (2)(3) + (3)(-2) + (-1)(m) = 0',
      '6 - 6 - m = 0',
      '-m = 0 ⇒ m = 0',
    ],
    finalAnswer: 'Required value of m = 0',
  },
  {
    level: 'Engineering Admission (BUET / JEE Main)',
    levelBadge: 'Sample 2 • Cross Product & Parallelogram Area',
    problemText: 'Find the area of the parallelogram formed by adjacent side vectors A = i + 2j + 3k and B = 3i - 2j + k.',
    givenData: [
      'Adjacent side A = î + 2ĵ + 3k̂',
      'Adjacent side B = 3î - 2ĵ + k̂',
    ],
    solutionSteps: [
      'Cross product A × B = |î  ĵ  k̂; 1  2  3; 3 -2  1|',
      '= î(2×1 - 3×(-2)) - ĵ(1×1 - 3×3) + k̂(1×(-2) - 2×3)',
      '= 8î + 8ĵ - 8k̂',
      'Magnitude |A × B| = √(8² + 8² + (-8)²) = √(64 + 64 + 64) = √192 = 8√3 ≈ 13.856',
    ],
    finalAnswer: 'Parallelogram area = 8√3 sq units (13.856 sq units)',
  },
  {
    level: 'HSC Board Examination',
    levelBadge: 'Sample 3 • Angle Between 3D Vectors',
    problemText: 'Determine the angle between vectors A = 2i + 2j - k and B = 6i - 3j + 2k.',
    givenData: [
      'A = 2î + 2ĵ - k̂',
      'B = 6î - 3ĵ + 2k̂',
    ],
    solutionSteps: [
      'Dot product A · B = (2)(6) + (2)(-3) + (-1)(2) = 12 - 6 - 2 = 4',
      '|A| = √(2² + 2² + (-1)²) = 3',
      '|B| = √(6² + (-3)² + 2²) = 7',
      'cos θ = (A · B) / (|A| |B|) = 4 / (3 × 7) = 4 / 21 ≈ 0.1905',
      'θ = cos⁻¹(0.1905) ≈ 78.96°',
    ],
    finalAnswer: 'Angle between vectors θ ≈ 78.96°',
  },
];

const faqs = [
  {
    question: 'When are two non-zero vectors orthogonal (perpendicular)?',
    answer: 'Two non-zero vectors A and B are orthogonal if and only if their scalar dot product equals zero: A · B = |A||B| cos(90°) = 0. In algebraic components: AxBx + AyBy + AzBz = 0.',
  },
  {
    question: 'What is the condition for two vectors to be parallel?',
    answer: 'Two vectors are parallel if their cross product equals the zero vector: A × B = 0, or if their corresponding Cartesian components are directly proportional: Ax/Bx = Ay/By = Az/Bz.',
  },
  {
    question: 'How is vector cross product used to find geometric areas?',
    answer: 'The magnitude of the cross product |A × B| equals the area of the parallelogram spanned by vectors A and B. The area of the triangle formed by these two vectors is ½ |A × B|.',
  },
];
---

<ToolLayout
  title="3D Vector Math & Geometry Calculator — Biggan.me"
  metaDescription="Online 2D and 3D vector calculator: dot product, cross product, angle between vectors, unit vectors, projection, and parallelogram area."
  toolName="3D Vector Math & Geometric Solver"
  toolCategory="Physics & Mathematics"
  curriculumTags={['NCTB Physics Paper 1 Chapter 2 (Vectors)', 'NCERT Class 11 Vectors', 'BUET & Engineering Admission']}
  topicId="vectors"
  exemplars={exemplars}
  faqs={faqs}
>
  <div slot="calculator">
    <VectorCalculator client:load lang="en" />
  </div>

  <div slot="theory" class="space-y-4">
    <h3 class="text-lg font-bold text-white flex items-center gap-2">
      <span>📐</span> Vector Mathematical Identities
    </h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
      <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2">
        <h4 class="font-semibold text-cyan-400">Scalar Dot Product:</h4>
        <p class="text-slate-300 text-xs">
          <Latex math="\vec{A} \cdot \vec{B} = |\vec{A}||\vec{B}|\cos\theta = A_x B_x + A_y B_y + A_z B_z" />
        </p>
        <p class="text-slate-400 text-xs">Orthogonality condition: <Latex math="\vec{A} \cdot \vec{B} = 0" /></p>
      </div>

      <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2">
        <h4 class="font-semibold text-purple-400">Vector Cross Product:</h4>
        <p class="text-slate-300 text-xs">
          <Latex math="\vec{A} \times \vec{B} = \begin{vmatrix} \hat{i} & \hat{j} & \hat{k} \\ A_x & A_y & A_z \\ B_x & B_y & B_z \end{vmatrix}" />
        </p>
        <p class="text-slate-400 text-xs">Parallel condition: <Latex math="\vec{A} \times \vec{B} = \vec{0}" /></p>
      </div>
    </div>
  </div>
</ToolLayout>
